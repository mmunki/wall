// ----------------------------------------------------------------------------
// countFlags: walk the flag table and return how many options are registered.
// The table is populated by initFlags() (plus any user config file), so this
// runs after initialization to print an accurate total in --help.
// ----------------------------------------------------------------------------
fn countFlags() int {
    var f: ptr = flags;
    var n: int = 0;
    while f != 0 { n = n + 1; f = (ptr)f[FL_NEXT]; }
    return n;
}

// Number of operators / expressions the language frontend understands. This is
// a constant that tracks the compiler grammar (arithmetic, shift, bitwise,
// relational, equality, logical, assignment, unary, postfix and ternary).
let N_EXPRESSIONS = 52;

fn printHelp() void {
    printf("WALL TOOLCHAIN\n");
    printf("options (%lld registered):\n", countFlags());
    printf("  --help -h                  print this help and exit\n");
    printf("  --version                  print version information and exit\n");
    printf("  run <file>                 compile and run\n");
    printf("  build                      build executable (default)\n");
    printf("  obj -c --emit-obj          compile to object(s) only\n");
    printf("  -S                         emit assembly only\n");
    printf("  -emit-llvm                 emit LLVM IR only\n");
    printf("  -o <file>                  write output to <file>\n");
    printf("  -target <triple>           cross-compile to <triple> (e.g. x86_64)\n");
    printf("  --print-targets            list supported codegen targets\n");
    printf("  -O0 -O1 -O2 -O3 -Os -Oz    optimization level (default -O2)\n");
    printf("  -g                         generate debug information\n");
    printf("  -shared -static            build shared library / static link\n");
    printf("  -fPIC -fpic                position-independent code\n");
    printf("  -pie -no-pie               control PIE generation\n");
    printf("  -nostdlib                  do not link crt/libc\n");
    printf("  -l<lib> -L<dir>            link library / add search path\n");
    printf("  -Wl,<flag>                 pass <flag> to the linker\n");
    printf("  -I<dir> -D<name>           include dir / preprocessor define\n");
    printf("  -pthread -fopenmp          enable threading / OpenMP\n");
    printf("  -ffast-math -flto          fast-math / link-time optimization\n");
    printf("  -w -Wall -Werror           warning controls\n");
    printf("  -v --verbose               show commands as they run\n");
    printf("  -fcolor -fno-color         force or disable colored diagnostics\n");
    printf("  -fsanitize=<name>          enable a sanitizer\n");
    printf("  -mllvm <arg>               pass <arg> to the LLVM backend\n");
    printf("  -save-temps                keep intermediate files\n");
    printf("  -fno-omit-frame-pointer    keep frame pointer\n");
    printf("  conf/wall.flags            user-extensible flag definitions\n");
    printf("language: %lld operators/expressions in the frontend grammar\n", N_EXPRESSIONS);
}

fn printVersion() void {
    printf("WALL 0.2.0 multiarch\n");
    var dt: str = "aarch64-linux-android";
    if targetTriple != 0 { dt = (str)targetTriple; }
    printf("  target: %s\n", dt);
    printf("  engine: libwall.so (wall_compile)\n");
    printf("  options: %lld registered\n", countFlags());
    printf("  expressions: %lld operators/expressions\n", N_EXPRESSIONS);
    printf("  use: -target <triple> to cross-compile; --print-targets to list\n");
}

// ----------------------------------------------------------------------------
// printTargets: list the codegen targets the backend can target. Because the
// backend is LLVM IR, every triple registered in the installed llc is
// available; this prints the common ones. Use `llc --version` for the full set.
// ----------------------------------------------------------------------------
fn printTargets() void {
    printf("WALL supported codegen targets (via LLVM IR backend):\n");
    printf("  aarch64    aarch64-linux-android (default)\n");
    printf("  x86_64     x86_64-linux-gnu\n");
    printf("  i386       i386-linux-gnu (x86 32-bit)\n");
    printf("  arm        armv7-linux-gnueabihf (aarch32)\n");
    printf("  riscv64    riscv64-linux-gnu\n");
    printf("  riscv32    riscv32-linux-gnu\n");
    printf("  ppc64le    powerpc64le-linux-gnu\n");
    printf("  ppc64      powerpc64-linux-gnu\n");
    printf("  mips64     mips64el-linux-gnuabi64\n");
    printf("  mips       mipsel-linux-gnu\n");
    printf("  wasm32     wasm32-unknown-unknown\n");
    printf("  sparc      sparcv9-linux-gnu\n");
    printf("Run `llc --version` on this system for the complete list.\n");
}
