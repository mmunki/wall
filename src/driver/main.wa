// ============================================================================
// WALL DRIVER MODULE: main.wa  -- driver entry point & option dispatch
// ----------------------------------------------------------------------------
// This is the top-level driver module. It:
//   1. Walks argv, matching each argument against the flag table, and applies
//      the corresponding role to the option-state globals.
//   2. Runs the compile pipeline and, in run mode, executes the result.
//
// All shared declarations/state come from contract.wa (the first module in the
// concatenated translation unit). When compiled into libwall.so, the exported
// entry point is:
//   int wall_driver(int argc, char** argv)
// which is invoked by the tiny `wall` launcher binary.
// ============================================================================

// ============================================================================
// driver entry -- exported from libwall.so as `wall_driver`.
// ============================================================================
fn wall_driver(argc: int, argv: ptr) int {
    initPaths();
    libfill();
    initFlags();
    if argc < 2 { printHelp(); return 1; }

    // load the user-extensible flag config (conf/wall.flags) if present.
    // Search order: install dir, then current working directory.
    bInit(); bCat(SYSROOT); bCat("/conf/wall.flags");
    var cfg: str = (str)malloc(blen + 1);
    memcpy(cfg, bbuf, blen + 1);
    if d_fileExists(cfg) != 1 {
        bInit(); bCat("conf/wall.flags");
        cfg = (str)malloc(blen + 1);
        memcpy(cfg, bbuf, blen + 1);
    }
    if d_fileExists(cfg) == 1 { loadFlagFile(cfg); }

    var i: int = 1;
    output = 0;
    src = 0;
    mode = 0;

    while i < argc {
        var a: str = arg_at(argv, i);
        var role: int = matchFlag(a);
        if role == R_HELP { printHelp(); return 0; }
        elif role == R_VERSION { printVersion(); return 0; }
        elif role == R_PRINTTAR { printTargets(); return 0; }
        elif role == R_TARGET {
            if i + 1 < argc { targetTriple = arg_at(argv, i + 1); i = i + 1; }
        }
        elif role == R_VERBOSE || role == R_VERBOSEX { verbose = 1; }
        elif role == R_OPTLVL0 { optlevel = 0; }
        elif role == R_OPTLVL1 { optlevel = 1; }
        elif role == R_OPTLVL2 { optlevel = 2; }
        elif role == R_OPTLVL3 { optlevel = 3; }
        elif role == R_OPTLVLS || role == R_OPTLVLZ { optlevel = 2; }
        elif role == R_OBJ { mode = 2; emit_obj = 1; }
        elif role == R_ASM { emit_asm = 1; }
        elif role == R_IR { emit_ir = 1; }
        elif role == R_SAVETMP { save_temps = 1; }
        elif role == R_SHARED { shared = 1; pie = 0; }
        elif role == R_PIC { pic = 1; }
        elif role == R_NO_PIE { pie = 0; }
        elif role == R_PIE { pie = 1; }
        elif role == R_NOLINK { do_link = 0; emit_obj = 1; }
        elif role == R_NOWARN { nowarn = 1; }
        elif role == R_WERROR { werror = 1; }
        elif role == R_WARNALL { }
        elif role == R_COLOR { color = 1; }
        elif role == R_NOCOLOR { color = 0; }
        elif role == R_DEBUG { debug = 1; }
        elif role == R_FASTMATH { }
        elif role == R_LTO { }
        elif role == R_PTHREAD { }
        elif role == R_OPENMP { }
        elif role == R_STATIC { pie = 0; }
        elif role == R_RUN { mode = 1; }
        elif role == R_BUILD { mode = 0; }
        elif role == R_OUT {
            if i + 1 < argc { output = arg_at(argv, i + 1); i = i + 1; }
        }
        elif role == R_LINKLIB || role == R_LIBDIR || role == R_INCLUDE
             || role == R_DEFINE || role == R_LINKFLAG {
            // accepted (recorded for linking in future phases); no-op for now
        }
        elif role == R_SANITIZE {
            // accepted; sanitizer wiring reserved
        }
        elif role == R_OPTARG {
            if i + 1 < argc { i = i + 1; } // skip the value
        }
        elif role == R_OPTARGV {
            // map a friendly flag to the literal arg we append to `opt`
            appendOptArg(optArgFor(a));
        }
        elif role == R_LLCARGV {
            appendLlcArg(llcArgFor(a));
        }
        elif role == R_LINKARGV {
            appendLinkArg(linkArgFor(a));
        }
        elif role == R_MLLARGV {
            appendMllArg(mllArgFor(a));
        }
        elif role != R_NONE { }
        elif getbyte(a) == 45 {
            // report the unknown option (quoted) but keep compiling
            bInit(); bCat("unknown option: \""); bCat(a); bCat("\"");
            ewarn(bbuf);
        }
        else { src = a; }
        i = i + 1;
    }

    if src == 0 { eerr("no input files (try --help)"); return 1; }

    // default output name = basename of src minus .wa
    if output == 0 {
        bInit();
        var s: ptr = src;
        var sl: int = strlen(s);
        var st: int = 0;
        var bi: int = 0;
        while bi < sl { if getbyte(s + bi) == 47 { st = bi + 1; } bi = bi + 1; }
        var end: int = sl;
        while end > st {
            var oc: int = end - 1;
            if getbyte(s + oc) == 46 { break; }
            end = end - 1;
        }
        var olen: int = end - st;
        var doti: int = end - 1;
        if olen > 0 && getbyte(s + doti) == 46 { olen = olen - 1; }
        bCatN(s + st, olen);
        output = (ptr)malloc(blen + 1);
        memcpy(output, bbuf, blen + 1);
    }

    // preprocess (resolve imports) from the original source
    var premerged: ptr = (ptr)malloc(4096);
    bInit(); bCat(TMPD); bCat("merged.wa");
    memcpy(premerged, bbuf, blen + 1);
    if preprocess(premerged) != 0 { return 1; }
    srcname = src;   // remember the real source file for diagnostics
    src = premerged;

    // run pipeline
    var rc: int = compileAndLink();
    if rc == 0 && mode == 1 {
        bInit(); bCat("./"); bCat(output);
        run();
    }
    return rc;
}
