fn findall(name: ptr) ptr {
    var s: ptr = locals;
    while s != 0 {
        if strEq((ptr)s[SYM_NAME], name) { return s; }
        s = (ptr)s[SYM_NEXT];
    }
    s = syms;
    while s != 0 {
        if strEq((ptr)s[SYM_NAME], name) { return s; }
        s = (ptr)s[SYM_NEXT];
    }
    return 0;
}
