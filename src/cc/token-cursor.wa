fn cur() int { return tokKind(tpos); }
fn curText() ptr { return tokText(tpos); }
fn curLine() int { return tokLine(tpos); }
fn curPos() int { return tokPos(tpos); }

// ---- ANSI color helpers (professional diagnostics) -------------------------
fn creset() str { if color == 1 { return "\033[0m"; } return ""; }
fn cred()   str { if color == 1 { return "\033[1;31m"; } return ""; }
fn cyel()   str { if color == 1 { return "\033[1;33m"; } return ""; }
fn ccyan()  str { if color == 1 { return "\033[1;36m"; } return ""; }
fn cbold()  str { if color == 1 { return "\033[1m"; } return ""; }
fn cdim()   str { if color == 1 { return "\033[2m"; } return ""; }

// ----------------------------------------------------------------------------
// perr: report a parse/codegen error with full professional context.
// Uses the current token's source offset (tkPos) to find its line and column
// in csrc, then prints the source file, line/column, the offending source line
// verbatim, and a '^' pointing at the exact column under the word. Exits 1.
//
//   wall: e: <file>:<line>:<col>: <short description>
//        <source line verbatim>
//            ^
// ----------------------------------------------------------------------------
fn perr(msg: str) void {
    var pos: int = curPos();
    var ln: int = curLine();
    // find the start of the source line containing `pos`
    var ls: int = 0;
    var l: int = 1;
    var i: int = 0;
    while i < pos {
        if getbyte(csrc + i) == 10 { l = l + 1; ls = i + 1; }
        i = i + 1;
    }
    if l != ln { ln = l; }
    var col: int = pos - ls + 1;
    // extract the source line text
    var lb: ptr = (ptr)malloc(4096);
    var n: int = 0;
    var j: int = ls;
    while j < srclen && getbyte(csrc + j) != 10 && getbyte(csrc + j) != 13 {
        if n < 4090 { setbyte(lb + n, getbyte(csrc + j)); n = n + 1; }
        j = j + 1;
    }
    setbyte(lb + n, 0);
    var nm: str = srcname;
    if nm == 0 { nm = "<input>"; }
    // header: wall: e: file:line:col: description
    printf("%swall:%s %se:%s %s%s:%lld:%lld%s %s\n",
        cyel(), creset(), cred(), creset(),
        ccyan(), nm, ln, col, creset(), msg);
    // source line verbatim
    printf("    %s\n", (str)lb);
    // caret pointing at the column (aligned under the word)
    printf("%s    ", cred());
    var k: int = 0;
    while k < col - 1 { printf(" "); k = k + 1; }
    printf("^%s\n", creset());
    exit(1);
}
