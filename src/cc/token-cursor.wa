fn cur() int { return tokKind(tpos); }
fn curText() ptr { return tokText(tpos); }
fn curLine() int { return tokLine(tpos); }
fn curPos() int { return tokPos(tpos); }

// ----------------------------------------------------------------------------
// perr: report a parse/codegen error with a source caret. Uses the current
// token's source offset (tkPos) to find its line and column in csrc, prints
// the offending source line, and points a '^' at the exact column, followed
// by a short description of the error.
//   wall: line <L>, col <C>: error: <description>
//       <source line>
//           ^
// ----------------------------------------------------------------------------
fn perr(msg: str) void {
    var pos: int = curPos();
    var ln: int = curLine();
    // find the start of the source line containing `pos`
    var ls: int = 0;
    var l: int = 1;
    var i: int = 0;
    while i < pos {
        if getbyte(csrc + i) == 10 { l = l + 1; ls = i + 1; }
        i = i + 1;
    }
    if l != ln { ln = l; }
    var col: int = pos - ls + 1;
    // extract the source line text
    var lb: ptr = (ptr)malloc(4096);
    var n: int = 0;
    var j: int = ls;
    while j < srclen && getbyte(csrc + j) != 10 && getbyte(csrc + j) != 13 {
        if n < 4090 { setbyte(lb + n, getbyte(csrc + j)); n = n + 1; }
        j = j + 1;
    }
    setbyte(lb + n, 0);
    printf("wall: line %lld, col %lld: error: %s\n", ln, col, msg);
    printf("  %s\n", (str)lb);
    var k: int = 0;
    printf("  ");
    while k < col - 1 { printf(" "); k = k + 1; }
    printf("^\n");
}
