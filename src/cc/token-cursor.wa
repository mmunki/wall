fn cur() int { return tokKind(tpos); }
fn curText() ptr { return tokText(tpos); }
fn curLine() int { return tokLine(tpos); }
fn curPos() int { return tokPos(tpos); }

// ---- ANSI color helpers (professional diagnostics, no bold) ----------------
// Colors are emitted only when `color == 1`; otherwise all helpers return "" so
// the output stays clean when piped to a file or another tool.
fn creset() str { if color == 1 { return "\033[0m"; } return ""; }
fn cred()   str { if color == 1 { return "\033[31m"; } return ""; }
fn cgrn()   str { if color == 1 { return "\033[32m"; } return ""; }
fn cyel()   str { if color == 1 { return "\033[33m"; } return ""; }
fn cblu()   str { if color == 1 { return "\033[34m"; } return ""; }
fn cmag()   str { if color == 1 { return "\033[35m"; } return ""; }
fn ccyan()  str { if color == 1 { return "\033[36m"; } return ""; }
fn cdim()   str { if color == 1 { return "\033[2m"; } return ""; }

// ----------------------------------------------------------------------------
// Diagnostics engine.
//
// pdiag(sev, msg, fatal) resolves the current token's source offset (tkPos) to
// its file, line and column, and renders a clang-style report:
//
//   wall: e: <file>:<line>:<col>: <short description>
//      <n> | <source line verbatim>
//          ^        (aligned under the offending column)
//
// where <n> is a right-aligned line-number gutter. `sev` selects the severity
// marker and its color: 0 = e (red), 1 = w (magenta), 2 = n (cyan). When
// `fatal` is set the process exits 1 after printing.
//
// Entry points:
//   perr(msg)  -> error, fatal
//   pwarn(msg) -> warning, non-fatal
//   pnote(msg) -> note, non-fatal
// ----------------------------------------------------------------------------
fn pdiag(sev: int, msg: str, fatal: int) void {
    var pos: int = curPos();
    var ln: int = curLine();
    // find the start of the source line containing `pos`
    var ls: int = 0;
    var l: int = 1;
    var i: int = 0;
    while i < pos {
        if getbyte(csrc + i) == 10 { l = l + 1; ls = i + 1; }
        i = i + 1;
    }
    if l != ln { ln = l; }
    var col: int = pos - ls + 1;
    // extract the source line text
    var lb: ptr = (ptr)malloc(4096);
    var n: int = 0;
    var j: int = ls;
    while j < srclen && getbyte(csrc + j) != 10 && getbyte(csrc + j) != 13 {
        if n < 4090 { setbyte(lb + n, getbyte(csrc + j)); n = n + 1; }
        j = j + 1;
    }
    setbyte(lb + n, 0);
    var nm: str = srcname;
    if nm == 0 { nm = "<input>"; }
    // compute the line-number gutter (right-aligned, min width 3)
    var gw: int = 0;
    var t: int = ln;
    if t == 0 { gw = 1; } else { while t > 0 { gw = gw + 1; t = t / 10; } }
    var minw: int = 3;
    if gw > minw { minw = gw; }
    var gut: ptr = (ptr)malloc(64);
    var gpos: int = 0;
    var pad: int = minw - gw;
    while pad > 0 { setbyte(gut + gpos, 32); gpos = gpos + 1; pad = pad - 1; }
    var dd: ptr = (ptr)malloc(32);
    var di: int = 0;
    var lv: int = ln;
    if lv == 0 { setbyte(dd + di, 48); di = di + 1; }
    else { while lv > 0 { setbyte(dd + di, 48 + (lv % 10)); di = di + 1; lv = lv / 10; } }
    var ri: int = di - 1;
    while ri >= 0 { setbyte(gut + gpos, getbyte(dd + ri)); gpos = gpos + 1; ri = ri - 1; }
    setbyte(gut + gpos, 32); gpos = gpos + 1;   // space
    setbyte(gut + gpos, 124); gpos = gpos + 1;  // |
    setbyte(gut + gpos, 32); gpos = gpos + 1;   // space
    setbyte(gut + gpos, 0);
    var gulen: int = gpos;

    // header
    printf("%swall:%s ", cyel(), creset());
    if sev == 0 { printf("%se:%s ", cred(), creset()); }
    elif sev == 1 { printf("%sw:%s ", cmag(), creset()); }
    else { printf("%sn:%s ", ccyan(), creset()); }
    printf("%s%s:%lld:%lld%s %s\n", ccyan(), nm, ln, col, creset(), msg);
    // source line with a dim gutter
    printf("%s%s%s %s\n", cdim(), (str)gut, creset(), (str)lb);
    // caret line: blank gutter, then '^' aligned under the column
    var ccol: int = gulen + (col - 1);
    printf("%s", cred());
    var u: int = 0;
    while u < ccol { printf(" "); u = u + 1; }
    printf("^%s\n", creset());

    if fatal == 1 { exit(1); }
}

fn perr(msg: str) void { pdiag(0, msg, 1); }
fn pwarn(msg: str) void { pdiag(1, msg, 0); }
fn pnote(msg: str) void { pdiag(2, msg, 0); }
