// ============================================================================
// WALL COMPILER  (csrc/wall.wa)   -- self-hosted Wall compiler
// ----------------------------------------------------------------------------
// Written entirely in Wall. Compiled once by the C stage-0 seed; from then on
// Wall compiles itself (bootstrap):
//     stage0/cc  wall.wa  ->  wall-compiler  (native, pure Wall+LLVM)
//     wall-compiler foo.wa ->  foo.ll -> llc -> .o -> ld.lld -> foo
// ============================================================================

// ---------------- libc externs ---------------------------------------------
extern fn malloc(size: int) ptr;
extern fn free(p: ptr) void;
extern fn realloc(p: ptr, size: int) ptr;
extern fn memcpy(dst: ptr, csrc: ptr, n: int) ptr;
extern fn memset(p: ptr, v: int, n: int) ptr;
extern fn fopen(path: str, mode: str) ptr;
extern fn fread(buf: ptr, size: int, count: int, f: ptr) int;
extern fn fwrite(buf: ptr, size: int, count: int, f: ptr) int;
extern fn fclose(f: ptr) int;
extern fn feof(f: ptr) int;
extern fn fflush(f: ptr) int;
extern fn strlen(s: str) int;
extern fn strcmp(a: str, b: str) int;
extern fn printf(fmt: str, ...) int;
extern fn fprintf(f: ptr, fmt: str, ...) int;
extern fn snprintf(buf: ptr, n: int, fmt: str, ...) int;
extern fn exit(code: int) void;
extern fn getbyte(p: ptr) int;
extern fn setbyte(p: ptr, v: int) void;
extern fn arge() int;
extern fn argp(i: int) str;

// ---------------- token kinds ----------------------------------------------
let TK_EOF = 256;
let TK_INT = 257; let TK_FLOAT = 258; let TK_STR = 259; let TK_IDENT = 260;
let K_LET = 261; let K_VAR = 262; let K_FN = 263; let K_EXTERN = 264;
let K_STRUCT = 265; let K_IF = 266; let K_ELIF = 267; let K_ELSE = 268;
let K_WHILE = 269; let K_FOR = 270; let K_RETURN = 271; let K_BREAK = 272;
let K_CONTINUE = 273; let K_TRUE = 274; let K_FALSE = 275; let K_NULL = 276;
let K_INT = 277; let K_FLOAT = 278; let K_BOOL = 279; let K_STR = 280;
let K_VOID = 281; let K_PTR = 282;
let TK_EQEQ = 283; let TK_NE = 284; let TK_LE = 285; let TK_GE = 286;
let TK_ANDAND = 287; let TK_OROR = 288; let TK_PLUSPLUS = 289;
let TK_MINUSMINUS = 290; let TK_PLUSEQ = 291; let TK_MINUSEQ = 292;
let TK_STAREQ = 293; let TK_SLASHEQ = 294; let TK_PERCENTEQ = 295;
let TK_AMPEQ = 296; let TK_PIPEEQ = 297; let TK_CARETEQ = 298;
let TK_SHL = 299; let TK_SHR = 300; let TK_SHLEQ = 301; let TK_SHREQ = 302;
let TK_ARROW = 303; let TK_ELLIPSIS = 304;
let K_SWITCH = 305; let K_CASE = 306; let K_DEFAULT = 307; let K_SIZEOF = 308;
let K_MATCH = 309; let K_CHAR = 310; let K_BYTE = 311; let K_U8 = 312;
let K_DO = 313; let K_CONST = 314; let K_UNSIGNED = 315; let K_SIGNED = 316;
let K_STATIC = 317; let K_TYPEDEF = 318;
let TK_QQ      = 319;   // ??  null-coalescing
let TK_QQEQ    = 320;   // ??= null-coalescing assign
let TK_ANDANDEQ= 321;   // &&= logical-and assign
let TK_OROREQ  = 322;   // ||= logical-or assign
let TK_STARSTAR= 323;   // **  exponentiation (power)
let TK_STARSTAREQ= 324; // **= power assign
let TK_TRIPLEEQ= 325;   // === strict equality
let TK_TRIPLENE= 326;   // !== strict inequality
let TK_SPACESHIP= 327;  // <=> three-way compare
let TK_USHR    = 328;   // >>> unsigned (logical) shift right

// token struct (stride 32 bytes): kind(0) text(8) ival(16) line(24)
let TOK_KIND = 0; let TOK_TEXT = 8; let TOK_IVAL = 16; let TOK_LINE = 24;

// ---------------- global state ---------------------------------------------
var csrc: ptr = 0;      // pointer to source bytes
var srclen: int = 0;   // source length
var spos: int = 0;     // scan position
var line: int = 1;     // current line
var toks: ptr = 0;     // SB holding token bytes
var tpos: int = 0;     // token index
var tout: ptr = 0;     // output FILE*
var tmpn: int = 0;     // ssa temp counter
var labeln: int = 0;   // label counter
var curret: ptr = 0;   // current return type (string)
var loopdepth: int = 0;
var brkstk0: ptr = 0; var brkstk1: ptr = 0; var brkstk2: ptr = 0;
var brkstk3: ptr = 0; var brkstk4: ptr = 0; var brkstk5: ptr = 0;
var brkstk6: ptr = 0; var brkstk7: ptr = 0; var brkstk8: ptr = 0;
var brkstk9: ptr = 0; var brkstk10: ptr = 0; var brkstk11: ptr = 0;
var brkstk12: ptr = 0; var brkstk13: ptr = 0; var brkstk14: ptr = 0;
var brkstk15: ptr = 0;
var contstk0: ptr = 0; var contstk1: ptr = 0; var contstk2: ptr = 0;
var contstk3: ptr = 0; var contstk4: ptr = 0; var contstk5: ptr = 0;
var contstk6: ptr = 0; var contstk7: ptr = 0; var contstk8: ptr = 0;
var contstk9: ptr = 0; var contstk10: ptr = 0; var contstk11: ptr = 0;
var contstk12: ptr = 0; var contstk13: ptr = 0; var contstk14: ptr = 0;
var contstk15: ptr = 0;

// symbol tables (linked lists of raw-byte nodes)
var syms: ptr = 0;   // globals + functions
var locals: ptr = 0; // locals of current function
// sym node layout: next(0) name(8) ll(16) typ(24) isvar(32) isfunc(40) = 48
let SYM_NEXT = 0; let SYM_NAME = 8; let SYM_LL = 16; let SYM_TYP = 24;
let SYM_ISVAR = 32; let SYM_ISFUNC = 40;

var funcs: ptr = 0;  // function signatures
// func node: next(0) name(8) ret(16) pts(24) np(32) variadic(40) defined(48) = 56
let FUN_NEXT = 0; let FUN_NAME = 8; let FUN_RET = 16; let FUN_PTS = 24;
let FUN_NP = 32; let FUN_VAR = 40; let FUN_DEF = 48;

var structs: ptr = 0; // struct definitions
// struct node: next(0) name(8) sz(16) nf(24) fields(32) = 40
let STR_NEXT = 0; let STR_NAME = 8; let STR_SZ = 16; let STR_NF = 24;
let STR_FIELDS = 32;

var aliases: ptr = 0; // typedef aliases: name(8) -> target type(16), next(0)
let AL_NEXT = 0; let AL_NAME = 8; let AL_TARGET = 16;
// field node: next(0) name(8) typ(16) off(24) sz(32) = 40
let FLD_NEXT = 0; let FLD_NAME = 8; let FLD_TYP = 16; let FLD_OFF = 24;
let FLD_SZ = 32;

// string constant definitions collected at module end
var strdefs: ptr = 0; // SB of concatenated global constant defs
var nstr: int = 0;
var sid: int = 0;     // global string id counter

// ---------------- forward declarations (for mutual recursion) ---------------
extern fn sbNew() ptr;
extern fn sbFree(sb: ptr) void;
extern fn sbLen(sb: ptr) int;
extern fn sbData(sb: ptr) ptr;
extern fn sbReserve(sb: ptr, n: int) void;
extern fn sbAppendChar(sb: ptr, c: int) void;
extern fn sbAppendCStr(sb: ptr, s: ptr) void;
extern fn sbAppendI64(sb: ptr, v: int) void;
extern fn sbAppendStr(sb: ptr, s: ptr) void;
extern fn die(msg: str) void;
extern fn isKw(s: ptr, n: int) int;
extern fn lex() void;
 extern fn top() void;
 extern fn stmt() void;
extern fn assign() void;
extern fn coalesce() void;
extern fn logicOr() void;
extern fn logicAnd() void;
extern fn bitOr() void;
extern fn bitXor() void;
extern fn bitAnd() void;
extern fn equality() void;
extern fn relational() void;
extern fn additive() void;
extern fn shift() void;
extern fn multiplicative() void;
extern fn power() void;
extern fn unary() void;
extern fn postfix() void;
extern fn primary() void;
extern fn callArgs() void;
extern fn block() void;
extern fn parseGlobal() void;
extern fn parseStruct() void;
extern fn parseExtern() void;
extern fn parseFn() void;
extern fn emitIf() void;
extern fn emitSwitch() void;
extern fn declLetVar(isvar: int) void;
extern fn addloc(name: ptr, ll: ptr, typ: ptr, isv: int) void;
extern fn addGlobal(name: ptr, ll: ptr, typ: ptr, isv: int) void;
extern fn findall(name: ptr) ptr;
extern fn findloc(name: ptr) ptr;
extern fn addFunc(name: ptr, ret: ptr, np: int, variadic: int) ptr;
extern fn addParamType(f: ptr, t: ptr) void;
extern fn findFunc(name: ptr) ptr;
extern fn addStruct(name: ptr) ptr;
extern fn addField(st: ptr, name: ptr, typ: ptr) void;
extern fn findStruct(name: ptr) ptr;
extern fn findField(st: ptr, name: ptr) ptr;
extern fn lltyp(t: ptr) ptr;
extern fn szof(t: ptr) int;
extern fn isStructType(t: ptr) int;
extern fn isPtrType(t: ptr) int;
extern fn isType(t: ptr) int;
extern fn addTypeAlias(name: ptr, target: ptr) void;
extern fn resolveType(t: ptr) ptr;
extern fn newtmp() ptr;
extern fn newlabel(pfx: ptr) ptr;
extern fn loadval() void;
extern fn pushLoop(b: ptr, c: ptr) void;
extern fn popLoop() void;
extern fn strEq(a: ptr, b: ptr) int;
extern fn strEq2(s: ptr, lit: str, n: int) int;
extern fn sbAppendToStrlist(list: ptr, s: ptr) ptr;
extern fn coerceBool(reg: ptr, typ: ptr) ptr;

// ---------------- runtime: string builder -----------------------------------
fn strEq(a: ptr, b: ptr) int {
    if strcmp(a, b) == 0 { return 1; }
    return 0;
}
fn sbNew() ptr {
    var sb: ptr = (ptr)malloc(24);
    memset((ptr)sb, 0, 24);
    return sb;
}
fn sbFree(sb: ptr) void {
    if sb[0] != 0 { free((ptr)sb[0]); }
    free(sb);
}
fn sbLen(sb: ptr) int { return sb[8]; }
fn sbData(sb: ptr) ptr { return (ptr)sb[0]; }
fn sbReserve(sb: ptr, n: int) void {
    var need: int = sb[8] + n;
    if need > sb[16] {
        var nc: int = sb[16];
        if nc == 0 { nc = 32; }
        while nc < need { nc = nc * 2; }
        sb[0] = (int)realloc((ptr)sb[0], nc);
        sb[16] = nc;
    }
}
fn sbAppendChar(sb: ptr, c: int) void {
    sbReserve(sb, 1);
    var d: ptr = sbData(sb);
    setbyte(d + sb[8], c);
    sb[8] = sb[8] + 1;
}
fn sbAppendCStr(sb: ptr, s: ptr) void {
    var n: int = strlen(s);
    sbReserve(sb, n);
    var d: ptr = sbData(sb);
    memcpy(d + sb[8], s, n);
    sb[8] = sb[8] + n;
}
fn sbAppendI64(sb: ptr, v: int) void {
    var tmpb: ptr = (ptr)malloc(32);
    var n: int = snprintf(tmpb, 32, "%lld", v);
    sbReserve(sb, n);
    var d: ptr = sbData(sb);
    memcpy(d + sb[8], tmpb, n);
    sb[8] = sb[8] + n;
    free(tmpb);
}
fn sbAppendStr(sb: ptr, s: ptr) void {
    sbAppendCStr(sb, s);
}
fn die(msg: str) void {
    fprintf(tout, "wall: error: %s\n", msg);
    exit(1);
}

// ---------------- token helpers ---------------------------------------------
fn tokBase() ptr { return sbData(toks); }
fn tokKind(i: int) int { var b: ptr = tokBase(); return b[i * 32 + 0]; }
fn tokText(i: int) ptr { var b: ptr = tokBase(); return (ptr)b[i * 32 + 8]; }
fn tokIval(i: int) int { var b: ptr = tokBase(); return b[i * 32 + 16]; }
fn tokLine(i: int) int { var b: ptr = tokBase(); return b[i * 32 + 24]; }
fn pushTok(kind: int, text: ptr, ival: int, ln: int) void {
    sbReserve(toks, 32);
    var b: ptr = tokBase();
    var idx: int = sbLen(toks);
    b[idx + 0] = kind;
    b[idx + 8] = (int)text;
    b[idx + 16] = ival;
    b[idx + 24] = ln;
    toks[8] = idx + 32;
}
fn cur() int { return tokKind(tpos); }
fn curText() ptr { return tokText(tpos); }
fn curLine() int { return tokLine(tpos); }
fn adv() void { tpos = tpos + 1; }
fn expect(kind: int, what: ptr) void {
    if cur() != kind {
        fprintf(tout, "wall: line %d: error: expected %s\n", curLine(), what);
        exit(1);
    }
    adv();
}

// ---------------- lexer ------------------------------------------------------
fn c_isDigit(c: int) int {
    if c >= 48 && c <= 57 { return 1; }
    return 0;
}
fn c_isAlpha(c: int) int {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { return 1; }
    return 0;
}
fn isAlnum(c: int) int {
    if c_isAlpha(c) != 0 || c_isDigit(c) != 0 { return 1; }
    return 0;
}
fn skipWs() void {
    while spos < srclen {
        var c: int = getbyte(csrc + spos);
        if c == 32 || c == 9 || c == 13 { spos = spos + 1; }
        elif c == 10 { spos = spos + 1; line = line + 1; }
        elif c == 47 && spos + 1 < srclen && getbyte(csrc + spos + 1) == 47 {
            while spos < srclen && getbyte(csrc + spos) != 10 { spos = spos + 1; }
        }
        elif c == 47 && spos + 1 < srclen && getbyte(csrc + spos + 1) == 42 {
            spos = spos + 2;
            while spos + 1 < srclen {
                if getbyte(csrc + spos) == 42 && getbyte(csrc + spos + 1) == 47 { spos = spos + 2; break; }
                if getbyte(csrc + spos) == 10 { line = line + 1; }
                spos = spos + 1;
            }
        }
        else { break; }
    }
}
fn isKw(s: ptr, n: int) int {
    if strEq2(s, "let", n) { return K_LET; }
    if strEq2(s, "var", n) { return K_VAR; }
    if strEq2(s, "fn", n) { return K_FN; }
    if strEq2(s, "extern", n) { return K_EXTERN; }
    if strEq2(s, "struct", n) { return K_STRUCT; }
    if strEq2(s, "if", n) { return K_IF; }
    if strEq2(s, "elif", n) { return K_ELIF; }
    if strEq2(s, "else", n) { return K_ELSE; }
    if strEq2(s, "while", n) { return K_WHILE; }
    if strEq2(s, "do", n) { return K_DO; }
    if strEq2(s, "const", n) { return K_CONST; }
    if strEq2(s, "unsigned", n) { return K_UNSIGNED; }
    if strEq2(s, "signed", n) { return K_SIGNED; }
    if strEq2(s, "static", n) { return K_STATIC; }
    if strEq2(s, "typedef", n) { return K_TYPEDEF; }
    if strEq2(s, "for", n) { return K_FOR; }
    if strEq2(s, "return", n) { return K_RETURN; }
    if strEq2(s, "break", n) { return K_BREAK; }
    if strEq2(s, "continue", n) { return K_CONTINUE; }
    if strEq2(s, "true", n) { return K_TRUE; }
    if strEq2(s, "false", n) { return K_FALSE; }
    if strEq2(s, "null", n) { return K_NULL; }
    if strEq2(s, "int", n) { return K_INT; }
    if strEq2(s, "float", n) { return K_FLOAT; }
    if strEq2(s, "bool", n) { return K_BOOL; }
    if strEq2(s, "str", n) { return K_STR; }
    if strEq2(s, "void", n) { return K_VOID; }
    if strEq2(s, "ptr", n) { return K_PTR; }
    if strEq2(s, "char", n) { return K_CHAR; }
    if strEq2(s, "byte", n) { return K_BYTE; }
    if strEq2(s, "u8", n) { return K_U8; }
    if strEq2(s, "switch", n) { return K_SWITCH; }
    if strEq2(s, "case", n) { return K_CASE; }
    if strEq2(s, "default", n) { return K_DEFAULT; }
    if strEq2(s, "sizeof", n) { return K_SIZEOF; }
    if strEq2(s, "match", n) { return K_MATCH; }
    return 0;
}
fn strEq2(s: ptr, lit: str, n: int) int {
    // compare first n bytes of s with null-terminated lit
    if n != strlen(lit) { return 0; }
    var i: int = 0;
    while i < n {
        if getbyte(s + i) != getbyte(lit + i) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn lexNum() void {
    var start: int = spos;
    var isf: int = 0;
    while spos < srclen && c_isDigit(getbyte(csrc + spos)) { spos = spos + 1; }
    if spos < srclen && getbyte(csrc + spos) == 46 {
        isf = 1; spos = spos + 1;
        while spos < srclen && c_isDigit(getbyte(csrc + spos)) { spos = spos + 1; }
    }
    if spos < srclen && (getbyte(csrc + spos) == 101 || getbyte(csrc + spos) == 69) {
        var j: int = spos + 1;
        if j < srclen && (getbyte(csrc + j) == 43 || getbyte(csrc + j) == 45) { j = j + 1; }
        if j < srclen && c_isDigit(getbyte(csrc + j)) {
            isf = 1; spos = j;
            while spos < srclen && c_isDigit(getbyte(csrc + spos)) { spos = spos + 1; }
        }
    }
    var n: int = spos - start;
    var t: ptr = (ptr)malloc(n + 1);
    memcpy(t, csrc + start, n);
    setbyte(t + n, 0);
    // parse int value
    var val: int = 0;
    var i: int = 0;
    var neg: int = 0;
    if isf {
        if isf { pushTok(TK_FLOAT, t, 0, line); }
    } else {
        var k: int = 0;
        if getbyte(t) == 45 { neg = 1; k = 1; }
        while k < n {
            val = val * 10 + (getbyte(t + k) - 48);
            k = k + 1;
        }
        if neg == 1 { val = 0 - val; }
        pushTok(TK_INT, t, val, line);
    }
}
fn lexStr() void {
    var sb: ptr = sbNew();
    spos = spos + 1;
    while spos < srclen {
        var c: int = getbyte(csrc + spos);
        if c == 34 { spos = spos + 1; break; }
        if c == 10 { die("unterminated string literal"); }
        if c == 92 {
            spos = spos + 1;
            var e: int = getbyte(csrc + spos);
            if e >= 48 && e <= 55 {
                var ov: int = 0;
                var od: int = 0;
                while od < 3 && spos < srclen {
                    var oc: int = getbyte(csrc + spos);
                    if oc < 48 || oc > 55 { break; }
                    ov = ov * 8 + (oc - 48);
                    spos = spos + 1;
                    od = od + 1;
                }
                sbAppendChar(sb, ov);
            } elif e == 110 { sbAppendChar(sb, 10); spos = spos + 1; }
            elif e == 116 { sbAppendChar(sb, 9); spos = spos + 1; }
            elif e == 114 { sbAppendChar(sb, 13); spos = spos + 1; }
            elif e == 48 { sbAppendChar(sb, 0); spos = spos + 1; }
            elif e == 92 { sbAppendChar(sb, 92); spos = spos + 1; }
            elif e == 34 { sbAppendChar(sb, 34); spos = spos + 1; }
            elif e == 39 { sbAppendChar(sb, 39); spos = spos + 1; }
            else { sbAppendChar(sb, e); spos = spos + 1; }
        } else { sbAppendChar(sb, c); spos = spos + 1; }
    }
    sbAppendChar(sb, 0);
    var n: int = sbLen(sb) - 1;
    var t: ptr = sbData(sb);
    pushTok(TK_STR, t, n, line);
    free(sb);
}
fn lexChar() void {
    // char literal: 'x' or escaped '\n'. Lexed as an integer token so it can
    // be used anywhere an int literal is expected.
    spos = spos + 1; // consume opening quote
    var val: int = 0;
    if spos < srclen {
        var c: int = getbyte(csrc + spos);
        if c == 92 { // backslash escape
            spos = spos + 1;
            var e: int = 0;
            if spos < srclen { e = getbyte(csrc + spos); }
            if e >= 48 && e <= 55 {
                var ov: int = 0;
                var od: int = 0;
                while od < 3 && spos < srclen {
                    var oc: int = getbyte(csrc + spos);
                    if oc < 48 || oc > 55 { break; }
                    ov = ov * 8 + (oc - 48);
                    spos = spos + 1;
                    od = od + 1;
                }
                val = ov;
            } elif e == 110 { val = 10; spos = spos + 1; }
            elif e == 116 { val = 9; spos = spos + 1; }
            elif e == 114 { val = 13; spos = spos + 1; }
            elif e == 48 { val = 0; spos = spos + 1; }
            elif e == 92 { val = 92; spos = spos + 1; }
            elif e == 39 { val = 39; spos = spos + 1; }
            elif e == 34 { val = 34; spos = spos + 1; }
            else { val = e; spos = spos + 1; }
        } else { val = c; spos = spos + 1; }
    }
    if spos < srclen && getbyte(csrc + spos) == 39 { spos = spos + 1; }
    else { die("unterminated char literal"); }
    var t: ptr = (ptr)malloc(1);
    pushTok(TK_INT, t, val, line);
}
fn lex() void {
    while 1 == 1 {
        skipWs();
        if spos >= srclen { var et: ptr = (ptr)malloc(1); setbyte(et, 0); pushTok(TK_EOF, et, 0, line); return; }
        var c: int = getbyte(csrc + spos);
        if c_isAlpha(c) {
            var start: int = spos;
            while spos < srclen && isAlnum(getbyte(csrc + spos)) { spos = spos + 1; }
            var n: int = spos - start;
            var t: ptr = (ptr)malloc(n + 1);
            memcpy(t, csrc + start, n);
            setbyte(t + n, 0);
            var kw: int = isKw(t, n);
            if kw != 0 { pushTok(kw, t, 0, line); } else { pushTok(TK_IDENT, t, 0, line); }
        }
        elif c_isDigit(c) { lexNum(); }
        elif c == 34 { lexStr(); }
        elif c == 39 { lexChar(); }
        elif c == 43 || c == 45 {
            var nxt: int = 0; if spos + 1 < srclen { nxt = getbyte(csrc + spos + 1); }
            if c == 43 && nxt == 43 { pushTok(TK_PLUSPLUS, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 45 && nxt == 45 { pushTok(TK_MINUSMINUS, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 43 && nxt == 61 { pushTok(TK_PLUSEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 45 && nxt == 61 { pushTok(TK_MINUSEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 45 && nxt == 62 { pushTok(TK_ARROW, (ptr)malloc(1), 0, line); spos = spos + 2; }
            else { pushTok(c, (ptr)malloc(1), 0, line); spos = spos + 1; }
        }
        elif c == 61 || c == 33 || c == 60 || c == 62 {
            var nxt: int = 0; if spos + 1 < srclen { nxt = getbyte(csrc + spos + 1); }
            var n2: int = 0; if spos + 2 < srclen { n2 = getbyte(csrc + spos + 2); }
            if c == 61 && nxt == 61 {
                if n2 == 61 { pushTok(TK_TRIPLEEQ, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_EQEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            elif c == 33 && nxt == 61 {
                if n2 == 61 { pushTok(TK_TRIPLENE, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_NE, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            elif c == 60 && nxt == 61 {
                if n2 == 62 { pushTok(TK_SPACESHIP, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_LE, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            elif c == 62 && nxt == 61 { pushTok(TK_GE, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 60 && nxt == 60 { if n2 == 61 { pushTok(TK_SHLEQ, (ptr)malloc(1), 0, line); spos = spos + 3; } else { pushTok(TK_SHL, (ptr)malloc(1), 0, line); spos = spos + 2; } }
            elif c == 62 && nxt == 62 {
                if n2 == 62 { pushTok(TK_USHR, (ptr)malloc(1), 0, line); spos = spos + 3; }
                elif n2 == 61 { pushTok(TK_SHREQ, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_SHR, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            else { pushTok(c, (ptr)malloc(1), 0, line); spos = spos + 1; }
        }
        elif c == 38 || c == 124 || c == 94 || c == 42 || c == 47 || c == 37 {
            var nxt: int = 0; if spos + 1 < srclen { nxt = getbyte(csrc + spos + 1); }
            var n2: int = 0; if spos + 2 < srclen { n2 = getbyte(csrc + spos + 2); }
            if c == 38 && nxt == 38 {
                if n2 == 61 { pushTok(TK_ANDANDEQ, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_ANDAND, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            elif c == 124 && nxt == 124 {
                if n2 == 61 { pushTok(TK_OROREQ, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_OROR, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            elif c == 42 && nxt == 61 { pushTok(TK_STAREQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 42 && nxt == 42 {
                if n2 == 61 { pushTok(TK_STARSTAREQ, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_STARSTAR, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            elif c == 47 && nxt == 61 { pushTok(TK_SLASHEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 37 && nxt == 61 { pushTok(TK_PERCENTEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 38 && nxt == 61 { pushTok(TK_AMPEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 124 && nxt == 61 { pushTok(TK_PIPEEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            elif c == 94 && nxt == 61 { pushTok(TK_CARETEQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            else { pushTok(c, (ptr)malloc(1), 0, line); spos = spos + 1; }
        }
        elif c == 63 {
            var nxt: int = 0; if spos + 1 < srclen { nxt = getbyte(csrc + spos + 1); }
            var n2: int = 0; if spos + 2 < srclen { n2 = getbyte(csrc + spos + 2); }
            if nxt == 63 {
                if n2 == 61 { pushTok(TK_QQEQ, (ptr)malloc(1), 0, line); spos = spos + 3; }
                else { pushTok(TK_QQ, (ptr)malloc(1), 0, line); spos = spos + 2; }
            }
            else { pushTok(c, (ptr)malloc(1), 0, line); spos = spos + 1; }
        }
        elif c == 46 && spos + 1 < srclen && c_isDigit(getbyte(csrc + spos + 1)) { lexNum(); }
        elif c == 46 && spos + 2 < srclen && getbyte(csrc + spos + 1) == 46 && getbyte(csrc + spos + 2) == 46 {
            pushTok(TK_ELLIPSIS, (ptr)malloc(1), 0, line); spos = spos + 3;
        }
        else { pushTok(c, (ptr)malloc(1), 0, line); spos = spos + 1; }
    }
}

// ---------------- tables -----------------------------------------------------
fn allocNode(n: int) ptr { var p: ptr = (ptr)malloc(n); memset(p, 0, n); return p; }
fn findloc(name: ptr) ptr {
    var s: ptr = locals;
    while s != 0 {
        if strEq((ptr)s[SYM_NAME], name) { return s; }
        s = (ptr)s[SYM_NEXT];
    }
    return 0;
}
fn findall(name: ptr) ptr {
    var s: ptr = locals;
    while s != 0 {
        if strEq((ptr)s[SYM_NAME], name) { return s; }
        s = (ptr)s[SYM_NEXT];
    }
    s = syms;
    while s != 0 {
        if strEq((ptr)s[SYM_NAME], name) { return s; }
        s = (ptr)s[SYM_NEXT];
    }
    return 0;
}
fn addloc(name: ptr, ll: ptr, typ: ptr, isv: int) void {
    var n: ptr = allocNode(48);
    n[SYM_NAME] = (int)name;
    n[SYM_LL] = (int)ll;
    n[SYM_TYP] = (int)typ;
    n[SYM_ISVAR] = isv;
    n[SYM_ISFUNC] = 0;
    n[SYM_NEXT] = (int)locals;
    locals = n;
}
fn addGlobal(name: ptr, ll: ptr, typ: ptr, isv: int) void {
    var n: ptr = allocNode(48);
    n[SYM_NAME] = (int)name;
    n[SYM_LL] = (int)ll;
    n[SYM_TYP] = (int)typ;
    n[SYM_ISVAR] = isv;
    n[SYM_ISFUNC] = 0;
    n[SYM_NEXT] = (int)syms;
    syms = n;
}
fn findFunc(name: ptr) ptr {
    var f: ptr = funcs;
    while f != 0 {
        if strEq((ptr)f[FUN_NAME], name) { return f; }
        f = (ptr)f[FUN_NEXT];
    }
    return 0;
}
fn addFunc(name: ptr, ret: ptr, np: int, variadic: int) ptr {
    // Deduplicate by name: re-declaring the same function (e.g. a libc extern
    // seen in several imported modules) must reuse the existing record so the
    // final IR does not emit conflicting `declare` lines.
    var pre: ptr = findFunc(name);
    if pre != 0 { return pre; }
    var f: ptr = allocNode(56);
    f[FUN_NAME] = (int)name;
    f[FUN_RET] = (int)ret;
    f[FUN_NP] = np;
    f[FUN_VAR] = variadic;
    f[FUN_PTS] = (int)allocNode(16 * 8);
    f[FUN_NEXT] = (int)funcs;
    funcs = f;
    return f;
}
fn addParamType(f: ptr, t: ptr) void {
    var np: int = f[FUN_NP];
    var pts: ptr = (ptr)f[FUN_PTS];
    var idx: int = 0;
    while idx < np {
        if pts[idx * 8] == 0 { pts[idx * 8] = (int)t; return; }
        idx = idx + 1;
    }
    // append
    pts[np * 8] = (int)t;
    f[FUN_NP] = np + 1;
}
fn findStruct(name: ptr) ptr {
    var s: ptr = structs;
    while s != 0 {
        if strEq((ptr)s[STR_NAME], name) { return s; }
        s = (ptr)s[STR_NEXT];
    }
    return 0;
}
fn addStruct(name: ptr) ptr {
    var n: ptr = allocNode(40);
    n[STR_NAME] = (int)name;
    n[STR_SZ] = 0;
    n[STR_NF] = 0;
    n[STR_NEXT] = (int)structs;
    structs = n;
    return n;
}
fn addField(st: ptr, name: ptr, typ: ptr) void {
    var f: ptr = allocNode(40);
    f[FLD_NAME] = (int)name;
    f[FLD_TYP] = (int)typ;
    f[FLD_OFF] = st[STR_SZ];
    f[FLD_SZ] = szof(typ);
    f[FLD_NEXT] = (int)st[STR_FIELDS];
    st[STR_FIELDS] = (int)f;
    st[STR_SZ] = st[STR_SZ] + f[FLD_SZ];
    st[STR_NF] = st[STR_NF] + 1;
}
fn findField(st: ptr, name: ptr) ptr {
    var f: ptr = (ptr)st[STR_FIELDS];
    while f != 0 {
        if strEq((ptr)f[FLD_NAME], name) { return f; }
        f = (ptr)f[FLD_NEXT];
    }
    return 0;
}
fn isStructType(t: ptr) int {
    if t == 0 { return 0; }
    if findStruct(t) != 0 { return 1; }
    return 0;
}
 fn isPtrType(t: ptr) int {
     if t == 0 { return 0; }
     if strEq(t, "ptr") != 0 || strEq(t, "str") != 0 { return 1; }
     t = resolveType(t);
     if strEq(t, "ptr") != 0 || strEq(t, "str") != 0 { return 1; }
     return 0;
 }
fn addTypeAlias(name: ptr, target: ptr) void {
    var n: ptr = (ptr)malloc(24);
    n[AL_NAME] = (int)name;
    n[AL_TARGET] = (int)target;
    n[AL_NEXT] = (int)aliases;
    aliases = n;
}
fn findAlias(name: ptr) ptr {
    var a: ptr = aliases;
    while a != 0 {
        if strEq((ptr)a[AL_NAME], name) != 0 { return a; }
        a = (ptr)a[AL_NEXT];
    }
    return 0;
}
// resolveType: follow typedef aliases to the underlying base type name.
fn resolveType(t: ptr) ptr {
    var seen: int = 0;
    while seen < 32 {
        if t == 0 { return "ptr"; }
        var a: ptr = findAlias(t);
        if a == 0 { return t; }
        t = (ptr)a[AL_TARGET];
        seen = seen + 1;
    }
    return t;
}
fn isType(t: ptr) int {
    if t == 0 { return 0; }
    if strEq(t, "int") != 0 || strEq(t, "float") != 0 || strEq(t, "bool") != 0 { return 1; }
    if strEq(t, "str") != 0 || strEq(t, "void") != 0 || strEq(t, "ptr") != 0 { return 1; }
    if strEq(t, "char") != 0 || strEq(t, "byte") != 0 || strEq(t, "u8") != 0 { return 1; }
    if isStructType(t) != 0 { return 1; }
    if findAlias(t) != 0 { return 1; }
    return 0;
}
fn lltyp(t: ptr) ptr {
    t = resolveType(t);
    if strEq(t, "int") { return "i64"; }
    if strEq(t, "float") { return "double"; }
    if strEq(t, "bool") { return "i1"; }
    if strEq(t, "str") { return "i8*"; }
    if strEq(t, "void") { return "void"; }
    if strEq(t, "ptr") { return "i8*"; }
    if strEq(t, "char") || strEq(t, "byte") || strEq(t, "u8") { return "i8"; }
    return "i8*";
}
fn szof(t: ptr) int {
    t = resolveType(t);
    if strEq(t, "int") || strEq(t, "float") || strEq(t, "str") || strEq(t, "ptr") { return 8; }
    if strEq(t, "bool") || strEq(t, "char") || strEq(t, "byte") || strEq(t, "u8") { return 1; }
    var s: ptr = findStruct(t);
    if s != 0 { return s[STR_SZ]; }
    return 8;
}

// ---------------- codegen helpers -------------------------------------------
fn newtmp() ptr {
    var sb: ptr = sbNew();
    sbAppendChar(sb, 37); // '%'
    sbAppendCStr(sb, "t");
    sbAppendI64(sb, tmpn);
    tmpn = tmpn + 1;
    sbAppendChar(sb, 0);
    var s: ptr = sbData(sb);
    return s;
}
fn newlabel(pfx: ptr) ptr {
    var sb: ptr = sbNew();
    sbAppendCStr(sb, pfx);
    sbAppendI64(sb, labeln);
    labeln = labeln + 1;
    sbAppendChar(sb, 0);
    var s: ptr = sbData(sb);
    return s;
}
fn pushLoop(b: ptr, c: ptr) void {
    loopdepth = loopdepth + 1;
    if loopdepth == 1 { brkstk1 = b; contstk1 = c; }
    elif loopdepth == 2 { brkstk2 = b; contstk2 = c; }
    elif loopdepth == 3 { brkstk3 = b; contstk3 = c; }
    elif loopdepth == 4 { brkstk4 = b; contstk4 = c; }
    elif loopdepth == 5 { brkstk5 = b; contstk5 = c; }
    elif loopdepth == 6 { brkstk6 = b; contstk6 = c; }
    elif loopdepth == 7 { brkstk7 = b; contstk7 = c; }
    elif loopdepth == 8 { brkstk8 = b; contstk8 = c; }
    elif loopdepth == 9 { brkstk9 = b; contstk9 = c; }
    elif loopdepth == 10 { brkstk10 = b; contstk10 = c; }
    elif loopdepth == 11 { brkstk11 = b; contstk11 = c; }
    elif loopdepth == 12 { brkstk12 = b; contstk12 = c; }
    elif loopdepth == 13 { brkstk13 = b; contstk13 = c; }
    elif loopdepth == 14 { brkstk14 = b; contstk14 = c; }
    else { brkstk15 = b; contstk15 = c; }
}
fn popLoop() void { loopdepth = loopdepth - 1; }
fn brkLabel() ptr {
    if loopdepth == 0 { return brkstk0; }
    if loopdepth == 1 { return brkstk1; }
    if loopdepth == 2 { return brkstk2; }
    if loopdepth == 3 { return brkstk3; }
    if loopdepth == 4 { return brkstk4; }
    if loopdepth == 5 { return brkstk5; }
    if loopdepth == 6 { return brkstk6; }
    if loopdepth == 7 { return brkstk7; }
    if loopdepth == 8 { return brkstk8; }
    if loopdepth == 9 { return brkstk9; }
    if loopdepth == 10 { return brkstk10; }
    if loopdepth == 11 { return brkstk11; }
    if loopdepth == 12 { return brkstk12; }
    if loopdepth == 13 { return brkstk13; }
    if loopdepth == 14 { return brkstk14; }
    return brkstk15;
}
fn contLabel() ptr {
    if loopdepth == 0 { return contstk0; }
    if loopdepth == 1 { return contstk1; }
    if loopdepth == 2 { return contstk2; }
    if loopdepth == 3 { return contstk3; }
    if loopdepth == 4 { return contstk4; }
    if loopdepth == 5 { return contstk5; }
    if loopdepth == 6 { return contstk6; }
    if loopdepth == 7 { return contstk7; }
    if loopdepth == 8 { return contstk8; }
    if loopdepth == 9 { return contstk9; }
    if loopdepth == 10 { return contstk10; }
    if loopdepth == 11 { return contstk11; }
    if loopdepth == 12 { return contstk12; }
    if loopdepth == 13 { return contstk13; }
    if loopdepth == 14 { return contstk14; }
    return contstk15;
}

// expression value holders (globals set by expr parser)
var vreg: ptr = 0;   // ssa register (string) or 0
var vaddr: ptr = 0;  // address (string) or 0
var vtype: ptr = 0;  // type name or 0
var vfn: ptr = 0;    // function name or 0
fn loadval() void { /* no-op: value is in vreg */ }

fn setVal(reg: ptr, addr: ptr, typ: ptr, fn_: ptr) void {
    vreg = reg; vaddr = addr; vtype = typ; vfn = fn_;
}
fn condval() ptr {
    return coerceBool(vreg, vtype);
}
fn coerceBool(reg: ptr, typ: ptr) ptr {
    if typ != 0 && strEq(typ, "bool") != 0 { return reg; }
    var r: ptr = newtmp();
    fprintf(tout, "  %s = icmp ne i64 %s, 0\n", r, reg);
    return r;
}
fn coerceInt(reg: ptr, typ: ptr) ptr {
    if typ == 0 { return reg; }
    if strEq(typ, "bool") != 0 { var r: ptr = newtmp(); fprintf(tout, "  %s = zext i1 %s to i64\n", r, reg); return r; }
    if isPtrType(typ) != 0 || isStructType(typ) != 0 { var r: ptr = newtmp(); fprintf(tout, "  %s = ptrtoint i8* %s to i64\n", r, reg); return r; }
    return reg;
}
fn coercePtr(reg: ptr, typ: ptr) ptr {
    if typ != 0 && (isPtrType(typ) != 0 || isStructType(typ) != 0) { return reg; }
    var p: ptr = newtmp();
    fprintf(tout, "  %s = inttoptr i64 %s to i8*\n", p, reg);
    return p;
}

// ---------------- expression parser -----------------------------------------
fn primary() void {
    var k: int = cur();
    if k == TK_INT {
        var r: ptr = newtmp();
        fprintf(tout, "  %s = sext i32 %lld to i64\n", r, tokIval(tpos));
        adv(); setVal(r, 0, "int", 0); return;
    }
    if k == TK_FLOAT {
        var r: ptr = newtmp();
        fprintf(tout, "  %s = fadd double 0.000000e+00, %s\n", r, tokText(tpos));
        adv(); setVal(r, 0, "float", 0); return;
    }
    if k == TK_STR {
        var id: int = sid; sid = sid + 1;
        var g: ptr = (ptr)malloc(32);
        snprintf(g, 32, "@.str%d", id);
        var n: int = tokIval(tpos);
        // build global constant definition
        var def: ptr = sbNew();
        var hdr: ptr = (ptr)malloc(128);
        snprintf(hdr, 128, "  %s = private constant [%lld x i8] c\"", g, n + 1);
        sbAppendCStr(def, hdr);
        var tb: ptr = tokText(tpos);
        var i: int = 0;
        while i < n {
            var cc: int = getbyte(tb + i);
            if cc == 92 { sbAppendCStr(def, "\\5C"); }
            elif cc == 34 { sbAppendCStr(def, "\\22"); }
            elif cc == 10 { sbAppendCStr(def, "\\0A"); }
            elif cc == 9 { sbAppendCStr(def, "\\09"); }
            elif cc == 13 { sbAppendCStr(def, "\\0D"); }
            elif cc >= 32 && cc < 127 { sbAppendChar(def, cc); }
            else { var h: ptr = (ptr)malloc(8); snprintf(h, 8, "\\%02X", cc); sbAppendCStr(def, h); }
            i = i + 1;
        }
        sbAppendCStr(def, "\\00\"\n");
        sbAppendChar(def, 0);
        strdefs = sbAppendToStrlist(strdefs, sbData(def));
        nstr = nstr + 1;
        var gp: ptr = newtmp();
        var r: ptr = newtmp();
        fprintf(tout, "  %s = getelementptr inbounds [%lld x i8], [%lld x i8]* %s, i64 0, i64 0\n", gp, n + 1, n + 1, g);
        fprintf(tout, "  %s = bitcast i8* %s to i8*\n", r, gp);
        adv(); setVal(r, 0, "str", 0); return;
    }
    if k == K_TRUE { var r: ptr = newtmp(); fprintf(tout, "  %s = icmp ne i64 1, 0\n", r); adv(); setVal(r, 0, "bool", 0); return; }
    if k == K_FALSE { var r: ptr = newtmp(); fprintf(tout, "  %s = icmp eq i64 1, 0\n", r); adv(); setVal(r, 0, "bool", 0); return; }
    if k == K_NULL { var r: ptr = newtmp(); fprintf(tout, "  %s = bitcast i64 0 to i8*\n", r); adv(); setVal(r, 0, "ptr", 0); return; }
    if k == TK_IDENT {
        var s: ptr = findall(curText());
        if s == 0 { fprintf(tout, "wall: line %d: error: undefined identifier '%s'\n", curLine(), curText()); exit(1); }
        if s[SYM_ISFUNC] != 0 { setVal(0, 0, "fn", (ptr)s[SYM_NAME]); adv(); return; }
        if isStructType((ptr)s[SYM_TYP]) != 0 { setVal((ptr)s[SYM_LL], (ptr)s[SYM_LL], (ptr)s[SYM_TYP], 0); adv(); return; }
        var r: ptr = newtmp();
        var ll: ptr = lltyp((ptr)s[SYM_TYP]);
        if strEq(ll, "void") { fprintf(tout, "wall: line %d: error: void value\n", curLine()); exit(1); }
        fprintf(tout, "  %s = load %s, %s* %s\n", r, ll, ll, (ptr)s[SYM_LL]);
        setVal(r, (ptr)s[SYM_LL], (ptr)s[SYM_TYP], 0);
        adv(); return;
    }
    if k == 40 { // '('
        adv(); assign(); expect(41, "')'"); return;
    }
    fprintf(tout, "wall: line %d: error: unexpected token '%s'\n", curLine(), curText());
    exit(1);
}
fn sbAppendToStrlist(list: ptr, s: ptr) ptr {
    // simple growable array of char* (each 8 bytes)
    var idx: int = nstr;
    list = (ptr)realloc(list, (idx + 1) * 8);
    list[idx * 8] = (int)s;
    return list;
}
fn callArgs() void {
    var f: ptr = findFunc(vfn);
    // builtins
    if vfn != 0 && strEq(vfn, "getbyte") {
        assign(); expect(41, "')'");
        var r: ptr = newtmp(); var r2: ptr = newtmp();
        fprintf(tout, "  %s = load i8, i8* %s\n", r, vreg);
        fprintf(tout, "  %s = zext i8 %s to i64\n", r2, r);
        setVal(r2, 0, "int", 0); return;
    }
    if vfn != 0 && strEq(vfn, "setbyte") {
        assign();   // pointer -> vreg
        var pp: ptr = vreg;
        expect(44, "','");
        assign();   // value -> vreg
        expect(41, "')'");
        var r: ptr = newtmp();
        fprintf(tout, "  %s = trunc i64 %s to i8\n", r, vreg);
        fprintf(tout, "  store i8 %s, i8* %s\n", r, pp);
        setVal(0, 0, "void", 0); return;
    }
    if vfn != 0 && strEq(vfn, "arge") {
        expect(41, "')'");
        var r: ptr = newtmp();
        fprintf(tout, "  %s = load i64, i64* @w_argc\n", r);
        setVal(r, 0, "int", 0); return;
    }
    if vfn != 0 && strEq(vfn, "argp") {
        assign();   // index -> vreg
        var idx: ptr = vreg;
        expect(41, "')'");
        var r: ptr = newtmp();
        fprintf(tout, "  %s = load i8**, i8*** @w_argv\n", r);
        var r2: ptr = newtmp();
        fprintf(tout, "  %s = getelementptr i8*, i8** %s, i64 %s\n", r2, r, idx);
        var r3: ptr = newtmp();
        fprintf(tout, "  %s = load i8*, i8** %s\n", r3, r2);
        setVal(r3, 0, "str", 0); return;
    }
    // count + collect args
    var cfn: ptr = vfn;
    var n: int = 0;
    var args: ptr = (ptr)malloc(16 * 8);
    var argt: ptr = (ptr)malloc(16 * 8);
    if cur() != 41 {
        while 1 == 1 {
            assign();
            args[n * 8] = (int)vreg;
            argt[n * 8] = (int)vtype;
            n = n + 1;
            if cur() == 44 { adv(); } else { break; }
        }
    }
    expect(41, "')'");
    var rt: ptr = lltyp((ptr)f[FUN_RET]);
    var isvoid: int = 0;
    if strEq(rt, "void") != 0 { isvoid = 1; }
    // emit coercion instructions for args before the call line
    var cargs: ptr = (ptr)malloc((n + 1) * 8);
    var i: int = 0;
    var pts: ptr = (ptr)f[FUN_PTS];
    while i < n {
        var at: ptr;
        if i < f[FUN_NP] { at = lltyp((ptr)pts[i * 8]); } else { at = lltyp((ptr)argt[i * 8]); }
        var val: ptr = (ptr)args[i * 8];
        var vty: ptr = (ptr)argt[i * 8];
        if strEq(at, "i8*") != 0 && vty != 0 && isPtrType(vty) == 0 && isStructType(vty) == 0 {
            var p: ptr = newtmp();
            fprintf(tout, "  %s = inttoptr i64 %s to i8*\n", p, val);
            cargs[i * 8] = (int)p;
        } else {
            cargs[i * 8] = (int)val;
        }
        i = i + 1;
    }
    var rr: ptr = 0;
    if isvoid == 1 {
        fprintf(tout, "  call void @%s(", cfn);
    } else {
        rr = newtmp();
        fprintf(tout, "  %s = call %s @%s(", rr, rt, cfn);
    }
    i = 0;
    while i < n {
        if i > 0 { fprintf(tout, ", "); }
        var at2: ptr;
        if i < f[FUN_NP] { at2 = lltyp((ptr)pts[i * 8]); } else { at2 = lltyp((ptr)argt[i * 8]); }
        fprintf(tout, "%s %s", at2, (ptr)cargs[i * 8]);
        i = i + 1;
    }
    fprintf(tout, ")\n");
    if isvoid == 1 { setVal(0, 0, "void", 0); } else { setVal(rr, 0, (ptr)f[FUN_RET], 0); }
}
fn postfix() void {
    primary();
    while 1 == 1 {
        var k: int = cur();
        if k == 40 && vtype != 0 && strEq(vtype, "fn") { adv(); callArgs(); continue; }
        if k == 40 { die("cannot call a non-function value"); }
        if k == 46 { // '.'
            adv(); var fname: ptr = curText(); expect(TK_IDENT, "field name");
            if vaddr == 0 { die("cannot access field of non-addressable value"); }
            var st: ptr = findStruct(vtype);
            if st == 0 { fprintf(tout, "wall: type '%s' has no fields\n", vtype); exit(1); }
            var fld: ptr = findField(st, fname);
            if fld == 0 { fprintf(tout, "wall: type '%s' has no field '%s'\n", vtype, fname); exit(1); }
            var addr: ptr = newtmp();
            fprintf(tout, "  %s = getelementptr inbounds i8, i8* %s, i32 %lld\n", addr, vaddr, fld[FLD_OFF]);
            var fl: ptr = lltyp((ptr)fld[FLD_TYP]);
            var r: ptr = 0;
            if strEq(fl, "void") == 0 { r = newtmp(); fprintf(tout, "  %s = load %s, %s* %s\n", r, fl, fl, addr); }
            setVal(r, addr, (ptr)fld[FLD_TYP], 0);
            continue;
        }
        if k == 91 { // '['
            adv();
            var base: ptr = vreg;
            assign();   // index -> vreg
            expect(93, "']'");
            var addr: ptr = newtmp();
            fprintf(tout, "  %s = getelementptr i8, i8* %s, i64 %s\n", addr, base, vreg);
            var r: ptr = newtmp();
            fprintf(tout, "  %s = load i64, i64* %s\n", r, addr);
            setVal(r, addr, "int", 0);
            continue;
        }
        if k == TK_PLUSPLUS || k == TK_MINUSMINUS {
            if vaddr == 0 { die("cannot modify rvalue"); }
            var isp: int = 0; if k == TK_PLUSPLUS { isp = 1; }
            adv();
            var fl: ptr = lltyp(vtype);
            var old: ptr = newtmp(); var nu: ptr = newtmp();
            fprintf(tout, "  %s = load %s, %s* %s\n", old, fl, fl, vaddr);
            if isp == 1 { fprintf(tout, "  %s = add %s %s, 1\n", nu, fl, old); } else { fprintf(tout, "  %s = sub %s %s, 1\n", nu, fl, old); }
            fprintf(tout, "  store %s %s, %s* %s\n", fl, nu, fl, vaddr);
            setVal(old, 0, vtype, 0);
            continue;
        }
        break;
    }
}
fn unary() void {
    var k: int = cur();
    if k == 40 && isType(tokText(tpos + 1)) != 0 {
        adv(); var ty: ptr = curText(); adv(); expect(41, "')'");
        unary();
        var dst: ptr = lltyp(ty);
        var csrc: ptr = lltyp(vtype);
        var r: ptr = newtmp();
        var sp: int = 0; if strEq(csrc, "i8*") != 0 { sp = 1; }
        var dp: int = 0; if strEq(dst, "i8*") != 0 { dp = 1; }
        var sf: int = 0; if strEq(csrc, "double") != 0 { sf = 1; }
        var df: int = 0; if strEq(dst, "double") != 0 { df = 1; }
        var si: int = 0; if strEq(csrc, "i64") != 0 || strEq(csrc, "i1") != 0 { si = 1; }
        var di: int = 0; if strEq(dst, "i64") != 0 || strEq(dst, "i1") != 0 { di = 1; }
        if sp == 1 && dp == 1 { fprintf(tout, "  %s = bitcast i8* %s to i8*\n", r, vreg); }
        elif sp == 1 && di == 1 { fprintf(tout, "  %s = ptrtoint i8* %s to %s\n", r, vreg, dst); }
        elif dp == 1 && si == 1 { fprintf(tout, "  %s = inttoptr %s %s to i8*\n", r, csrc, vreg); }
        elif sp == 1 && df == 1 { fprintf(tout, "  %s = ptrtoint i8* %s to i64\n", r, vreg); }
        elif sf == 1 && dp == 1 { fprintf(tout, "  %s = inttoptr i64 0 to i8*\n", r); }
        elif sf == 1 && di == 1 { fprintf(tout, "  %s = fptosi double %s to %s\n", r, vreg, dst); }
        elif si == 1 && df == 1 { fprintf(tout, "  %s = sitofp %s %s to double\n", r, csrc, vreg); }
        elif strEq(csrc, "i1") == 1 && strEq(dst, "i64") == 1 { fprintf(tout, "  %s = zext i1 %s to i64\n", r, vreg); }
        elif strEq(csrc, "i64") == 1 && strEq(dst, "i1") == 1 { fprintf(tout, "  %s = icmp ne i64 %s, 0\n", r, vreg); }
        elif sf == 1 && df == 1 { fprintf(tout, "  %s = bitcast double %s to double\n", r, vreg); }
        else { fprintf(tout, "  %s = bitcast %s %s to %s\n", r, csrc, vreg, dst); }
        setVal(r, 0, ty, 0);
        return;
    }
    if k == 45 { adv(); unary(); var r: ptr = newtmp(); fprintf(tout, "  %s = sub i64 0, %s\n", r, vreg); setVal(r, 0, vtype, 0); return; }
    if k == 33 { adv(); unary(); var r: ptr = newtmp(); fprintf(tout, "  %s = icmp eq i64 0, %s\n", r, vreg); setVal(r, 0, "bool", 0); return; }
    if k == 126 { adv(); unary(); var r: ptr = newtmp(); fprintf(tout, "  %s = xor i64 %s, -1\n", r, vreg); setVal(r, 0, vtype, 0); return; }
    if k == 42 { adv(); unary(); var r: ptr = newtmp(); fprintf(tout, "  %s = load i64, i64* %s\n", r, vreg); setVal(r, 0, "int", 0); return; }
    if k == 38 { adv(); unary(); if vaddr == 0 { die("cannot take address of rvalue"); } var r: ptr = newtmp(); fprintf(tout, "  %s = bitcast i8* %s to i8*\n", r, vaddr); setVal(r, 0, "ptr", 0); return; }
    if k == K_SIZEOF {
        // sizeof(type)  or  sizeof(expr)  -- yields size in bytes as an int
        adv(); expect(40, "'('");
        var ty: ptr = 0;
        if isType(tokText(tpos)) != 0 { ty = curText(); adv(); }
        else {
            // sizeof(expr): parse the expression, ignore its value
            assign();
            ty = vtype;
        }
        expect(41, "')'");
        var r: ptr = newtmp();
        var sz: int = szof(ty);
        fprintf(tout, "  %s = sext i32 %lld to i64\n", r, sz);
        setVal(r, 0, "int", 0);
        return;
    }
    postfix();
}
fn power() void {
    unary();
    if cur() == TK_STARSTAR {
        adv();
        var av: ptr = vreg; var at: ptr = vtype;
        var a: ptr = coerceInt(av, at);
        power();
        var b: ptr = coerceInt(vreg, vtype);
        var lp: ptr = newlabel(".PL"); var bd: ptr = newlabel(".PB"); var ex: ptr = newlabel(".PX");
        var acc: ptr = newtmp(); var i: ptr = newtmp();
        fprintf(tout, "  %s = alloca i64\n", acc);
        fprintf(tout, "  %s = alloca i64\n", i);
        fprintf(tout, "  store i64 1, i64* %s\n", acc);
        fprintf(tout, "  store i64 0, i64* %s\n", i);
        fprintf(tout, "  br label %%%s\n", lp);
        fprintf(tout, "%s:\n", lp);
        var iv: ptr = newtmp(); var cv: ptr = newtmp();
        fprintf(tout, "  %s = load i64, i64* %s\n", iv, i);
        fprintf(tout, "  %s = icmp slt i64 %s, %s\n", cv, iv, b);
        fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", cv, bd, ex);
        fprintf(tout, "%s:\n", bd);
        var avv: ptr = newtmp(); var mv: ptr = newtmp(); var i2: ptr = newtmp();
        fprintf(tout, "  %s = load i64, i64* %s\n", avv, acc);
        fprintf(tout, "  %s = mul i64 %s, %s\n", mv, avv, a);
        fprintf(tout, "  store i64 %s, i64* %s\n", mv, acc);
        fprintf(tout, "  %s = add i64 %s, 1\n", i2, iv);
        fprintf(tout, "  store i64 %s, i64* %s\n", i2, i);
        fprintf(tout, "  br label %%%s\n", lp);
        fprintf(tout, "%s:\n", ex);
        var r: ptr = newtmp();
        fprintf(tout, "  %s = load i64, i64* %s\n", r, acc);
        setVal(r, 0, at, 0);
        return;
    }
}
fn multiplicative() void {
    power();
    while 1 == 1 {
        var k: int = cur();
        if k == 42 {
            adv(); var save: ptr = vreg; var savet: ptr = vtype; power();
            var r: ptr = newtmp();
            fprintf(tout, "  %s = mul i64 %s, %s\n", r, save, vreg);
            setVal(r, 0, savet, 0);
        }
        elif k == 47 {
            adv(); var save: ptr = vreg; var savet: ptr = vtype; power();
            var r: ptr = newtmp();
            fprintf(tout, "  %s = sdiv i64 %s, %s\n", r, save, vreg);
            setVal(r, 0, savet, 0);
        }
        elif k == 37 {
            adv(); var save: ptr = vreg; var savet: ptr = vtype; power();
            var r: ptr = newtmp();
            fprintf(tout, "  %s = srem i64 %s, %s\n", r, save, vreg);
            setVal(r, 0, savet, 0);
        }
        else { break; }
    }
}
fn additive() void {
    multiplicative();
    while 1 == 1 {
        var k: int = cur();
        if k == 43 || k == 45 {
            adv();
            var savea: ptr = vreg; var sa: ptr = vtype;
            multiplicative();
            var r: ptr = newtmp();
            if isPtrType(sa) != 0 && isPtrType(vtype) == 0 {
                if k == 43 { fprintf(tout, "  %s = getelementptr i8, i8* %s, i64 %s\n", r, savea, vreg); } else { fprintf(tout, "  %s = getelementptr i8, i8* %s, i64 -%s\n", r, savea, vreg); }
                setVal(r, 0, sa, 0);
            } else {
                if k == 43 { fprintf(tout, "  %s = add i64 %s, %s\n", r, savea, vreg); } else { fprintf(tout, "  %s = sub i64 %s, %s\n", r, savea, vreg); }
                setVal(r, 0, sa, 0);
            }
        }
        else { break; }
    }
}
fn shift() void {
    additive();
    while 1 == 1 {
        var k: int = cur();
        if k == TK_SHL || k == TK_SHR || k == TK_USHR {
            adv();
            var save: ptr = vreg; var sa: ptr = vtype;
            additive();
            var l: ptr = coerceInt(save, sa);
            var r: ptr = coerceInt(vreg, vtype);
            var rr: ptr = newtmp();
            if k == TK_SHL { fprintf(tout, "  %s = shl i64 %s, %s\n", rr, l, r); }
            elif k == TK_SHR { fprintf(tout, "  %s = ashr i64 %s, %s\n", rr, l, r); }
            else { fprintf(tout, "  %s = lshr i64 %s, %s\n", rr, l, r); }
            setVal(rr, 0, sa, 0);
        }
        else { break; }
    }
}
fn relational() void {
    shift();
    while 1 == 1 {
        var k: int = cur();
        if k == 60 || k == 62 || k == TK_LE || k == TK_GE || k == TK_SPACESHIP {
            adv();
            var save: ptr = vreg; var savet: ptr = vtype;
            shift();
            var l: ptr = coerceInt(save, savet);
            var r: ptr = coerceInt(vreg, vtype);
            var rr: ptr = newtmp();
            if k == 60 { fprintf(tout, "  %s = icmp slt i64 %s, %s\n", rr, l, r); }
            elif k == 62 { fprintf(tout, "  %s = icmp sgt i64 %s, %s\n", rr, l, r); }
            elif k == TK_LE { fprintf(tout, "  %s = icmp sle i64 %s, %s\n", rr, l, r); }
            elif k == TK_GE { fprintf(tout, "  %s = icmp sge i64 %s, %s\n", rr, l, r); }
            else {
                // spaceship <=>  :  returns -1, 0 or 1
                var lt: ptr = newtmp(); var gt: ptr = newtmp();
                var g64: ptr = newtmp(); var l64: ptr = newtmp();
                fprintf(tout, "  %s = icmp slt i64 %s, %s\n", lt, l, r);
                fprintf(tout, "  %s = icmp sgt i64 %s, %s\n", gt, l, r);
                fprintf(tout, "  %s = zext i1 %s to i64\n", g64, gt);
                fprintf(tout, "  %s = zext i1 %s to i64\n", l64, lt);
                fprintf(tout, "  %s = sub i64 %s, %s\n", rr, g64, l64);
                setVal(rr, 0, "int", 0);
                continue;
            }
            setVal(rr, 0, "bool", 0);
        }
        else { break; }
    }
}
fn equality() void {
    relational();
    while 1 == 1 {
        var k: int = cur();
        if k == TK_EQEQ || k == TK_NE || k == TK_TRIPLEEQ || k == TK_TRIPLENE {
            adv();
            var save: ptr = vreg; var savet: ptr = vtype;
            relational();
            var l: ptr = coerceInt(save, savet);
            var r: ptr = coerceInt(vreg, vtype);
            var rr: ptr = newtmp();
            if k == TK_EQEQ || k == TK_TRIPLEEQ { fprintf(tout, "  %s = icmp eq i64 %s, %s\n", rr, l, r); } else { fprintf(tout, "  %s = icmp ne i64 %s, %s\n", rr, l, r); }
            setVal(rr, 0, "bool", 0);
        }
        else { break; }
    }
}
fn bitAnd() void {
    equality();
    while 1 == 1 { if cur() == 38 { adv(); var save: ptr = vreg; var sa: ptr = vtype; equality(); var r: ptr = newtmp(); fprintf(tout, "  %s = and i64 %s, %s\n", r, save, vreg); setVal(r, 0, sa, 0); } else { break; } }
}
fn bitXor() void {
    bitAnd();
    while 1 == 1 { if cur() == 94 { adv(); var save: ptr = vreg; var sa: ptr = vtype; bitAnd(); var r: ptr = newtmp(); fprintf(tout, "  %s = xor i64 %s, %s\n", r, save, vreg); setVal(r, 0, sa, 0); } else { break; } }
}
fn bitOr() void {
    bitXor();
    while 1 == 1 { if cur() == 124 { adv(); var save: ptr = vreg; var sa: ptr = vtype; bitXor(); var r: ptr = newtmp(); fprintf(tout, "  %s = or i64 %s, %s\n", r, save, vreg); setVal(r, 0, sa, 0); } else { break; } }
}
fn logicAnd() void {
    bitOr();
    while 1 == 1 { if cur() == TK_ANDAND { adv(); var save: ptr = vreg; var savet: ptr = vtype; bitOr(); var l: ptr = coerceBool(save, savet); var r: ptr = coerceBool(vreg, vtype); var rr: ptr = newtmp(); fprintf(tout, "  %s = and i1 %s, %s\n", rr, l, r); setVal(rr, 0, "bool", 0); } else { break; } }
}
fn logicOr() void {
    logicAnd();
    while 1 == 1 { if cur() == TK_OROR { adv(); var save: ptr = vreg; var savet: ptr = vtype; logicAnd(); var l: ptr = coerceBool(save, savet); var r: ptr = coerceBool(vreg, vtype); var rr: ptr = newtmp(); fprintf(tout, "  %s = or i1 %s, %s\n", rr, l, r); setVal(rr, 0, "bool", 0); } else { break; } }
}
fn coalesce() void {
    logicOr();
    while 1 == 1 {
        if cur() == TK_QQ {
            adv();
            var la: ptr = vreg; var lat: ptr = vtype;
            var ca: ptr = coerceInt(la, lat);
            var cb: ptr = newtmp();
            fprintf(tout, "  %s = icmp ne i64 %s, 0\n", cb, ca);
            var tl: ptr = newlabel(".CQT"); var el: ptr = newlabel(".CQE"); var ml: ptr = newlabel(".CQM");
            fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", cb, tl, el);
            fprintf(tout, "%s:\n", tl);
            fprintf(tout, "  br label %%%s\n", ml);
            fprintf(tout, "%s:\n", el);
            logicOr();
            var rb: ptr = coerceInt(vreg, vtype);
            fprintf(tout, "  br label %%%s\n", ml);
            fprintf(tout, "%s:\n", ml);
            var r: ptr = newtmp();
            fprintf(tout, "  %s = phi i64 [ %s, %%%s ], [ %s, %%%s ]\n", r, ca, tl, rb, el);
            setVal(r, 0, lat, 0);
        }
        else { break; }
    }
}
fn assign() void {
    // try lvalue assignment
    if cur() == TK_IDENT {
        var s: ptr = findall(curText());
        if s != 0 && s[SYM_ISFUNC] == 0 {
            var save: int = tpos;
            var base: ptr = (ptr)s[SYM_LL];
            var lv: ptr = base; var lvt: ptr = (ptr)s[SYM_TYP];
            adv();
            while cur() == 46 || cur() == 91 {
                if cur() == 46 {
                    adv(); var fname: ptr = curText(); expect(TK_IDENT, "field name");
                    var st: ptr = findStruct(lvt);
                    var fld: ptr = findField(st, fname);
                    var addr: ptr = newtmp();
                    var si: ptr = lv;
                    if isPtrType(lvt) != 0 { var vl: ptr = newtmp(); fprintf(tout, "  %s = load i8*, i8** %s\n", vl, lv); si = vl; }
                    fprintf(tout, "  %s = getelementptr inbounds i8, i8* %s, i32 %lld\n", addr, si, fld[FLD_OFF]);
                    lv = addr; lvt = (ptr)fld[FLD_TYP];
                } else {
                    adv(); assign(); expect(93, "']'");
                    var addr: ptr = newtmp();
                    var si: ptr = lv;
                    if isPtrType(lvt) != 0 { var vl: ptr = newtmp(); fprintf(tout, "  %s = load i8*, i8** %s\n", vl, lv); si = vl; }
                    fprintf(tout, "  %s = getelementptr i8, i8* %s, i64 %s\n", addr, si, vreg);
                    lv = addr; lvt = "int";
                }
            }
            var k: int = cur();
            if k == 61 || k == TK_PLUSEQ || k == TK_MINUSEQ || k == TK_STAREQ || k == TK_SLASHEQ ||
               k == TK_PERCENTEQ || k == TK_AMPEQ || k == TK_PIPEEQ || k == TK_CARETEQ || k == TK_SHLEQ || k == TK_SHREQ ||
               k == TK_ANDANDEQ || k == TK_OROREQ || k == TK_QQEQ {
                adv();
                var fl: ptr = lltyp(lvt);
                if k == 61 {
                    assign();
                    if strEq(fl, "void") != 0 { die("cannot store void"); }
                    var sv: ptr = vreg;
                    if strEq(fl, "i8*") != 0 { sv = coercePtr(vreg, vtype); }
                    fprintf(tout, "  store %s %s, %s* %s\n", fl, sv, fl, lv);
                    setVal(sv, 0, lvt, 0);
                    return;
                }
                elif k == TK_QQEQ {
                    // a ??= b  =>  if (a == 0) { a = b }
                    var old: ptr = newtmp();
                    fprintf(tout, "  %s = load %s, %s* %s\n", old, fl, fl, lv);
                    var oldi: ptr = coerceInt(old, lvt);
                    var c0: ptr = newtmp();
                    fprintf(tout, "  %s = icmp ne i64 %s, 0\n", c0, oldi);
                    var qt: ptr = newlabel(".CQT"); var qe: ptr = newlabel(".CQE"); var qm: ptr = newlabel(".CQM");
                    fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", c0, qt, qe);
                    fprintf(tout, "%s:\n", qt);
                    fprintf(tout, "  br label %%%s\n", qm);
                    fprintf(tout, "%s:\n", qe);
                    assign();
                    var sv: ptr = vreg;
                    if strEq(fl, "i8*") != 0 { sv = coercePtr(vreg, vtype); }
                    fprintf(tout, "  store %s %s, %s* %s\n", fl, sv, fl, lv);
                    fprintf(tout, "  br label %%%s\n", qm);
                    fprintf(tout, "%s:\n", qm);
                    var rr: ptr = newtmp();
                    fprintf(tout, "  %s = phi %s [ %s, %%%s ], [ %s, %%%s ]\n", rr, fl, old, qt, sv, qe);
                    setVal(rr, 0, lvt, 0);
                    return;
                }
                else {
                    var old: ptr = newtmp();
                    fprintf(tout, "  %s = load %s, %s* %s\n", old, fl, fl, lv);
                    var saverv: ptr = vreg;
                    assign();
                    var r: ptr = newtmp();
                    if k == TK_PLUSEQ { fprintf(tout, "  %s = add %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_MINUSEQ { fprintf(tout, "  %s = sub %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_STAREQ { fprintf(tout, "  %s = mul %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_SLASHEQ { fprintf(tout, "  %s = sdiv %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_PERCENTEQ { fprintf(tout, "  %s = srem %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_AMPEQ || k == TK_ANDANDEQ { fprintf(tout, "  %s = and %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_PIPEEQ || k == TK_OROREQ { fprintf(tout, "  %s = or %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_CARETEQ { fprintf(tout, "  %s = xor %s %s, %s\n", r, fl, old, vreg); }
                    elif k == TK_SHLEQ { fprintf(tout, "  %s = shl %s %s, %s\n", r, fl, old, vreg); }
                    else { fprintf(tout, "  %s = ashr %s %s, %s\n", r, fl, old, vreg); }
                    fprintf(tout, "  store %s %s, %s* %s\n", fl, r, fl, lv);
                    setVal(r, 0, lvt, 0);
                    return;
                }
            }
            tpos = save;
        }
    }
    coalesce();
    // ternary conditional:  cond ? a : b
    if cur() == 63 {
        adv();
        var ccond: ptr = vreg; var ctyp: ptr = vtype;
        var thenlab: ptr = newlabel(".LT"); var elselab: ptr = newlabel(".LE"); var endlab: ptr = newlabel(".LD");
        var cb: ptr = coerceBool(ccond, ctyp);
        fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", cb, thenlab, elselab);
        fprintf(tout, "%s:\n", thenlab);
        assign();
        var tval: ptr = vreg; var ttyp: ptr = vtype;
        fprintf(tout, "br label %%%s\n", endlab);
        fprintf(tout, "%s:\n", elselab);
        expect(58, "':'");
        assign();
        var eval: ptr = vreg; var etyp: ptr = vtype;
        fprintf(tout, "br label %%%s\n", endlab);
        fprintf(tout, "%s:\n", endlab);
        // merge with a phi node joining the two branch values
        var fl: ptr = lltyp(ttyp);
        var phi: ptr = newtmp();
        fprintf(tout, "  %s = phi %s [ %s, %%%s ], [ %s, %%%s ]\n", phi, fl, tval, thenlab, eval, elselab);
        setVal(phi, 0, ttyp, 0);
        return;
    }
}

// ---------------- statements ------------------------------------------------
fn declLetVar(isvar: int) void {
    var name: ptr = curText(); expect(TK_IDENT, "variable name");
    var typ: ptr = 0;
    if cur() == 58 { adv(); typ = curText(); adv(); }
    var hasinit: int = 0;
    if cur() == 61 { adv(); assign(); hasinit = 1; }
    if typ == 0 { if hasinit == 1 { typ = vtype; } else { die("declaration needs a type or initializer"); } }
    if isStructType(typ) != 0 {
        var an: ptr = newtmp();
        var n: int = szof(typ);
        fprintf(tout, "  %s = alloca [%lld x i8]\n", an, n);
        var p: ptr = newtmp();
        fprintf(tout, "  %s = bitcast [%lld x i8]* %s to i8*\n", p, n, an);
        expect(59, "';'");
        addloc(name, p, typ, 1);
        return;
    }
    var an: ptr = newtmp();
    var fl: ptr = lltyp(typ);
    fprintf(tout, "  %s = alloca %s\n", an, fl);
    if strEq(fl, "void") != 0 { die("cannot init void"); }
    if hasinit == 1 {
        if strEq(fl, "i8*") != 0 && isPtrType(vtype) == 0 && isStructType(vtype) == 0 {
            var p: ptr = newtmp();
            fprintf(tout, "  %s = inttoptr i64 %s to i8*\n", p, vreg);
            fprintf(tout, "  store i8* %s, i8** %s\n", p, an);
        } else {
            fprintf(tout, "  store %s %s, %s* %s\n", fl, vreg, fl, an);
        }
    }
    expect(59, "';'");
    addloc(name, an, typ, 1);
}
fn emitIf() void {
    adv(); // 'if'
    var end: ptr = newlabel("ifend");
    var thenlab: ptr = newlabel("ift");
    var next: ptr = newlabel("ifn");
    assign();
    fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", condval(), thenlab, next);
    fprintf(tout, "%s:\n", thenlab);
    block();
    fprintf(tout, "br label %%%s\n", end);
    fprintf(tout, "%s:\n", next);
    while 1 == 1 {
        var k: int = cur();
        if k == K_ELIF {
            adv(); var tl: ptr = newlabel("ift"); var nx: ptr = newlabel("ifn");
            assign();
            fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", condval(), tl, nx);
            fprintf(tout, "%s:\n", tl);
            block();
            fprintf(tout, "br label %%%s\n", end);
            fprintf(tout, "%s:\n", nx);
        }
        elif k == K_ELSE {
            adv(); block(); fprintf(tout, "br label %%%s\n", end); break;
        }
        else { fprintf(tout, "br label %%%s\n", end); break; }
    }
    fprintf(tout, "%s:\n", end);
}
fn emitSwitch() void {
    // switch (expr) { case c1: stmts; ... default: stmts; }
    // Compiled as a chain of comparisons against a single value, each case
    // branching to its own body; a `default` body (wherever it appears) is
    // collected into a dedicated label and used as the fall-through target
    // for unmatched values.
    adv(); // 'switch'
    expect(40, "'('");
    assign();
    var sval: ptr = vreg; var styp: ptr = vtype;
    expect(41, "')'");
    expect(123, "'{'");
    var end: ptr = newlabel("swend");
    var si: ptr = coerceInt(sval, styp);
    var defflab: ptr = 0;
    var defs: int = 0; var defe: int = 0; // token range of default body
    var hasdef: int = 0;
    while cur() != 125 {
        if cur() == K_CASE {
            adv();
            assign(); // case value
            var cval: ptr = vreg;
            expect(58, "':'");
            var body: ptr = newlabel("swb"); var nx: ptr = newlabel("swn");
            var cv: ptr = coerceInt(cval, vtype);
            var cmp: ptr = newtmp();
            fprintf(tout, "  %s = icmp eq i64 %s, %s\n", cmp, si, cv);
            fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", cmp, body, nx);
            fprintf(tout, "%s:\n", body);
            while cur() != 125 && cur() != K_CASE && cur() != K_DEFAULT { stmt(); }
            fprintf(tout, "br label %%%s\n", end);
            fprintf(tout, "%s:\n", nx);
        }
        elif cur() == K_DEFAULT {
            // Record the default body's token range but do NOT emit it here.
            // It is re-parsed and emitted after the case chain, so it catches
            // all unmatched values regardless of where `default` appears.
            adv(); expect(58, "':'");
            hasdef = 1;
            defs = tpos;
            while cur() != 125 && cur() != K_CASE { stmt(); }
            defe = tpos;
        }
        else { die("expected 'case' or 'default' in switch"); }
    }
    expect(125, "'}'");
    if hasdef == 1 {
        defflab = newlabel("swd");
        fprintf(tout, "br label %%%s\n", defflab);
        fprintf(tout, "%s:\n", defflab);
        var saved: int = tpos;
        tpos = defs;
        while tpos < defe { stmt(); }
        tpos = saved;
        fprintf(tout, "br label %%%s\n", end);
    }
    else { fprintf(tout, "br label %%%s\n", end); }
    fprintf(tout, "%s:\n", end);
}
 fn stmt() void {
     var k: int = cur();
     if k == K_LET { adv(); declLetVar(0); return; }
     if k == K_VAR { adv(); declLetVar(1); return; }
     if k == K_CONST || k == K_UNSIGNED || k == K_SIGNED || k == K_STATIC {
         // storage/qualifier keywords: skip and treat the following
         // declaration as a plain `var` (they carry no codegen effect here).
         while cur() == K_CONST || cur() == K_UNSIGNED || cur() == K_SIGNED || cur() == K_STATIC {
             adv();
             if cur() == K_VAR || cur() == K_LET { adv(); }
         }
         declLetVar(1);
         return;
     }
     if k == K_TYPEDEF {
         // typedef name = type; -- recorded as a plain integer alias.
         adv();
         var tname: ptr = curText(); expect(TK_IDENT, "typedef name");
         expect(61, "'='");
         var ttyp: ptr = curText(); adv();
         addTypeAlias(tname, ttyp);
         expect(59, "';'");
         return;
     }
    if k == K_RETURN {
        adv();
        if cur() != 59 {
            assign();
            var fl: ptr = lltyp(curret);
            if strEq(fl, "void") != 0 {
                fprintf(tout, "  ret void\n");
            } elif strEq(fl, "i8*") != 0 && isPtrType(vtype) == 0 && isStructType(vtype) == 0 {
                var p: ptr = newtmp();
                fprintf(tout, "  %s = inttoptr i64 %s to i8*\n", p, vreg);
                fprintf(tout, "  ret i8* %s\n", p);
            } else { fprintf(tout, "  ret %s %s\n", fl, vreg); }
        } else { fprintf(tout, "  ret void\n"); }
        expect(59, "';'");
        return;
    }
    if k == K_IF { emitIf(); return; }
    if k == K_SWITCH { emitSwitch(); return; }
    if k == K_MATCH { emitSwitch(); return; }
     if k == K_WHILE {
         adv();
         var top: ptr = newlabel("w"); var body: ptr = newlabel("b"); var end: ptr = newlabel("e");
         fprintf(tout, "br label %%%s\n", top);
         fprintf(tout, "%s:\n", top);
         assign();
         fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", condval(), body, end);
         fprintf(tout, "%s:\n", body);
         pushLoop(end, top);
         block();
         popLoop();
         fprintf(tout, "br label %%%s\n", top);
         fprintf(tout, "%s:\n", end);
         return;
     }
     if k == K_DO {
         adv();
         var body: ptr = newlabel("db"); var cond: ptr = newlabel("dc"); var end: ptr = newlabel("de");
         fprintf(tout, "br label %%%s\n", body);
         fprintf(tout, "%s:\n", body);
         pushLoop(end, cond);
         block();
         popLoop();
         fprintf(tout, "br label %%%s\n", cond);
         fprintf(tout, "%s:\n", cond);
         expect(K_WHILE, "'while'");
         assign();
         fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", condval(), body, end);
         fprintf(tout, "%s:\n", end);
         expect(59, "';'");
         return;
     }
    if k == K_FOR {
        adv();
        var vname: ptr = curText(); expect(TK_IDENT, "loop variable"); expect(61, "'='");
        assign();
        var an: ptr = newtmp();
        fprintf(tout, "  %s = alloca i64\n", an);
        fprintf(tout, "  store i64 %s, i64* %s\n", vreg, an);
        addloc(vname, an, "int", 1);
        expect(59, "';'");
        var top: ptr = newlabel("f"); var body: ptr = newlabel("b"); var step: ptr = newlabel("s"); var end: ptr = newlabel("e");
        fprintf(tout, "br label %%%s\n", top);
        fprintf(tout, "%s:\n", top);
        assign();
        fprintf(tout, "  br i1 %s, label %%%s, label %%%s\n", condval(), body, end);
        expect(59, "';'");
        var stepstart: int = tpos; var stepend: int = tpos; var d: int = 0;
        while stepend < 1000000 {
            var kk: int = tokKind(stepend);
            if kk == 123 { if d == 0 { break; } d = d - 1; }
            elif kk == 125 { d = d + 1; }
            stepend = stepend + 1;
        }
        tpos = stepend;
        fprintf(tout, "%s:\n", body);
        pushLoop(end, step);
        block();
        popLoop();
        fprintf(tout, "br label %%%s\n", step);
        fprintf(tout, "%s:\n", step);
        var saved: int = tpos;
        tpos = stepstart;
        while tpos < stepend { assign(); tpos = stepend; }
        tpos = saved;
        fprintf(tout, "br label %%%s\n", top);
        fprintf(tout, "%s:\n", end);
        return;
    }
    if k == K_BREAK { adv(); if loopdepth > 0 { fprintf(tout, "br label %%%s\n", brkLabel()); } expect(59, "';'"); return; }
    if k == K_CONTINUE { adv(); if loopdepth > 0 { fprintf(tout, "br label %%%s\n", contLabel()); } expect(59, "';'"); return; }
    if k == 123 { block(); return; }
    assign();
    expect(59, "';'");
}
fn block() void {
    expect(123, "'{'");
    while cur() != 125 { stmt(); }
    expect(125, "'}'");
}

// ---------------- top level --------------------------------------------------
fn parseStruct() void {
    adv();
    var name: ptr = curText(); expect(TK_IDENT, "struct name");
    var st: ptr = addStruct(name);
    expect(123, "'{'");
    while cur() != 125 {
        var fname: ptr = curText(); expect(TK_IDENT, "field name");
        expect(58, "':'");
        var ftyp: ptr = curText(); adv();
        addField(st, fname, ftyp);
        if cur() == 44 { adv(); }
    }
    expect(125, "'}'");
}
fn parseExtern() void {
    adv(); expect(K_FN, "'fn'");
    var name: ptr = curText(); expect(TK_IDENT, "function name");
    expect(40, "'('");
    var f: ptr = addFunc(name, "void", 0, 0);
    while cur() != 41 {
        if cur() == TK_ELLIPSIS { f[FUN_VAR] = 1; adv(); break; }
        expect(TK_IDENT, "param name");
        expect(58, "':'");
        var pt: ptr = curText(); adv();
        addParamType(f, pt);
        if cur() == TK_ELLIPSIS { f[FUN_VAR] = 1; adv(); break; }
        if cur() == 44 { adv(); }
    }
    expect(41, "')'");
    var ret: ptr = curText(); adv();
    f[FUN_RET] = (int)ret;
    expect(59, "';'");
    // declare is emitted at end only if this extern is never defined in-module
    var g: ptr = allocNode(48);
    g[SYM_NAME] = (int)name; g[SYM_LL] = (int)name; g[SYM_TYP] = (int)ret;
    g[SYM_ISFUNC] = 1; g[SYM_NEXT] = (int)syms;
    syms = g;
}
fn parseFn() void {
     adv();
     var name: ptr = curText(); expect(TK_IDENT, "function name");
    expect(40, "'('");
    var f: ptr = addFunc(name, "void", 0, 0);
    var pnames: ptr = (ptr)malloc(16 * 8);
    var np: int = 0;
    while cur() != 41 {
        if cur() == TK_ELLIPSIS { adv(); break; }
        var pn: ptr = curText(); expect(TK_IDENT, "param name");
        expect(58, "':'");
        var pt: ptr = curText(); adv();
        addParamType(f, pt);
        pnames[np * 8] = (int)pn;
        np = np + 1;
        if cur() == 44 { adv(); }
    }
    expect(41, "')'");
    var ret: ptr = curText(); adv();
    f[FUN_RET] = (int)ret;
    var g: ptr = allocNode(48);
    g[SYM_NAME] = (int)name; g[SYM_LL] = (int)name; g[SYM_TYP] = (int)ret;
    g[SYM_ISFUNC] = 1; g[SYM_NEXT] = (int)syms;
    syms = g;
    // mark defined so no duplicate declare is emitted
    var df: ptr = funcs;
    while df != 0 {
        if strEq((ptr)df[FUN_NAME], name) != 0 { df[FUN_DEF] = 1; }
        df = (ptr)df[FUN_NEXT];
    }
    expect(123, "'{'");
    fprintf(tout, "define %s @%s(", lltyp(ret), name);
    var i: int = 0;
    var pts: ptr = (ptr)f[FUN_PTS];
    if strEq(name, "main") != 0 {
        fprintf(tout, "i32 %%arge0, i8** %%argv0");
    } else {
        while i < f[FUN_NP] {
            if i > 0 { fprintf(tout, ", "); }
            fprintf(tout, "%s %%%s", lltyp((ptr)pts[i * 8]), (ptr)pnames[i * 8]);
            i = i + 1;
        }
    }
    fprintf(tout, ") {\n");
    locals = 0;
    if strEq(name, "main") != 0 {
        fprintf(tout, "  %%ar = sext i32 %%arge0 to i64\n");
        fprintf(tout, "  store i64 %%ar, i64* @w_argc\n");
        fprintf(tout, "  store i8** %%argv0, i8*** @w_argv\n");
    }
    i = 0;
    while i < f[FUN_NP] {
        var an: ptr = newtmp();
        var ptl: ptr = lltyp((ptr)pts[i * 8]);
        fprintf(tout, "  %s = alloca %s\n", an, ptl);
        fprintf(tout, "  store %s %%%s, %s* %s\n", ptl, (ptr)pnames[i * 8], ptl, an);
        addloc((ptr)pnames[i * 8], an, (ptr)pts[i * 8], 1);
        i = i + 1;
    }
    var prevret: ptr = curret;
    curret = ret;
    while cur() != 125 { stmt(); }
    expect(125, "'}'");
    if strEq(lltyp(ret), "void") != 0 { fprintf(tout, "  ret void\n"); } elif strEq(lltyp(ret), "i8*") != 0 { fprintf(tout, "  ret i8* null\n"); } else { fprintf(tout, "  ret %s 0\n", lltyp(ret)); }
    fprintf(tout, "}\n");
    locals = 0;
    curret = prevret;
}
fn parseGlobal() void {
    var isv: int = 0;
    while cur() == K_CONST || cur() == K_UNSIGNED || cur() == K_SIGNED || cur() == K_STATIC {
        adv();
        if cur() == K_LET || cur() == K_VAR { adv(); }
    }
    if cur() == K_VAR || cur() == K_LET { isv = 1; adv(); }
    var name: ptr = curText(); expect(TK_IDENT, "variable name");
    var typ: ptr = 0;
    if cur() == 58 { adv(); typ = curText(); adv(); }
    var hasinit: int = 0;
    var litkind: int = 0; var litint: int = 0; var litfloat: ptr = 0;
    if cur() == 61 {
        adv();
        if cur() == TK_INT { litkind = TK_INT; litint = tokIval(tpos); hasinit = 1; adv(); }
        elif cur() == TK_FLOAT { litkind = TK_FLOAT; litfloat = tokText(tpos); hasinit = 1; adv(); }
        else { assign(); hasinit = 1; }
    }
    expect(59, "';'");
    if typ == 0 { typ = "int"; }
    var fl: ptr = lltyp(typ);
    var g: ptr = (ptr)malloc(64);
    snprintf(g, 64, "@%s", name);
    if hasinit == 1 && litkind == TK_INT && strEq(fl, "i64") != 0 { fprintf(tout, "%s = global %s %lld\n", g, fl, litint); }
    elif hasinit == 1 && litkind == TK_FLOAT && strEq(fl, "double") != 0 { fprintf(tout, "%s = global %s %s\n", g, fl, litfloat); }
    elif hasinit == 1 && litkind == TK_INT && strEq(fl, "double") != 0 { fprintf(tout, "%s = global %s %lld.000000e+00\n", g, fl, litint); }
    elif strEq(fl, "i8*") != 0 { fprintf(tout, "%s = global %s null\n", g, fl); }
    else { fprintf(tout, "%s = global %s 0\n", g, fl); }
    addGlobal(name, g, typ, isv);
}
  fn top() void {
      var k: int = cur();
      if k == K_STRUCT { parseStruct(); }
     elif k == K_EXTERN { parseExtern(); }
     elif k == K_FN { parseFn(); }
     elif k == K_LET || k == K_VAR { parseGlobal(); }
     elif k == K_CONST || k == K_UNSIGNED || k == K_SIGNED || k == K_STATIC {
         // parseGlobal skips leading qualifier/var/let keywords itself.
         parseGlobal();
     }
     elif k == K_TYPEDEF {
         adv();
         var tname: ptr = curText(); expect(TK_IDENT, "typedef name");
         expect(61, "'='");
         var ttyp: ptr = curText(); adv();
         addTypeAlias(tname, ttyp);
         expect(59, "';'");
     }
     elif k == TK_EOF { return; }
     else { die("unexpected token at top level"); }
 }

// ---------------- main -------------------------------------------------------
fn readFile(path: str) ptr {
    var f: ptr = fopen(path, "rb");
    if f == 0 { return 0; }
    var sb: ptr = sbNew();
    var buf: ptr = (ptr)malloc(4096);
    while 1 == 1 {
        var n: int = fread(buf, 1, 4096, f);
        if n <= 0 { break; }
        sbReserve(sb, n);
        var d: ptr = sbData(sb);
        memcpy(d + sbLen(sb), buf, n);
        sb[8] = sbLen(sb) + n;
    }
    fclose(f);
    return sb;
}
// Library entry: compile a single .wa file to LLVM IR text.
// Returns 0 on success, 1 on failure. Reusable by the `wall` driver
// and exported from libwall.so.
fn wall_compile(infile: str, outfile: str) int {
    var file: ptr = readFile(infile);
    if file == 0 { printf("wall: cannot open %s\n", infile); return 1; }
    csrc = sbData(file);
    srclen = sbLen(file);
    toks = sbNew();
    strdefs = 0;
    nstr = 0;
    sid = 0;
    tmpn = 0;
    labeln = 0;
    loopdepth = 0;
    syms = 0;
    funcs = 0;
    structs = 0;
    aliases = 0;
    lex();
    tout = fopen(outfile, "w");
    if tout == 0 { printf("wall: cannot write %s\n", outfile); return 1; }
    fprintf(tout, "; ModuleID = 'wall'\n");
    fprintf(tout, "target triple = \"aarch64-linux-android\"\n\n");
    fprintf(tout, "@w_argc = global i64 0\n@w_argv = global i8** null\n\n");
    while cur() != TK_EOF { top(); }
    var df: ptr = funcs;
    while df != 0 {
        if df[FUN_DEF] == 0 {
            fprintf(tout, "declare %s @%s(", lltyp((ptr)df[FUN_RET]), (ptr)df[FUN_NAME]);
            var pi: int = 0;
            var ppts: ptr = (ptr)df[FUN_PTS];
            while pi < df[FUN_NP] {
                if pi > 0 { fprintf(tout, ", "); }
                fprintf(tout, "%s", lltyp((ptr)ppts[pi * 8]));
                pi = pi + 1;
            }
            if df[FUN_VAR] == 1 { if df[FUN_NP] > 0 { fprintf(tout, ", "); } fprintf(tout, "..."); }
            fprintf(tout, ")\n");
        }
        df = (ptr)df[FUN_NEXT];
    }
    var j: int = 0;
    var sd: ptr = strdefs;
    while j < nstr { fprintf(tout, "%s", (ptr)sd[j * 8]); j = j + 1; }
    fclose(tout);
    return 0;
}

// ============================================================================
// WALL STANDARD LIBRARY: lib/array.wa  -- dynamic int array
// ----------------------------------------------------------------------------
// A minimal dynamic array of 64-bit integers implemented in pure Wall.
//
// Layout (a 32-byte struct accessed via pointer arithmetic):
//   [0]  data pointer  (i64*)
//   [8]  length        (i64)
//   [16] capacity      (i64)
//
//     import "lib/array.wa";
//
// All functions take the array pointer; array_new() creates one. Free with
// array_free(). Grows geometrically on push.
// ============================================================================

// ---------------- libc -------------------------------------------------------
extern fn malloc(size: int) ptr;
extern fn free(p: ptr) void;
extern fn realloc(p: ptr, size: int) ptr;
extern fn memcpy(dst: ptr, src: ptr, n: int) ptr;

// ---------------- offsets -----------------------------------------------------
let ARR_DATA = 0;
let ARR_LEN = 8;
let ARR_CAP = 16;

fn array_new() ptr {
    var a: ptr = (ptr)malloc(24);
    a[ARR_DATA] = 0;
    a[ARR_LEN] = 0;
    a[ARR_CAP] = 0;
    return a;
}
fn array_len(a: ptr) int {
    return a[ARR_LEN];
}
fn array_cap(a: ptr) int {
    return a[ARR_CAP];
}
fn array_empty(a: ptr) int {
    return a[ARR_LEN] == 0 ? 1 : 0;
}
fn array_get(a: ptr, i: int) int {
    if i < 0 || i >= a[ARR_LEN] { return 0; }
    var d: ptr = (ptr)a[ARR_DATA];
    return d[i * 8];
}
fn array_set(a: ptr, i: int, v: int) void {
    if i < 0 || i >= a[ARR_LEN] { return; }
    var d: ptr = (ptr)a[ARR_DATA];
    d[i * 8] = v;
}
fn array_reserve(a: ptr, need: int) void {
    if need > a[ARR_CAP] {
        var nc: int = a[ARR_CAP];
        if nc == 0 { nc = 8; }
        while nc < need { nc = nc * 2; }
        a[ARR_DATA] = (int)realloc((ptr)a[ARR_DATA], nc * 8);
        a[ARR_CAP] = nc;
    }
}
fn array_push(a: ptr, v: int) void {
    array_reserve(a, a[ARR_LEN] + 1);
    var d: ptr = (ptr)a[ARR_DATA];
    d[a[ARR_LEN] * 8] = v;
    a[ARR_LEN] = a[ARR_LEN] + 1;
}
fn array_pop(a: ptr) int {
    if a[ARR_LEN] == 0 { return 0; }
    a[ARR_LEN] = a[ARR_LEN] - 1;
    return array_get(a, a[ARR_LEN]);
}
fn array_front(a: ptr) int {
    return array_get(a, 0);
}
fn array_back(a: ptr) int {
    return array_get(a, a[ARR_LEN] - 1);
}
fn array_clear(a: ptr) void {
    a[ARR_LEN] = 0;
}
fn array_free(a: ptr) void {
    if a[ARR_DATA] != 0 { free((ptr)a[ARR_DATA]); }
    free(a);
}
fn array_contains(a: ptr, v: int) int {
    var i: int = 0;
    while i < a[ARR_LEN] {
        if array_get(a, i) == v { return 1; }
        i = i + 1;
    }
    return 0;
}
fn array_sum(a: ptr) int {
    var s: int = 0;
    var i: int = 0;
    while i < a[ARR_LEN] {
        s = s + array_get(a, i);
        i = i + 1;
    }
    return s;
}
fn array_max(a: ptr) int {
    if a[ARR_LEN] == 0 { return 0; }
    var m: int = array_get(a, 0);
    var i: int = 1;
    while i < a[ARR_LEN] {
        var v: int = array_get(a, i);
        if v > m { m = v; }
        i = i + 1;
    }
    return m;
}
fn array_min(a: ptr) int {
    if a[ARR_LEN] == 0 { return 0; }
    var m: int = array_get(a, 0);
    var i: int = 1;
    while i < a[ARR_LEN] {
        var v: int = array_get(a, i);
        if v < m { m = v; }
        i = i + 1;
    }
    return m;
}
// simple in-place bubble sort
fn array_sort(a: ptr) void {
    var n: int = a[ARR_LEN];
    var i: int = 0;
    while i < n {
        var j: int = 0;
        while j < n - 1 - i {
            if array_get(a, j) > array_get(a, j + 1) {
                var t: int = array_get(a, j);
                array_set(a, j, array_get(a, j + 1));
                array_set(a, j + 1, t);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
fn array_reverse(a: ptr) void {
    var i: int = 0;
    var j: int = a[ARR_LEN] - 1;
    while i < j {
        var t: int = array_get(a, i);
        array_set(a, i, array_get(a, j));
        array_set(a, j, t);
        i = i + 1;
        j = j - 1;
    }
}
// ============================================================================
// WALL STANDARD LIBRARY: lib/convert.wa  -- number <-> string conversion
// ----------------------------------------------------------------------------
// Converts between 64-bit integers and their decimal string representations,
// and related small parsing/formatting helpers. All returned strings are
// freshly allocated with malloc.
//
//     import "lib/convert.wa";
// ============================================================================

// ---------------- libc -------------------------------------------------------
extern fn malloc(size: int) ptr;
extern fn free(p: ptr) void;
extern fn strlen(s: str) int;
extern fn memcpy(dst: ptr, src: ptr, n: int) ptr;
extern fn getbyte(p: ptr) int;
extern fn setbyte(p: ptr, v: int) void;
extern fn snprintf(buf: ptr, n: int, fmt: str, ...) int;

// ---------------- int -> decimal string (allocates) ---------------------------
fn itoa(v: int) str {
    // 24 bytes is enough for any i64 in decimal (max 19 digits + sign + NUL).
    var buf: ptr = (ptr)malloc(24);
    var n: int = snprintf(buf, 24, "%lld", v);
    var p: ptr = (ptr)malloc(n + 1);
    memcpy(p, buf, n + 1);
    free(buf);
    return (str)p;
}

// ---------------- string -> int ----------------------------------------------
fn atoi(s: str) int {
    var n: int = strlen(s);
    var i: int = 0;
    var neg: int = 0;
    if i < n && getbyte(s + i) == 45 { neg = 1; i = i + 1; }
    var val: int = 0;
    while i < n {
        var c: int = getbyte(s + i);
        if c < 48 || c > 57 { break; }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    if neg == 1 { val = 0 - val; }
    return val;
}
fn parseUnsigned(s: str) int {
    var n: int = strlen(s);
    var val: int = 0;
    var i: int = 0;
    while i < n {
        var c: int = getbyte(s + i);
        if c < 48 || c > 57 { break; }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    return val;
}

// ---------------- int -> hex string (allocates) -------------------------------
fn itohex(v: int) str {
    // 2 chars per byte, plus prefix; 20 bytes covers any i64.
    var buf: ptr = (ptr)malloc(24);
    var n: int = snprintf(buf, 24, "0x%llx", v);
    var p: ptr = (ptr)malloc(n + 1);
    memcpy(p, buf, n + 1);
    free(buf);
    return (str)p;
}
fn itobin(v: int) str {
    // build binary string (up to 64 bits) MSB..LSB
    var p: ptr = (ptr)malloc(66);
    var i: int = 63;
    var n: int = 0;
    while i >= 0 {
        var bit: int = 0;
        var shift: int = 1;
        var k: int = 0;
        while k < i { shift = shift * 2; k = k + 1; }
        if (v & shift) != 0 { bit = 1; }
        setbyte(p + n, 48 + bit);
        n = n + 1;
        i = i - 1;
    }
    // strip leading zeros
    var s: int = 0;
    while s < n - 1 && getbyte(p + s) == 48 { s = s + 1; }
    var olen: int = n - s;
    var out: ptr = (ptr)malloc(olen + 1);
    memcpy(out, p + s, olen);
    setbyte(out + olen, 0);
    free(p);
    return (str)out;
}

// ---------------- float formatting -------------------------------------------
fn ftos(v: float) str {
    var buf: ptr = (ptr)malloc(64);
    var n: int = snprintf(buf, 64, "%f", v);
    var p: ptr = (ptr)malloc(n + 1);
    memcpy(p, buf, n + 1);
    free(buf);
    return (str)p;
}
// ============================================================================
// WALL STANDARD LIBRARY: lib/io.wa  -- input/output helpers
// ----------------------------------------------------------------------------
// Simple output helpers built on printf, and a few file utilities.
//
//     import "lib/io.wa";
// ============================================================================

// ---------------- libc -------------------------------------------------------
extern fn printf(fmt: str, ...) int;
extern fn fopen(path: str, mode: str) ptr;
extern fn fclose(f: ptr) int;
extern fn fread(buf: ptr, size: int, count: int, f: ptr) int;
extern fn fwrite(buf: ptr, size: int, count: int, f: ptr) int;
extern fn exit(code: int) void;

// ---------------- plain prints -----------------------------------------------
fn print(s: str) void {
    printf("%s", s);
}
fn println(s: str) void {
    printf("%s\n", s);
}
fn printInt(v: int) void {
    printf("%lld\n", v);
}
fn printStrInt(label: str, v: int) void {
    printf("%s %lld\n", label, v);
}
fn newline() void {
    printf("\n");
}

// ---------------- formatted helpers ------------------------------------------
fn sayInt(v: int) void {
    printf("int: %lld\n", v);
}
fn sayStr(s: str) void {
    printf("str: %s\n", s);
}
fn sayBool(b: int) void {
    if b != 0 { printf("bool: true\n"); }
    else { printf("bool: false\n"); }
}

// ---------------- file utilities ---------------------------------------------
fn fileSize(path: str) int {
    var f: ptr = fopen(path, "rb");
    if f == 0 { return -1; }
    var buf: ptr = (ptr)malloc(4096);
    var total: int = 0;
    while 1 == 1 {
        var n: int = fread(buf, 1, 4096, f);
        if n <= 0 { break; }
        total = total + n;
    }
    fclose(f);
    free(buf);
    return total;
}
fn fileExists(path: str) int {
    var f: ptr = fopen(path, "rb");
    if f == 0 { return 0; }
    fclose(f);
    return 1;
}
// ============================================================================
// WALL STANDARD LIBRARY: lib/list.wa  -- singly-linked list of ints
// ----------------------------------------------------------------------------
// A classic singly-linked list. Nodes are 16 bytes: next(0) value(8).
//
//     import "lib/list.wa";
//
// List operations are O(n); for frequent random access prefer lib/array.wa.
// ============================================================================

// ---------------- libc -------------------------------------------------------
extern fn malloc(size: int) ptr;
extern fn free(p: ptr) void;

// node offsets
let NODE_NEXT = 0;
let NODE_VAL = 8;

fn list_new() ptr {
    return 0; // empty list is a null head pointer
}
fn node_new(v: int) ptr {
    var n: ptr = (ptr)malloc(16);
    n[NODE_NEXT] = 0;
    n[NODE_VAL] = v;
    return n;
}
fn list_push_front(head: ptr, v: int) ptr {
    var n: ptr = node_new(v);
    n[NODE_NEXT] = (int)head;
    return n;
}
fn list_push_back(head: ptr, v: int) ptr {
    var n: ptr = node_new(v);
    if head == 0 { return n; }
    var cur: ptr = head;
    while (ptr)cur[NODE_NEXT] != 0 { cur = (ptr)cur[NODE_NEXT]; }
    cur[NODE_NEXT] = (int)n;
    return head;
}
fn list_len(head: ptr) int {
    var cnt: int = 0;
    var cur: ptr = head;
    while cur != 0 {
        cnt = cnt + 1;
        cur = (ptr)cur[NODE_NEXT];
    }
    return cnt;
}
fn list_empty(head: ptr) int {
    return head == 0 ? 1 : 0;
}
fn list_get(head: ptr, i: int) int {
    var cur: ptr = head;
    var k: int = 0;
    while cur != 0 {
        if k == i { return cur[NODE_VAL]; }
        k = k + 1;
        cur = (ptr)cur[NODE_NEXT];
    }
    return 0;
}
fn list_contains(head: ptr, v: int) int {
    var cur: ptr = head;
    while cur != 0 {
        if cur[NODE_VAL] == v { return 1; }
        cur = (ptr)cur[NODE_NEXT];
    }
    return 0;
}
fn list_free(head: ptr) void {
    var cur: ptr = head;
    while cur != 0 {
        var nx: ptr = (ptr)cur[NODE_NEXT];
        free(cur);
        cur = nx;
    }
}
fn list_reverse(head: ptr) ptr {
    var prev: ptr = 0;
    var cur: ptr = head;
    while cur != 0 {
        var nx: ptr = (ptr)cur[NODE_NEXT];
        cur[NODE_NEXT] = (int)prev;
        prev = cur;
        cur = nx;
    }
    return prev;
}
fn list_sum(head: ptr) int {
    var s: int = 0;
    var cur: ptr = head;
    while cur != 0 {
        s = s + cur[NODE_VAL];
        cur = (ptr)cur[NODE_NEXT];
    }
    return s;
}
// ============================================================================
// WALL STANDARD LIBRARY: lib/math.wa  -- integer math helpers
// ----------------------------------------------------------------------------
// Pure-Wall integer mathematics. No extern calls beyond libc essentials
// (malloc/free), so this module is fully portable. Import it in any program:
//
//     import "lib/math.wa";
//
// The Wall compiler models every int as a 64-bit signed integer.
// ============================================================================

// ---------------- libc -------------------------------------------------------
extern fn malloc(size: int) ptr;
extern fn free(p: ptr) void;

// ---------------- absolute value --------------------------------------------
fn abs(v: int) int {
    if v < 0 { return 0 - v; }
    return v;
}

// ---------------- min / max --------------------------------------------------
fn min(a: int, b: int) int {
    if a < b { return a; }
    return b;
}
fn max(a: int, b: int) int {
    if a > b { return a; }
    return b;
}
fn clamp(v: int, lo: int, hi: int) int {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

// ---------------- gcd / lcm (Euclid's algorithm) -----------------------------
fn gcd(a: int, b: int) int {
    var x: int = abs(a);
    var y: int = abs(b);
    while y != 0 {
        var t: int = x % y;
        x = y;
        y = t;
    }
    return x;
}
fn lcm(a: int, b: int) int {
    var g: int = gcd(a, b);
    if g == 0 { return 0; }
    return abs(a / g * b);
}

// ---------------- powers -----------------------------------------------------
fn pow(base: int, exp: int) int {
    var result: int = 1;
    var e: int = exp;
    while e > 0 {
        result = result * base;
        e = e - 1;
    }
    return result;
}
fn isPow2(v: int) int {
    if v <= 0 { return 0; }
    return (v & (v - 1)) == 0 ? 1 : 0;
}

// ---------------- primality / factoring --------------------------------------
fn isPrime(n: int) int {
    if n < 2 { return 0; }
    var i: int = 2;
    while i * i <= n {
        if n % i == 0 { return 0; }
        i = i + 1;
    }
    return 1;
}
fn nextPrime(n: int) int {
    var c: int = n;
    while isPrime(c) == 0 { c = c + 1; }
    return c;
}
fn countPrimes(limit: int) int {
    var cnt: int = 0;
    var i: int = 2;
    while i <= limit {
        if isPrime(i) != 0 { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}
fn sumDigits(n: int) int {
    var v: int = abs(n);
    var s: int = 0;
    while v > 0 {
        s = s + (v % 10);
        v = v / 10;
    }
    return s;
}
fn numDigits(n: int) int {
    if n == 0 { return 1; }
    var v: int = abs(n);
    var d: int = 0;
    while v > 0 {
        v = v / 10;
        d = d + 1;
    }
    return d;
}

// ---------------- sequences --------------------------------------------------
fn factorial(n: int) int {
    if n <= 1 { return 1; }
    var r: int = 1;
    var i: int = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}
fn fibonacci(n: int) int {
    if n <= 1 { return n; }
    var a: int = 0;
    var b: int = 1;
    var i: int = 2;
    while i <= n {
        var t: int = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}
fn triangular(n: int) int {
    return n * (n + 1) / 2;
}

// ---------------- misc integer utilities -------------------------------------
fn even(n: int) int {
    return n % 2 == 0 ? 1 : 0;
}
fn odd(n: int) int {
    return n % 2 == 0 ? 0 : 1;
}
fn sign(v: int) int {
    if v > 0 { return 1; }
    if v < 0 { return -1; }
    return 0;
}
fn rangeSum(from: int, to: int) int {
    var s: int = 0;
    var i: int = from;
    while i <= to {
        s = s + i;
        i = i + 1;
    }
    return s;
}
fn max3(a: int, b: int, c: int) int {
    var m: int = max(a, b);
    m = max(m, c);
    return m;
}
fn min3(a: int, b: int, c: int) int {
    var m: int = min(a, b);
    m = min(m, c);
    return m;
}
// ============================================================================
// WALL STANDARD LIBRARY: lib/string.wa  -- string helpers
// ----------------------------------------------------------------------------
// Byte-string utilities on top of the Wall `str` type (a NUL-terminated char
// array, i.e. i8*). Functions that return strings allocate fresh storage with
// malloc; the caller is responsible for free().
//
//     import "lib/string.wa";
// ============================================================================

// ---------------- libc -------------------------------------------------------
extern fn malloc(size: int) ptr;
extern fn free(p: ptr) void;
extern fn strlen(s: str) int;
extern fn strcmp(a: str, b: str) int;
extern fn memcpy(dst: ptr, src: ptr, n: int) ptr;
extern fn memset(p: ptr, v: int, n: int) ptr;
extern fn getbyte(p: ptr) int;
extern fn setbyte(p: ptr, v: int) void;

// ---------------- length -----------------------------------------------------
fn slen(s: str) int {
    return strlen(s);
}
fn isEmpty(s: str) int {
    return strlen(s) == 0 ? 1 : 0;
}

// ---------------- equality / comparison -------------------------------------
fn seq(a: str, b: str) int {
    return strcmp(a, b) == 0 ? 1 : 0;
}
fn sneq(a: str, b: str) int {
    return strcmp(a, b) == 0 ? 0 : 1;
}

// ---------------- allocation helpers -----------------------------------------
// Duplicate a string into fresh heap storage.
fn strdup(s: str) str {
    var n: int = strlen(s);
    var p: ptr = (ptr)malloc(n + 1);
    memcpy(p, s, n);
    setbyte(p + n, 0);
    return (str)p;
}
// Create a fresh string of the given length, zero-filled.
fn stralloc(n: int) str {
    var p: ptr = (ptr)malloc(n + 1);
    memset(p, 0, n + 1);
    return (str)p;
}

// ---------------- concatenation (allocates a new string) ---------------------
fn concat(a: str, b: str) str {
    var la: int = strlen(a);
    var lb: int = strlen(b);
    var p: ptr = (ptr)malloc(la + lb + 1);
    memcpy(p, a, la);
    memcpy(p + la, b, lb);
    setbyte(p + la + lb, 0);
    return (str)p;
}
fn concat3(a: str, b: str, c: str) str {
    var la: int = strlen(a);
    var lb: int = strlen(b);
    var lc: int = strlen(c);
    var p: ptr = (ptr)malloc(la + lb + lc + 1);
    memcpy(p, a, la);
    memcpy(p + la, b, lb);
    memcpy(p + la + lb, c, lc);
    setbyte(p + la + lb + lc, 0);
    return (str)p;
}

// ---------------- character access -------------------------------------------
fn charAt(s: str, i: int) int {
    if i < 0 || i >= strlen(s) { return 0; }
    return getbyte(s + i);
}
fn firstChar(s: str) int {
    return getbyte(s);
}
fn lastChar(s: str) int {
    var n: int = strlen(s);
    if n == 0 { return 0; }
    var idx: int = n - 1;
    return getbyte(s + idx);
}

// ---------------- searching --------------------------------------------------
fn indexOf(hay: str, needle: int) int {
    var n: int = strlen(hay);
    var i: int = 0;
    while i < n {
        if getbyte(hay + i) == needle { return i; }
        i = i + 1;
    }
    return -1;
}
fn countChar(s: str, ch: int) int {
    var n: int = strlen(s);
    var cnt: int = 0;
    var i: int = 0;
    while i < n {
        if getbyte(s + i) == ch { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}
fn hasChar(s: str, ch: int) int {
    return indexOf(s, ch) >= 0 ? 1 : 0;
}

// ---------------- substring (allocates) ---------------------------------------
fn substr(s: str, start: int, len: int) str {
    var n: int = strlen(s);
    if start < 0 { start = 0; }
    if start > n { start = n; }
    if len < 0 { len = 0; }
    if start + len > n { len = n - start; }
    var p: ptr = (ptr)malloc(len + 1);
    memcpy(p, s + start, len);
    setbyte(p + len, 0);
    return (str)p;
}
fn left(s: str, len: int) str {
    return substr(s, 0, len);
}
fn right(s: str, len: int) str {
    var n: int = strlen(s);
    if len > n { len = n; }
    return substr(s, n - len, len);
}

// ---------------- case conversion (allocates) ---------------------------------
fn toUpper(s: str) str {
    var n: int = strlen(s);
    var p: ptr = (ptr)malloc(n + 1);
    var i: int = 0;
    while i < n {
        var c: int = getbyte(s + i);
        if c >= 97 && c <= 122 { c = c - 32; }
        setbyte(p + i, c);
        i = i + 1;
    }
    setbyte(p + n, 0);
    return (str)p;
}
fn toLower(s: str) str {
    var n: int = strlen(s);
    var p: ptr = (ptr)malloc(n + 1);
    var i: int = 0;
    while i < n {
        var c: int = getbyte(s + i);
        if c >= 65 && c <= 90 { c = c + 32; }
        setbyte(p + i, c);
        i = i + 1;
    }
    setbyte(p + n, 0);
    return (str)p;
}

// ---------------- predicates ------------------------------------------------
fn isDigit(c: int) int {
    if c >= 48 && c <= 57 { return 1; }
    return 0;
}
fn isAlpha(c: int) int {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { return 1; }
    return 0;
}
fn isSpace(c: int) int {
    if c == 32 || c == 9 || c == 10 || c == 13 { return 1; }
    return 0;
}
fn isUpper(c: int) int {
    if c >= 65 && c <= 90 { return 1; }
    return 0;
}
fn isLower(c: int) int {
    if c >= 97 && c <= 122 { return 1; }
    return 0;
}
fn isAllDigits(s: str) int {
    var n: int = strlen(s);
    if n == 0 { return 0; }
    var i: int = 0;
    while i < n {
        if isDigit(getbyte(s + i)) == 0 { return 0; }
        i = i + 1;
    }
    return 1;
}
// ============================================================================
// WALL DRIVER MODULE: contract.wa  -- shared declarations & state
// ----------------------------------------------------------------------------
// Because the Wall compiler compiles a single translation unit, all driver
// modules are concatenated into one file before compilation. This header
// module MUST come first: it declares every shared global variable and every
// cross-module function as `extern`, so that any function body that follows
// can reference state and call helpers that are defined in a later module.
//
// The compiler does not support `extern var`, so shared globals are defined
// (not merely declared) right here, and modules refer to them directly by
// name. Function definitions in later modules override the extern
// declarations here (marked defined), so no duplicate declarations leak out.
// ============================================================================

// ---------------- libc --------------------------------------------------------
// NOTE: the common libc functions (malloc/free/realloc/memcpy/fopen/fread/
// fwrite/fclose/strlen/strcmp/printf/fprintf/snprintf/exit/getbyte/setbyte)
// are already declared at the top of the compiler module (src/wall.wa), which
// is concatenated into the same single translation unit. Re-declaring them
// here would produce duplicate extern declarations. Only the functions the
// driver needs that the compiler module does not declare are listed here.
extern fn system(cmd: str) int;
extern fn access(path: str, mode: int) int;

// ---------------- compiler engine ---------------------------------------------
// NOTE: wall_compile() is defined by the compiler module (src/wall.wa), which
// is concatenated into the same single translation unit BEFORE this header.
// It therefore does not need (and must not have) an extern declaration here;
// the compiler emits one definition of the function for the whole TU.
extern fn initPaths() void;

// ---------------- string.wa ---------------------------------------------------
extern fn bInit() void;
extern fn bReserve(need: int) void;
extern fn bCat(s: str) void;
extern fn bCatN(s: ptr, n: int) void;
extern fn bCatI(v: int) void;
extern fn bCatC(c: int) void;

// ---------------- diag.wa -----------------------------------------------------
extern fn ereset() str;
extern fn ered() str;
extern fn eryel() str;
extern fn ecyan() str;
extern fn egrn() str;
extern fn ebold() str;
extern fn emag() str;
extern fn eblue() str;
extern fn edim() str;
extern fn eerr(msg: str) void;
extern fn ewarn(msg: str) void;
extern fn enote(msg: str) void;
extern fn einfo(msg: str) void;
extern fn eok(msg: str) void;
extern fn d_fileExists(path: str) int;
extern fn run() int;

// ---------------- flags.wa ----------------------------------------------------
extern fn initFlags() void;
extern fn loadFlagFile(path: str) int;
extern fn matchFlag(a: str) int;
extern fn addFlag(pat: str, role: int, desc: str) void;
extern fn roleName(r: ptr) int;
extern fn optArgFor(a: str) str;
extern fn llcArgFor(a: str) str;
extern fn linkArgFor(a: str) str;
extern fn mllArgFor(a: str) str;
extern fn appendOptArg(a: str) void;
extern fn appendLlcArg(a: str) void;
extern fn appendLinkArg(a: str) void;
extern fn appendMllArg(a: str) void;

// ---------------- pipeline.wa -------------------------------------------------
extern fn buildOptCmd() void;
extern fn buildLlvmObjCmd() void;
extern fn buildLlvmAsmCmd() void;
extern fn buildLinkCmd() void;
extern fn compileAndLink() int;

// ---------------- preproc.wa --------------------------------------------------
extern fn preprocess(merged: str) int;
extern fn arg_at(argv: ptr, i: int) str;

// ---------------- libembed.wa -------------------------------------------------
extern fn b64decode(b64: ptr) ptr;
extern fn liblookup(name: ptr) ptr;
extern fn libbasename(p: ptr) void;
extern fn libfill() void;

// ---------------- help.wa -----------------------------------------------------
extern fn printHelp() void;
extern fn printVersion() void;

// ---------------- shared state (defined here, used everywhere) ----------------
// paths.wa
var TMPD: ptr = 0;
var SYSROOT: ptr = 0;
var DYNLINK: ptr = 0;
// string.wa
var bbuf: ptr = 0;
var blen: int = 0;
var bcap: int = 0;
// diag.wa
var color: int = 1;
var nowarn: int = 0;
var werror: int = 0;
// flags.wa
var optlevel: int = 2;
var verbose: int = 0;
var emit_obj: int = 0;
var emit_asm: int = 0;
var emit_ir: int = 0;
var shared: int = 0;
var pic: int = 0;
var pie: int = 1;
var do_link: int = 1;
var save_temps: int = 0;
var debug: int = 0;
var mode: int = 0;
var src: ptr = 0;
var output: ptr = 0;
var flags: ptr = 0;
// flags.wa extra-argument accumulators (NULL-terminated strings appended to
// the respective LLVM tool command line when non-empty)
var optargs: ptr = 0;    // extra args for `opt`
var llcargs: ptr = 0;    // extra args for `llc`
var linkargs: ptr = 0;   // extra args for `ld.lld`
var mllargs: ptr = 0;    // extra `-mllvm` args for both opt and llc
var targetTriple: ptr = 0; // -target <triple>: cross-codegen triple for llc
// ============================================================================
// WALL DRIVER MODULE: paths.wa  -- environment & toolchain path resolution
// ----------------------------------------------------------------------------
// Centralises every filesystem path the Wall toolchain needs at runtime.
// All paths are DERIVED FROM THE SYSTEM at runtime (via getenv), so the
// toolchain is portable and contains no hard-coded installation locations.
//
//   * TMPD    -- writable scratch directory for intermediate artifacts.
//                Prefers $TMPDIR, otherwise $HOME/.cache/tmp.
//   * SYSROOT -- the target sysroot (root of the C runtime libraries used
//                when linking). Prefers $PREFIX, otherwise $HOME.
//   * DYNLINK -- absolute path to the dynamic linker for PIE executables.
//                Detected from /proc/self/exe's interpreter at runtime.
//
// Values are lazily initialised on first use via initPaths() and can be
// overridden by assigning the corresponding global.
// ============================================================================

// ---------------- libc -------------------------------------------------------
// NOTE: strlen/memcpy/malloc/free/getbyte/bInit/bCat are declared in
// contract.wa (the first module of the merged translation unit), so only the
// functions unique to this module need declaring here.
extern fn getenv(name: str) ptr;

// ---------------- path globals (defined in contract.wa) ----------------------

// ---------------- small helpers ----------------------------------------------
// getenvStr: return the value of an env var, or an empty string if unset.
fn getenvStr(name: str) ptr {
    var p: ptr = getenv(name);
    if p == 0 { return ""; }
    return p;
}

// copyStr: duplicate a NUL-terminated string into fresh heap storage.
fn copyStr(s: ptr) ptr {
    var n: int = strlen(s);
    var p: ptr = (ptr)malloc(n + 1);
    memcpy(p, s, n + 1);
    return p;
}

// initPaths: populate any path global that is still unset, deriving each
// value from the environment rather than from hard-coded installation paths.
fn initPaths() void {
    // scratch directory: $TMPDIR, else $HOME/.cache/tmp
    var t: ptr = getenvStr("TMPDIR");
    if strlen(t) > 0 {
        var len: int = strlen(t);
        var p: ptr = (ptr)malloc(len + 2);
        memcpy(p, t, len);
        var last: int = len - 1;
        if getbyte(t + last) != 47 { setbyte(p + len, 47); len = len + 1; }
        setbyte(p + len, 0);
        TMPD = p;
    } else {
        var h: ptr = getenvStr("HOME");
        if strlen(h) > 0 {
            bInit(); bCat(h); bCat("/.cache/tmp/");
            TMPD = copyStr(bbuf);
        } else {
            TMPD = "./";
        }
    }

    // sysroot: $PREFIX (a common convention), else $HOME
    var pr: ptr = getenvStr("PREFIX");
    if strlen(pr) > 0 { SYSROOT = copyStr(pr); }
    else {
        var h2: ptr = getenvStr("HOME");
        if strlen(h2) > 0 { SYSROOT = copyStr(h2); }
        else { SYSROOT = "/"; }
    }

    // dynamic linker: $WALL_LINKER override, else best-effort defaults.
    var dl: ptr = getenvStr("WALL_LINKER");
    if strlen(dl) > 0 { DYNLINK = copyStr(dl); }
    else { DYNLINK = "/system/bin/linker64"; }
}
// ============================================================================
// WALL DRIVER MODULE: string.wa  -- growable string builder
// ----------------------------------------------------------------------------
// The Wall language has no string '+' operator, so building command lines,
// paths, and diagnostic messages is done with an explicit builder.
//
// This module implements a single global, growable byte buffer:
//
//   * bbuf -- pointer to the backing allocation (capacity bytes)
//   * blen -- current logical length (number of meaningful bytes)
//   * bcap -- total allocated capacity
//
// The buffer is always NUL-terminated at offset [blen], so bbuf can be passed
// directly to C-string functions (system, printf, fopen, ...) as a `str`.
//
// API summary:
//   bInit()      reset the buffer to empty (reuses existing capacity)
//   bReserve(n)  ensure at least n more bytes fit (grows geometrically)
//   bCat(s)      append a NUL-terminated C string
//   bCatN(s,n)   append n raw bytes (may contain embedded NULs)
//   bCatI(v)     append a 64-bit integer, formatted in decimal
//   bCatC(c)     append a single byte
// ============================================================================

// ----------------------------------------------------------------------------
// NOTE: the buffer state globals (bbuf/blen/bcap) are defined in contract.wa.
//
// bInit: reset the logical length to zero, keeping any existing allocation.
// Also writes a terminating NUL so the buffer is a valid empty C string.
// ----------------------------------------------------------------------------
fn bInit() void {
    if bbuf == 0 { bcap = 16384; bbuf = (ptr)malloc(bcap); }
    blen = 0;
    setbyte(bbuf, 0);
}

// ----------------------------------------------------------------------------
// bReserve: make sure at least `need` additional bytes can be appended before
// the current end. Grows the backing allocation geometrically (doubling) to
// keep amortised cost linear, then reallocates and updates the global pointer.
// ----------------------------------------------------------------------------
fn bReserve(need: int) void {
    if blen + need + 1 > bcap {
        while blen + need + 1 > bcap { bcap = bcap * 2; }
        var nb: ptr = (ptr)realloc(bbuf, bcap);
        bbuf = nb;
    }
}

// ----------------------------------------------------------------------------
// bCat: append a complete NUL-terminated string (via strlen + memcpy).
// ----------------------------------------------------------------------------
fn bCat(s: str) void {
    var n: int = strlen(s);
    bReserve(n);
    memcpy(bbuf + blen, s, n);
    blen = blen + n;
    setbyte(bbuf + blen, 0);
}

// ----------------------------------------------------------------------------
// bCatN: append exactly n bytes from a pointer (no NUL required in source).
// ----------------------------------------------------------------------------
fn bCatN(s: ptr, n: int) void {
    bReserve(n);
    memcpy(bbuf + blen, s, n);
    blen = blen + n;
    setbyte(bbuf + blen, 0);
}

// ----------------------------------------------------------------------------
// bCatI: append a signed 64-bit integer in decimal form (via snprintf).
// ----------------------------------------------------------------------------
fn bCatI(v: int) void {
    var tmp: ptr = (ptr)malloc(64);
    snprintf(tmp, 64, "%lld", v);
    bCat(tmp);
    free(tmp);
}

// ----------------------------------------------------------------------------
// bCatC: append a single raw byte.
// ----------------------------------------------------------------------------
fn bCatC(c: int) void {
    bReserve(1);
    setbyte(bbuf + blen, c);
    blen = blen + 1;
    setbyte(bbuf + blen, 0);
}

// ----------------------------------------------------------------------------
// startsWith: return 1 if the NUL-terminated string `s` begins with `prefix`,
// else 0. Used by the cross-target logic in pipeline.wa.
// ----------------------------------------------------------------------------
fn startsWith(s: str, prefix: str) int {
    var i: int = 0;
    while getbyte((ptr)prefix + i) != 0 {
        if getbyte((ptr)s + i) == 0 { return 0; }
        if getbyte((ptr)s + i) != getbyte((ptr)prefix + i) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn ereset() str { if color == 1 { return "\033[0m"; } return ""; }
fn ered()   str { if color == 1 { return "\033[1;31m"; } return ""; }
fn eryel()  str { if color == 1 { return "\033[1;33m"; } return ""; }
fn ecyan()  str { if color == 1 { return "\033[1;36m"; } return ""; }
fn egrn()   str { if color == 1 { return "\033[32m"; } return ""; }
fn ebold()  str { if color == 1 { return "\033[1m"; } return ""; }
fn emag()   str { if color == 1 { return "\033[1;35m"; } return ""; }
fn eblue()  str { if color == 1 { return "\033[1;34m"; } return ""; }
fn edim()   str { if color == 1 { return "\033[2m"; } return ""; }

// Professional log format: a single yellow tool label followed by a colored
// severity marker and the message. Colors only apply when enabled; when the
// output is not a terminal the escapes are omitted entirely.
//   wall: e: error message     (marker red)
//   wall: w: warning message   (marker purple)
//   wall: n: note message      (marker cyan)
//   wall: i: info message      (marker yellow, verbose-only)
//   wall: ok: message          (marker green, verbose-only)

fn eerr(msg: str) void {
    printf("%swall:%s %se:%s %s\n", eryel(), ereset(), ered(), ereset(), msg);
}

fn ewarn(msg: str) void {
    if nowarn == 1 { return; }
    printf("%swall:%s %sw:%s %s\n", eryel(), ereset(), emag(), ereset(), msg);
    if werror == 1 { exit(1); }
}

fn enote(msg: str) void {
    printf("%swall:%s %sn:%s %s\n", eryel(), ereset(), ecyan(), ereset(), msg);
}

fn einfo(msg: str) void {
    if verbose != 1 { return; }
    printf("%swall:%s %si:%s %s\n", eryel(), ereset(), eryel(), ereset(), msg);
}

fn eok(msg: str) void {
    if verbose != 1 { return; }
    printf("%swall:%s %sok:%s %s\n", eryel(), ereset(), egrn(), ereset(), msg);
}

fn d_fileExists(path: str) int {
    if access(path, 0) == 0 { return 1; }
    return 0;
}

fn run() int {
    if verbose == 1 {
        printf("%swall:%s %srun:%s %s\n", eryel(), ereset(), emag(), ereset(), bbuf);
    }
    return system(bbuf);
}
// ============================================================================
// WALL DRIVER MODULE: flags.wa  -- data-driven option table & parsing
// ----------------------------------------------------------------------------
// Wall accepts a large, user-extensible set of command-line options. Rather
// than a hard-coded if/else chain, options are described by a table of
// flag-definition records. Each record maps a flag name (with optional '*'
// wildcard) to a ROLE (an action id) and a human description.
//
// Two sources feed the table:
//   1. A built-in table (below) with ~100 common flags.
//   2. An optional user config file (conf/wall.flags) that can add more.
//
// Roles are integer codes so the main driver can dispatch on them cheaply.
// Some roles consume a following argument (e.g. -o FILE, -L DIR, -fsanitize=X).
// Wildcard roles match the flag against the glob pattern of the definition.
// ============================================================================

// ---------------- role codes -------------------------------------------------
let R_NONE     = 0;   // recognized but no action
let R_HELP     = 1;   // print help
let R_VERSION  = 2;   // print version
let R_VERBOSE  = 3;   // -v: show commands
let R_OPTLVL0  = 4;   // -O0
let R_OPTLVL1  = 5;   // -O1
let R_OPTLVL2  = 6;   // -O2
let R_OPTLVL3  = 7;   // -O3
let R_OPTLVLS  = 8;   // -Os (size)
let R_OPTLVLZ  = 9;   // -Oz (smallest)
let R_OBJ      = 10;  // -c: emit object, no link
let R_ASM      = 11;  // -S: emit assembly
let R_IR       = 12;  // -emit-llvm: emit IR
let R_SHARED   = 13;  // -shared: build .so
let R_PIC      = 14;  // -fPIC/-fpic
let R_NO_PIE   = 15;  // -no-pie
let R_PIE      = 16;  // -pie
let R_NOLINK   = 17;  // -nostdlib: do not link crt/libc
let R_NOWARN   = 18;  // -w
let R_WERROR   = 19;  // -Werror
let R_WARNALL  = 20;  // -Wall
let R_COLOR    = 21;  // -fcolor
let R_NOCOLOR  = 22;  // -fno-color
let R_OUT      = 23;  // -o <file>: consumes next arg
let R_LINKLIB  = 24;  // -l<lib>
let R_LIBDIR   = 25;  // -L<dir>
let R_LINKFLAG = 26;  // -Wl,<flag>
let R_SANITIZE = 27;  // -fsanitize=<name>
let R_SAVETMP  = 28;  // -save-temps
let R_DEBUG    = 29;  // -g: emit debug info
let R_OPTARG   = 30;  // -mllvm <arg>: pass to opt/llc
let R_DEFINE   = 31;  // -D<name>: preprocessor define
let R_INCLUDE  = 32;  // -I<dir>: include dir
let R_STATIC   = 33;  // -static
let R_OPENMP   = 34;  // -fopenmp
let R_FASTMATH = 35;  // -ffast-math
let R_NOCOLORW = 36;  // internal alias
let R_RUN      = 37;  // run mode
let R_BUILD    = 38;  // build mode (default)
let R_LTO      = 39;  // -flto
let R_PTHREAD  = 40;  // -pthread
let R_UNSAFE   = 41;  // -fno-omit-frame-pointer (debug helper)
let R_VERBOSEX = 42;  // -v combined alias
// ---- LLVM pass-through options -------------------------------------------
// Each of these appends a real LLVM/backend argument to the corresponding
// tool's command line via the optargs/llcargs/linkargs/mllargs accumulators.
let R_OPTARGV  = 43;  // opt pass-through: append literal arg to `opt`
let R_LLCARGV  = 44;  // llc pass-through: append literal arg to `llc`
let R_LINKARGV = 45;  // link pass-through: append literal arg to `ld.lld`
let R_MLLARGV  = 46;  // -mllvm pass-through: append literal arg to both
let R_TARGET   = 47;  // -target <triple>: cross-compile codegen target
let R_PRINTTAR = 48;  // --print-targets: list supported codegen targets

// ---------------- option state ------------------------------------------------
// NOTE: all option-state globals (optlevel, verbose, mode, src, output, ...)
// and the `flags` table head are defined in contract.wa.

// ---------------- flag-definition records --------------------------------------
// A flag node: next(0) pattern(8) role(16) desc(24)  = 32 bytes
let FL_NEXT = 0; let FL_PAT = 8; let FL_ROLE = 16; let FL_DESC = 24;

fn addFlag(pat: str, role: int, desc: str) void {
    var n: ptr = (ptr)malloc(32);
    n[FL_PAT] = (int)pat;
    n[FL_ROLE] = role;
    n[FL_DESC] = (int)desc;
    n[FL_NEXT] = (int)flags;
    flags = n;
}

// ----------------------------------------------------------------------------
// copyStrRaw: duplicate a builder buffer into fresh heap storage.
fn copyStrRaw(s: ptr) ptr {
    var n: int = strlen(s);
    var p: ptr = (ptr)malloc(n + 1);
    memcpy(p, s, n + 1);
    return p;
}

// ----------------------------------------------------------------------------
// appendArg: append a literal argument (with a leading space) to a tool's
// extra-argument accumulator. accum is a `ptr*`; pass &accum address semantics
// by using a helper per accumulator. Keeps a plain NULL-terminated string.
// ----------------------------------------------------------------------------
fn appendOptArg(a: str) void { bInit(); if optargs != 0 { bCat(optargs); } bCat(" "); bCat(a); optargs = copyStrRaw(bbuf); }
fn appendLlcArg(a: str) void { bInit(); if llcargs != 0 { bCat(llcargs); } bCat(" "); bCat(a); llcargs = copyStrRaw(bbuf); }
fn appendLinkArg(a: str) void { bInit(); if linkargs != 0 { bCat(linkargs); } bCat(" "); bCat(a); linkargs = copyStrRaw(bbuf); }
fn appendMllArg(a: str) void {
    bInit(); if mllargs != 0 { bCat(mllargs); } bCat(" "); bCat(a); mllargs = copyStrRaw(bbuf);
    bInit(); if llcargs != 0 { bCat(llcargs); } bCat(" "); bCat(a); llcargs = copyStrRaw(bbuf);
}

// ----------------------------------------------------------------------------
// initFlags: register the built-in flag table. Every flag has a documented
// role and a short description (used by --help).
// ----------------------------------------------------------------------------
fn initFlags() void {
    // informational
    addFlag("--help", R_HELP, "print this help and exit");
    addFlag("-h", R_HELP, "alias for --help");
    addFlag("--version", R_VERSION, "print version information and exit");
    // optimization levels
    addFlag("-O0", R_OPTLVL0, "disable optimizations");
    addFlag("-O1", R_OPTLVL1, "optimize for speed (moderate)");
    addFlag("-O2", R_OPTLVL2, "optimize for speed (default)");
    addFlag("-O3", R_OPTLVL3, "optimize aggressively");
    addFlag("-Os", R_OPTLVLS, "optimize for size");
    addFlag("-Oz", R_OPTLVLZ, "optimize for minimum size");
    addFlag("-O", R_OPTLVL2, "alias for -O2");
    // output control
    addFlag("-o", R_OUT, "write output to <file>");
    addFlag("-c", R_OBJ, "compile to object only (no link)");
    addFlag("--emit-obj", R_OBJ, "alias for -c");
    addFlag("-S", R_ASM, "emit assembly only (no assemble)");
    addFlag("-emit-llvm", R_IR, "emit LLVM IR only");
    addFlag("-save-temps", R_SAVETMP, "keep intermediate files");
    // verbosity / diagnostics
    addFlag("-v", R_VERBOSE, "show commands as they run");
    addFlag("--verbose", R_VERBOSE, "alias for -v");
    addFlag("-w", R_NOWARN, "suppress all warnings");
    addFlag("-Wall", R_WARNALL, "enable all warnings");
    addFlag("-Werror", R_WERROR, "treat warnings as errors");
    addFlag("-fcolor", R_COLOR, "force colored diagnostics");
    addFlag("-fno-color", R_NOCOLOR, "disable colored diagnostics");
    addFlag("-fno-omit-frame-pointer", R_UNSAFE, "keep frame pointer");
    // linking modes
    addFlag("-shared", R_SHARED, "build a shared library (.so)");
    addFlag("-static", R_STATIC, "link statically (best effort)");
    addFlag("-fPIC", R_PIC, "position-independent code");
    addFlag("-fpic", R_PIC, "position-independent code");
    addFlag("-pie", R_PIE, "build a position-independent executable");
    addFlag("-no-pie", R_NO_PIE, "do not build a PIE");
    addFlag("-nostdlib", R_NOLINK, "do not link crt/libc (object only)");
    addFlag("-pthread", R_PTHREAD, "link with pthread support");
    addFlag("-flto", R_LTO, "enable link-time optimization");
    addFlag("-ffast-math", R_FASTMATH, "enable fast-math optimizations");
    addFlag("-fopenmp", R_OPENMP, "enable OpenMP support");
    // link / include options (argument forms handled in driver)
    addFlag("-l", R_LINKLIB, "link against library -l<lib>");
    addFlag("-L", R_LIBDIR, "add library search dir -L<dir>");
    addFlag("-Wl,", R_LINKFLAG, "pass <flag> to the linker -Wl,<flag>");
    addFlag("-I", R_INCLUDE, "add include dir -I<dir>");
    addFlag("-D", R_DEFINE, "define -D<name>");
    addFlag("-fsanitize=", R_SANITIZE, "enable sanitizer -fsanitize=<name>");
    addFlag("-g", R_DEBUG, "generate debug information");
    addFlag("-mllvm", R_OPTARG, "pass <arg> to the LLVM backend");
    // modes
    addFlag("run", R_RUN, "compile and run <file>");
    addFlag("build", R_BUILD, "build executable (default)");
    addFlag("obj", R_OBJ, "compile to object only");
    // cross-compilation targets
    addFlag("-target", R_TARGET, "cross-compile: set codegen triple <triple>");
    addFlag("--target", R_TARGET, "alias for -target");
    addFlag("--print-targets", R_PRINTTAR, "list supported codegen targets and exit");
    addFlag("--list-targets", R_PRINTTAR, "alias for --print-targets");
    // aliases for convenience
    addFlag("-v", R_VERBOSEX, "verbose + version alias");

    // ========================================================================
    // LLVM OPTIMIZATION PASS-THROUGH OPTIONS (50+)
    // Each maps to a real LLVM/backend flag appended to the relevant tool.
    // ------------------------------------------------------------------------
    // opt options (passes / optimization pipeline)
    addFlag("-mllvm-opt", R_OPTARGV, "append an arg to `opt`");
    addFlag("-fvectorize", R_OPTARGV, "opt: enable loop vectorizer");
    addFlag("-fno-vectorize", R_OPTARGV, "opt: disable loop vectorizer");
    addFlag("-fslp-vectorize", R_OPTARGV, "opt: enable SLP vectorizer");
    addFlag("-floop-unroll", R_OPTARGV, "opt: enable loop unrolling");
    addFlag("-floop-rotate", R_OPTARGV, "opt: enable loop rotation");
    addFlag("-floop-unroll-and-jam", R_OPTARGV, "opt: unroll and jam loops");
    addFlag("-finline", R_OPTARGV, "opt: enable function inlining");
    addFlag("-fno-inline", R_OPTARGV, "opt: disable function inlining");
    addFlag("-fmerge-functions", R_OPTARGV, "opt: merge identical functions");
    addFlag("-fno-merge-functions", R_OPTARGV, "opt: disable function merging");
    addFlag("-fwhole-program", R_OPTARGV, "opt: enable whole-program analysis");
    addFlag("-fglobalopt", R_OPTARGV, "opt: global optimizer pass");
    addFlag("-fgvn", R_OPTARGV, "opt: global value numbering");
    addFlag("-fmem2reg", R_OPTARGV, "opt: promote memory to registers");
    addFlag("-finstcombine", R_OPTARGV, "opt: instruction combining");
    addFlag("-fsccp", R_OPTARGV, "opt: sparse conditional constant prop");
    addFlag("-fdce", R_OPTARGV, "opt: dead code elimination");
    addFlag("-fsimplifycfg", R_OPTARGV, "opt: simplify the CFG");
    addFlag("-ftailcall", R_OPTARGV, "opt: turn tail calls into jumps");
    addFlag("-fno-tail-call", R_OPTARGV, "opt: disable tail call optimization");
    addFlag("-fsroa", R_OPTARGV, "opt: scalar replacement of aggregates");
    addFlag("-fjump-threading", R_OPTARGV, "opt: jump threading pass");
    addFlag("-flibcall-opt", R_OPTARGV, "opt: libcall optimization");
    addFlag("-ffunc-attrs", R_OPTARGV, "opt: infer function attributes");
    addFlag("-fopt-licm", R_OPTARGV, "opt: loop-invariant code motion");
    addFlag("-fopt-indvars", R_OPTARGV, "opt: canonicalize induction vars");
    addFlag("-fopt-gvn", R_OPTARGV, "opt: GVN pass");
    addFlag("-fopt-loop-idom", R_OPTARGV, "opt: loop idom pass");
    addFlag("-fopt-reassociate", R_OPTARGV, "opt: reassociate expressions");
    addFlag("-fopt-strip-dead", R_OPTARGV, "opt: strip dead prototypes");
    addFlag("-fopt-cleanup", R_OPTARGV, "opt: cleanup CFG");
    addFlag("-fcoroutines", R_OPTARGV, "opt: enable coroutine lowering");
    addFlag("-fno-coroutines", R_OPTARGV, "opt: disable coroutine lowering");

    // llc options (code generation)
    addFlag("-mllvm-llc", R_LLCARGV, "append an arg to `llc`");
    addFlag("-march", R_LLCARGV, "llc: target architecture");
    addFlag("-mtune", R_LLCARGV, "llc: CPU tuning");
    addFlag("-mcpu", R_LLCARGV, "llc: target CPU");
    addFlag("-mattr", R_LLCARGV, "llc: target features");
    addFlag("-mfloat-abi", R_LLCARGV, "llc: float ABI (hard/soft)");
    addFlag("-mregalloc", R_LLCARGV, "llc: register allocator");
    addFlag("-mrelocation-model", R_LLCARGV, "llc: relocation model");
    addFlag("-mcode-model", R_LLCARGV, "llc: code model (small/large)");
    addFlag("-mtls-model", R_LLCARGV, "llc: TLS model");
    addFlag("-fno-plt", R_LLCARGV, "llc: no PLT for calls");
    addFlag("-fomit-frame-pointer", R_LLCARGV, "llc: omit frame pointers");
    addFlag("-mstack-alignment", R_LLCARGV, "llc: stack alignment");
    addFlag("-msoft-float", R_LLCARGV, "llc: software floating point");
    addFlag("-fno-implicit-float", R_LLCARGV, "llc: no implicit FP");

    // ld.lld options
    addFlag("-mllvm-link", R_LINKARGV, "append an arg to `ld.lld`");
    addFlag("-Wl,-zrelax", R_LINKARGV, "link: enable relaxations");
    addFlag("-Wl,-znoexecstack", R_LINKARGV, "link: non-executable stack");
    addFlag("-Wl,-zexecstack", R_LINKARGV, "link: executable stack");
    addFlag("-Wl,-Bsymbolic", R_LINKARGV, "link: bind symbols locally");
    addFlag("-Wl,--icf=all", R_LINKARGV, "link: identical code folding");
    addFlag("-Wl,--no-icf", R_LINKARGV, "link: disable ICF");
    addFlag("-Wl,--gc-sections", R_LINKARGV, "link: garbage-collect sections");
    addFlag("-Wl,--no-gc-sections", R_LINKARGV, "link: keep all sections");
    addFlag("-Wl,-znow", R_LINKARGV, "link: immediate binding (now)");
    addFlag("-Wl,-zlazy", R_LINKARGV, "link: lazy binding");
    addFlag("-Wl,--as-needed", R_LINKARGV, "link: only link needed libs");
    addFlag("-Wl,--no-as-needed", R_LINKARGV, "link: link all needed libs");
    addFlag("-Wl,-rpath,", R_LINKARGV, "link: set runtime path");
    addFlag("-Wl,-zdefs", R_LINKARGV, "link: reject undefined symbols");
    addFlag("-Wl,-znodefaultlibs", R_LINKARGV, "link: no default libs");

    // -mllvm options passed to both opt and llc
    addFlag("-mllvm-passes", R_MLLARGV, "mllvm: run custom pass list");
    addFlag("-mllvm-disable-lsr", R_MLLARGV, "mllvm: disable loop strength reduction");
    addFlag("-mllvm-enable-verify", R_MLLARGV, "mllvm: verify IR after passes");
    addFlag("-mllvm-print-ir", R_MLLARGV, "mllvm: print IR after passes");

    // ---- extended pass-through options -------------------------------------
    // opt (extra passes)
    addFlag("-fconstprop", R_OPTARGV, "opt: constant propagation");
    addFlag("-falways-inline", R_OPTARGV, "opt: inline everything at -O2");
    addFlag("-fadce", R_OPTARGV, "opt: aggressive dead code elimination");
    addFlag("-fgdce", R_OPTARGV, "opt: global dead code elimination");
    addFlag("-fgvn-hoist", R_OPTARGV, "opt: GVN-hoist pass");
    addFlag("-floop-distribute", R_OPTARGV, "opt: loop distribution");
    addFlag("-floop-interchange", R_OPTARGV, "opt: loop interchange");
    addFlag("-fipsccp", R_OPTARGV, "opt: interprocedural SCCP");
    addFlag("-fpartial-inline", R_OPTARGV, "opt: partial inlining");
    addFlag("-fearlycse", R_OPTARGV, "opt: early common subexpression elimination");
    addFlag("-faggressive-instcombine", R_OPTARGV, "opt: aggressive instcombine");
    addFlag("-fvectorize-width=2", R_OPTARGV, "opt: vectorize to width 2");
    // llc (backend tuning)
    addFlag("-mabicalls", R_LLCARGV, "llc: enable ABI calls");
    addFlag("-mnoabicalls", R_LLCARGV, "llc: disable ABI calls");
    addFlag("-mred-zone", R_LLCARGV, "llc: enable red zone");
    addFlag("-mnored-zone", R_LLCARGV, "llc: disable red zone");
    addFlag("-mstackrealign", R_LLCARGV, "llc: force stack realignment");
    addFlag("-mstrict-align", R_LLCARGV, "llc: strict alignment");
    addFlag("-mcjump-table", R_LLCARGV, "llc: emit compact jump tables");
    addFlag("-mlong-calls", R_LLCARGV, "llc: allow long calls");
    addFlag("-mcall-abi", R_LLCARGV, "llc: call ABI (hard/soft)");
    // ld.lld (linker)
    addFlag("-Wl,--strip-all", R_LINKARGV, "link: strip all symbols");
    addFlag("-Wl,--strip-debug", R_LINKARGV, "link: strip debug info");
    addFlag("-Wl,-s", R_LINKARGV, "link: strip symbols");
    addFlag("-Wl,-zrelro", R_LINKARGV, "link: RELRO segments");
    addFlag("-Wl,-znorelro", R_LINKARGV, "link: disable RELRO");
    addFlag("-Wl,--no-undefined", R_LINKARGV, "link: reject undefined symbols");
    addFlag("-Wl,-O2", R_LINKARGV, "link: optimize at link time");
    addFlag("-Wl,--sort-section=name", R_LINKARGV, "link: sort sections by name");
    // -mllvm extras
    addFlag("-mllvm-time-passes", R_MLLARGV, "mllvm: time each pass");
    addFlag("-mllvm-stats", R_MLLARGV, "mllvm: print pass statistics");
    addFlag("-mllvm-debug", R_MLLARGV, "mllvm: enable debug output");
    addFlag("-mllvm-print-ir-opt", R_MLLARGV, "mllvm: print IR after each pass");
}

// ----------------------------------------------------------------------------
// loadFlagFile: append definitions from a user config file. Each non-comment,
// non-blank line has form:  FLAG ROLE[:value] "description"
// Roles are mapped by name into role codes so custom flags can trigger
// real behaviors (see roleName below). Wildcards ('*') are allowed in FLAG.
// ----------------------------------------------------------------------------
fn loadFlagFile(path: str) int {
    var f: ptr = fopen(path, "rb");
    if f == 0 { return 0; }
    // read the whole file into a buffer
    var cap: int = 4096;
    var buf: ptr = (ptr)malloc(cap);
    var n: int = 0;
    while 1 == 1 {
        if n + 1024 > cap {
            while n + 1024 > cap { cap = cap * 2; }
            buf = (ptr)realloc(buf, cap);
        }
        var got: int = fread(buf + n, 1, 1024, f);
        if got <= 0 { break; }
        n = n + got;
    }
    fclose(f);
    if n == 0 { return 1; }

    // Simple line-based tokenizer. Each line yields up to 3 whitespace
    // separated tokens:  PATTERN  ROLE  "DESC" (desc may be quoted).
    var pat: ptr = (ptr)malloc(128);
    var role: ptr = (ptr)malloc(64);
    var desc: ptr = (ptr)malloc(256);
    var i: int = 0;
    var any: int = 0;
    while i < n {
        // skip leading whitespace / newlines
        while i < n && (getbyte(buf + i) == 32 || getbyte(buf + i) == 9 || getbyte(buf + i) == 10 || getbyte(buf + i) == 13) { i = i + 1; }
        if i >= n { break; }
        // comment line -> skip to newline
        if getbyte(buf + i) == 35 {
            while i < n && getbyte(buf + i) != 10 { i = i + 1; }
            continue;
        }
        // token 1: pattern
        var pi: int = 0;
        while i < n && getbyte(buf + i) != 32 && getbyte(buf + i) != 9 && getbyte(buf + i) != 10 && getbyte(buf + i) != 13 {
            setbyte(pat + pi, getbyte(buf + i)); pi = pi + 1; i = i + 1;
        }
        setbyte(pat + pi, 0);
        // token 2: role
        while i < n && (getbyte(buf + i) == 32 || getbyte(buf + i) == 9) { i = i + 1; }
        var ri: int = 0;
        while i < n && getbyte(buf + i) != 32 && getbyte(buf + i) != 9 && getbyte(buf + i) != 10 && getbyte(buf + i) != 13 {
            setbyte(role + ri, getbyte(buf + i)); ri = ri + 1; i = i + 1;
        }
        setbyte(role + ri, 0);
        // token 3: description (optional; may be quoted)
        while i < n && (getbyte(buf + i) == 32 || getbyte(buf + i) == 9) { i = i + 1; }
        var di: int = 0;
        if i < n && getbyte(buf + i) == 34 {
            i = i + 1;
            while i < n && getbyte(buf + i) != 34 { setbyte(desc + di, getbyte(buf + i)); di = di + 1; i = i + 1; }
            if i < n { i = i + 1; }
        } else {
            while i < n && getbyte(buf + i) != 10 && getbyte(buf + i) != 13 {
                setbyte(desc + di, getbyte(buf + i)); di = di + 1; i = i + 1;
            }
        }
        setbyte(desc + di, 0);
        // register if we have a pattern and role. The token buffers are
        // reused across lines, so copy each token into a fresh allocation
        // before storing it in the flag record.
        if pi > 0 {
            var rc: int = roleName(role);
            if rc != R_NONE {
                var npat: ptr = (ptr)malloc(pi + 1);
                memcpy(npat, pat, pi + 1);
                var ndesc: ptr = (ptr)malloc(di + 1);
                memcpy(ndesc, desc, di + 1);
                addFlag((str)npat, rc, (str)ndesc);
                any = any + 1;
            }
        }
        // skip to end of line
        while i < n && getbyte(buf + i) != 10 { i = i + 1; }
    }
    return any;
}

// ----------------------------------------------------------------------------
// optArgFor / llcArgFor / linkArgFor / mllArgFor: translate a friendly Wall
// flag (matched by matchFlag) into the literal LLVM-tool argument appended to
// the corresponding tool's command line. Each returns a literal string.
// ----------------------------------------------------------------------------
fn optArgFor(a: str) str {
    // pass-through that already looks like a flag -> forward as-is
    if strcmp(a, "-mllvm-opt") == 0 { return ""; }
    if strcmp(a, "-fvectorize") == 0 { return "-vectorize-loops"; }
    if strcmp(a, "-fno-vectorize") == 0 { return "-no-vectorize-loops"; }
    if strcmp(a, "-fslp-vectorize") == 0 { return "-vectorize-slp"; }
    if strcmp(a, "-floop-unroll") == 0 { return "-loop-unroll"; }
    if strcmp(a, "-floop-rotate") == 0 { return "-loop-rotate"; }
    if strcmp(a, "-floop-unroll-and-jam") == 0 { return "-loop-unroll-and-jam"; }
    if strcmp(a, "-finline") == 0 { return "-inline"; }
    if strcmp(a, "-fno-inline") == 0 { return "-no-inline"; }
    if strcmp(a, "-fmerge-functions") == 0 { return "-mergefunc"; }
    if strcmp(a, "-fno-merge-functions") == 0 { return "-no-mergefunc"; }
    if strcmp(a, "-fwhole-program") == 0 { return "-whole-program"; }
    if strcmp(a, "-fglobalopt") == 0 { return "-globalopt"; }
    if strcmp(a, "-fgvn") == 0 { return "-gvn"; }
    if strcmp(a, "-fmem2reg") == 0 { return "-mem2reg"; }
    if strcmp(a, "-finstcombine") == 0 { return "-instcombine"; }
    if strcmp(a, "-fsccp") == 0 { return "-sccp"; }
    if strcmp(a, "-fdce") == 0 { return "-dce"; }
    if strcmp(a, "-fsimplifycfg") == 0 { return "-simplifycfg"; }
    if strcmp(a, "-ftailcall") == 0 { return "-tailcallelim"; }
    if strcmp(a, "-fno-tail-call") == 0 { return "-no-tailcallelim"; }
    if strcmp(a, "-fsroa") == 0 { return "-sroa"; }
    if strcmp(a, "-fjump-threading") == 0 { return "-jump-threading"; }
    if strcmp(a, "-flibcall-opt") == 0 { return "-libcall-opt"; }
    if strcmp(a, "-ffunc-attrs") == 0 { return "-function-attrs"; }
    if strcmp(a, "-fopt-licm") == 0 { return "-licm"; }
    if strcmp(a, "-fopt-indvars") == 0 { return "-indvars"; }
    if strcmp(a, "-fopt-gvn") == 0 { return "-gvn"; }
    if strcmp(a, "-fopt-loop-idom") == 0 { return "-loop-idom"; }
    if strcmp(a, "-fopt-reassociate") == 0 { return "-reassociate"; }
    if strcmp(a, "-fopt-strip-dead") == 0 { return "-strip-dead-prototypes"; }
    if strcmp(a, "-fopt-cleanup") == 0 { return "-cleanup-cfg"; }
    if strcmp(a, "-fcoroutines") == 0 { return "-enable-coroutines"; }
    if strcmp(a, "-fno-coroutines") == 0 { return "-disable-coroutines"; }
    if strcmp(a, "-fconstprop") == 0 { return "-constprop"; }
    if strcmp(a, "-falways-inline") == 0 { return "-always-inline"; }
    if strcmp(a, "-fadce") == 0 { return "-adce"; }
    if strcmp(a, "-fgdce") == 0 { return "-globaldce"; }
    if strcmp(a, "-fgvn-hoist") == 0 { return "-gvn-hoist"; }
    if strcmp(a, "-floop-distribute") == 0 { return "-loop-distribute"; }
    if strcmp(a, "-floop-interchange") == 0 { return "-loop-interchange"; }
    if strcmp(a, "-fipsccp") == 0 { return "-ipsccp"; }
    if strcmp(a, "-fpartial-inline") == 0 { return "-partial-inliner"; }
    if strcmp(a, "-fearlycse") == 0 { return "-early-cse"; }
    if strcmp(a, "-faggressive-instcombine") == 0 { return "-aggressive-instcombine"; }
    if strcmp(a, "-fvectorize-width=2") == 0 { return "-vectorize-width=2"; }
    return "";
}

fn llcArgFor(a: str) str {
    if strcmp(a, "-mllvm-llc") == 0 { return ""; }
    if strcmp(a, "-march") == 0 { return "-march=aarch64"; }
    if strcmp(a, "-mtune") == 0 { return "-mtune=generic"; }
    if strcmp(a, "-mcpu") == 0 { return "-mcpu=generic"; }
    if strcmp(a, "-mattr") == 0 { return "-mattr=+crc,+crypto"; }
    if strcmp(a, "-mfloat-abi") == 0 { return "-mfloat-abi=hard"; }
    if strcmp(a, "-mregalloc") == 0 { return "-regalloc=greedy"; }
    if strcmp(a, "-mrelocation-model") == 0 { return "-relocation-model=pic"; }
    if strcmp(a, "-mcode-model") == 0 { return "-code-model=small"; }
    if strcmp(a, "-mtls-model") == 0 { return "-tls-model=general-dynamic"; }
    if strcmp(a, "-fno-plt") == 0 { return "-fno-plt"; }
    if strcmp(a, "-fomit-frame-pointer") == 0 { return "-frame-pointer=all"; }
    if strcmp(a, "-mstack-alignment") == 0 { return "-stack-alignment=16"; }
    if strcmp(a, "-msoft-float") == 0 { return "-msoft-float"; }
    if strcmp(a, "-fno-implicit-float") == 0 { return "-no-implicit-float"; }
    if strcmp(a, "-mabicalls") == 0 { return "-abicalls"; }
    if strcmp(a, "-mnoabicalls") == 0 { return "-no-abicalls"; }
    if strcmp(a, "-mred-zone") == 0 { return "-red-zone"; }
    if strcmp(a, "-mnored-zone") == 0 { return "-no-red-zone"; }
    if strcmp(a, "-mstackrealign") == 0 { return "-stackrealign"; }
    if strcmp(a, "-mstrict-align") == 0 { return "-mno-strict-align"; }
    if strcmp(a, "-mcjump-table") == 0 { return "-jump-table-type=block"; }
    if strcmp(a, "-mlong-calls") == 0 { return "-long-call-opt"; }
    if strcmp(a, "-mcall-abi") == 0 { return "-call-abi=hard"; }
    return "";
}

fn linkArgFor(a: str) str {
    if strcmp(a, "-mllvm-link") == 0 { return ""; }
    if strcmp(a, "-Wl,-zrelax") == 0 { return "-z relax"; }
    if strcmp(a, "-Wl,-znoexecstack") == 0 { return "-z noexecstack"; }
    if strcmp(a, "-Wl,-zexecstack") == 0 { return "-z execstack"; }
    if strcmp(a, "-Wl,-Bsymbolic") == 0 { return "-Bsymbolic"; }
    if strcmp(a, "-Wl,--icf=all") == 0 { return "--icf=all"; }
    if strcmp(a, "-Wl,--no-icf") == 0 { return "--no-icf"; }
    if strcmp(a, "-Wl,--gc-sections") == 0 { return "--gc-sections"; }
    if strcmp(a, "-Wl,--no-gc-sections") == 0 { return "--no-gc-sections"; }
    if strcmp(a, "-Wl,-znow") == 0 { return "-z now"; }
    if strcmp(a, "-Wl,-zlazy") == 0 { return "-z lazy"; }
    if strcmp(a, "-Wl,--as-needed") == 0 { return "--as-needed"; }
    if strcmp(a, "-Wl,--no-as-needed") == 0 { return "--no-as-needed"; }
    if strcmp(a, "-Wl,-rpath,") == 0 { return "-rpath"; }
    if strcmp(a, "-Wl,-zdefs") == 0 { return "-z defs"; }
    if strcmp(a, "-Wl,-znodefaultlibs") == 0 { return "-nodefaultlibs"; }
    if strcmp(a, "-Wl,--strip-all") == 0 { return "--strip-all"; }
    if strcmp(a, "-Wl,--strip-debug") == 0 { return "--strip-debug"; }
    if strcmp(a, "-Wl,-s") == 0 { return "-s"; }
    if strcmp(a, "-Wl,-zrelro") == 0 { return "-z relro"; }
    if strcmp(a, "-Wl,-znorelro") == 0 { return "-z norelro"; }
    if strcmp(a, "-Wl,--no-undefined") == 0 { return "--no-undefined"; }
    if strcmp(a, "-Wl,-O2") == 0 { return "-O2"; }
    if strcmp(a, "-Wl,--sort-section=name") == 0 { return "--sort-section=name"; }
    return "";
}

fn mllArgFor(a: str) str {
    if strcmp(a, "-mllvm-passes") == 0 { return "-passes=default"; }
    if strcmp(a, "-mllvm-disable-lsr") == 0 { return "-disable-lsr"; }
    if strcmp(a, "-mllvm-enable-verify") == 0 { return "-verify"; }
    if strcmp(a, "-mllvm-print-ir") == 0 { return "-print-after-all"; }
    if strcmp(a, "-mllvm-time-passes") == 0 { return "-time-passes"; }
    if strcmp(a, "-mllvm-stats") == 0 { return "-stats"; }
    if strcmp(a, "-mllvm-debug") == 0 { return "-debug"; }
    if strcmp(a, "-mllvm-print-ir-opt") == 0 { return "-print-after-all"; }
    return "";
}

// ----------------------------------------------------------------------------
// roleName: map a textual role from the config file to a role code.
// Returns R_NONE for unknown names.
// ----------------------------------------------------------------------------
fn roleName(r: ptr) int {    if strcmp(r, "help") == 0 { return R_HELP; }
    if strcmp(r, "version") == 0 { return R_VERSION; }
    if strcmp(r, "verbose") == 0 { return R_VERBOSE; }
    if strcmp(r, "optlevel0") == 0 { return R_OPTLVL0; }
    if strcmp(r, "optlevel1") == 0 { return R_OPTLVL1; }
    if strcmp(r, "optlevel2") == 0 { return R_OPTLVL2; }
    if strcmp(r, "optlevel3") == 0 { return R_OPTLVL3; }
    if strcmp(r, "optsize") == 0 { return R_OPTLVLS; }
    if strcmp(r, "optz") == 0 { return R_OPTLVLZ; }
    if strcmp(r, "emitobj") == 0 { return R_OBJ; }
    if strcmp(r, "emitasm") == 0 { return R_ASM; }
    if strcmp(r, "emitir") == 0 { return R_IR; }
    if strcmp(r, "shared") == 0 { return R_SHARED; }
    if strcmp(r, "pic") == 0 { return R_PIC; }
    if strcmp(r, "nopie") == 0 { return R_NO_PIE; }
    if strcmp(r, "pie") == 0 { return R_PIE; }
    if strcmp(r, "nolink") == 0 { return R_NOLINK; }
    if strcmp(r, "nowarn") == 0 { return R_NOWARN; }
    if strcmp(r, "werror") == 0 { return R_WERROR; }
    if strcmp(r, "warnall") == 0 { return R_WARNALL; }
    if strcmp(r, "color") == 0 { return R_COLOR; }
    if strcmp(r, "nocolor") == 0 { return R_NOCOLOR; }
    if strcmp(r, "out:next") == 0 { return R_OUT; }
    if strcmp(r, "san") == 0 { return R_SANITIZE; }
    if strcmp(r, "debug") == 0 { return R_DEBUG; }
    return R_NONE;
}

// ----------------------------------------------------------------------------
// matchFlag: find the first flag definition whose pattern matches the given
// argument. Wildcard support: if the pattern contains '*', we match a prefix
// (everything up to '*') and ignore the rest; otherwise an exact match is
// required. Returns the role code, or R_NONE if no flag matches.
// ----------------------------------------------------------------------------
fn matchFlag(a: str) int {
    var f: ptr = flags;
    while f != 0 {
        var pat: str = (str)f[FL_PAT];
        var plen: int = strlen(pat);
        var hasstar: int = 0;
        var si: int = 0;
        while si < plen { if getbyte(pat + si) == 42 { hasstar = 1; } si = si + 1; }
        if hasstar == 1 {
            // prefix match up to the '*'
            var cmp: int = 0;
            var i: int = 0;
            while i < plen {
                if getbyte(pat + i) == 42 { break; }
                if getbyte(pat + i) != getbyte(a + i) { cmp = 1; break; }
                i = i + 1;
            }
            if cmp == 0 { return f[FL_ROLE]; }
        } else {
            if strcmp(pat, a) == 0 { return f[FL_ROLE]; }
        }
        f = (ptr)f[FL_NEXT];
    }
    return R_NONE;
}
// ----------------------------------------------------------------------------
// countFlags: walk the flag table and return how many options are registered.
// The table is populated by initFlags() (plus any user config file), so this
// runs after initialization to print an accurate total in --help.
// ----------------------------------------------------------------------------
fn countFlags() int {
    var f: ptr = flags;
    var n: int = 0;
    while f != 0 { n = n + 1; f = (ptr)f[FL_NEXT]; }
    return n;
}

// Number of operators / expressions the language frontend understands. This is
// a constant that tracks the compiler grammar (arithmetic, shift, bitwise,
// relational, equality, logical, assignment, unary, postfix and ternary).
let N_EXPRESSIONS = 52;

fn printHelp() void {
    printf("WALL TOOLCHAIN\n");
    printf("options (%lld registered):\n", countFlags());
    printf("  --help -h                  print this help and exit\n");
    printf("  --version                  print version information and exit\n");
    printf("  run <file>                 compile and run\n");
    printf("  build                      build executable (default)\n");
    printf("  obj -c --emit-obj          compile to object(s) only\n");
    printf("  -S                         emit assembly only\n");
    printf("  -emit-llvm                 emit LLVM IR only\n");
    printf("  -o <file>                  write output to <file>\n");
    printf("  -target <triple>           cross-compile to <triple> (e.g. x86_64)\n");
    printf("  --print-targets            list supported codegen targets\n");
    printf("  -O0 -O1 -O2 -O3 -Os -Oz    optimization level (default -O2)\n");
    printf("  -g                         generate debug information\n");
    printf("  -shared -static            build shared library / static link\n");
    printf("  -fPIC -fpic                position-independent code\n");
    printf("  -pie -no-pie               control PIE generation\n");
    printf("  -nostdlib                  do not link crt/libc\n");
    printf("  -l<lib> -L<dir>            link library / add search path\n");
    printf("  -Wl,<flag>                 pass <flag> to the linker\n");
    printf("  -I<dir> -D<name>           include dir / preprocessor define\n");
    printf("  -pthread -fopenmp          enable threading / OpenMP\n");
    printf("  -ffast-math -flto          fast-math / link-time optimization\n");
    printf("  -w -Wall -Werror           warning controls\n");
    printf("  -v --verbose               show commands as they run\n");
    printf("  -fcolor -fno-color         force or disable colored diagnostics\n");
    printf("  -fsanitize=<name>          enable a sanitizer\n");
    printf("  -mllvm <arg>               pass <arg> to the LLVM backend\n");
    printf("  -save-temps                keep intermediate files\n");
    printf("  -fno-omit-frame-pointer    keep frame pointer\n");
    printf("  conf/wall.flags            user-extensible flag definitions\n");
    printf("language: %lld operators/expressions in the frontend grammar\n", N_EXPRESSIONS);
}

fn printVersion() void {
    printf("WALL 0.2.0 multiarch\n");
    var dt: str = "aarch64-linux-android";
    if targetTriple != 0 { dt = (str)targetTriple; }
    printf("  target: %s\n", dt);
    printf("  engine: libwall.so (wall_compile)\n");
    printf("  options: %lld registered\n", countFlags());
    printf("  expressions: %lld operators/expressions\n", N_EXPRESSIONS);
    printf("  use: -target <triple> to cross-compile; --print-targets to list\n");
}

// ----------------------------------------------------------------------------
// printTargets: list the codegen targets the backend can target. Because the
// backend is LLVM IR, every triple registered in the installed llc is
// available; this prints the common ones. Use `llc --version` for the full set.
// ----------------------------------------------------------------------------
fn printTargets() void {
    printf("WALL supported codegen targets (via LLVM IR backend):\n");
    printf("  aarch64    aarch64-linux-android (default)\n");
    printf("  x86_64     x86_64-linux-gnu\n");
    printf("  i386       i386-linux-gnu (x86 32-bit)\n");
    printf("  arm        armv7-linux-gnueabihf (aarch32)\n");
    printf("  riscv64    riscv64-linux-gnu\n");
    printf("  riscv32    riscv32-linux-gnu\n");
    printf("  ppc64le    powerpc64le-linux-gnu\n");
    printf("  ppc64      powerpc64-linux-gnu\n");
    printf("  mips64     mips64el-linux-gnuabi64\n");
    printf("  mips       mipsel-linux-gnu\n");
    printf("  wasm32     wasm32-unknown-unknown\n");
    printf("  sparc      sparcv9-linux-gnu\n");
    printf("Run `llc --version` on this system for the complete list.\n");
}
fn buildOptCmd() void {
    bInit();
    bCat("opt -O"); bCatI(optlevel); bCat(" "); bCat(TMPD); bCat("w.ll");
    if optargs != 0 { bCat(optargs); }
    bCat(" -o "); bCat(TMPD); bCat("w.opt.ll");
}

fn buildLlvmObjCmd() void {
    bInit();
    bCat("llc");
    if targetTriple != 0 { bCat(" -mtriple="); bCat(targetTriple); }
    if pic == 1 { bCat(" -relocation-model=pic"); }
    bCat(" -filetype=obj -O"); bCatI(optlevel);
    if llcargs != 0 { bCat(llcargs); }
    bCat(" -o "); bCat(TMPD); bCat("w.o "); bCat(TMPD); bCat("w.opt.ll");
}

fn buildLlvmAsmCmd() void {
    bInit();
    bCat("llc -filetype=asm -O"); bCatI(optlevel);
    if targetTriple != 0 { bCat(" -mtriple="); bCat(targetTriple); }
    bCat(" -o "); bCat(TMPD); bCat("w.s "); bCat(TMPD); bCat("w.opt.ll");
}

// targetEndian: the endianness flag for ld.lld for the active -target triple.
// Returns "-EL" (little) or "-EB" (big). Defaults to little-endian.
fn targetEndian() str {
    if targetTriple != 0 {
        if startsWith(targetTriple, "powerpc-") == 1 || startsWith(targetTriple, "powerpc64-") == 1
           || startsWith(targetTriple, "mips-") == 1 || startsWith(targetTriple, "mips64-") == 1
           || startsWith(targetTriple, "armeb-") == 1 || startsWith(targetTriple, "aarch64_be-") == 1
           || startsWith(targetTriple, "sparc-") == 1 { return "-EB"; }
    }
    return "-EL";
}

// targetMachine: the ld.lld output format (-m) for the active -target triple.
fn targetMachine() str {
    if targetTriple != 0 {
        if startsWith(targetTriple, "aarch64") == 1 { return "-m aarch64linux"; }
        if startsWith(targetTriple, "x86_64") == 1 { return "-m elf_x86_64"; }
        if startsWith(targetTriple, "i386") == 1 || startsWith(targetTriple, "i686") == 1 { return "-m elf_i386"; }
        if startsWith(targetTriple, "armv7") == 1 || startsWith(targetTriple, "arm-") == 1 || startsWith(targetTriple, "armv") == 1 { return "-m armelf_linux_eabi"; }
        if startsWith(targetTriple, "riscv64") == 1 { return "-m elf64lriscv"; }
        if startsWith(targetTriple, "riscv32") == 1 { return "-m elf32lriscv"; }
    }
    return "-m aarch64linux";
}

fn buildLinkCmd() void {
    bInit();
    if shared == 1 {
        bCat("ld.lld --sysroot="); bCat(SYSROOT); bCat(" "); bCat(targetEndian());
        bCat(" --hash-style=gnu -shared -o ");
        bCat(output); bCat(" "); bCat(TMPD); bCat("w.o -L"); bCat(SYSROOT); bCat("/lib -L/system/lib64");
    } else {
        bCat("ld.lld --sysroot="); bCat(SYSROOT);
        bCat(" "); bCat(targetEndian()); bCat(" --fix-cortex-a53-843419 -z now -z relro -z max-page-size=16384");
        bCat(" --no-rosegment --hash-style=gnu --eh-frame-hdr "); bCat(targetMachine());
        if pie == 1 { bCat(" -pie -dynamic-linker "); bCat(DYNLINK); }
        bCat(" -o "); bCat(output); bCat(" "); bCat(TMPD); bCat("w.o ");
        if linkargs != 0 { bCat(linkargs); bCat(" "); }
        bCat(SYSROOT); bCat("/lib/crtbegin_dynamic.o -L"); bCat(SYSROOT); bCat("/lib -L/system/lib64");
        bCat(" -l:libunwind.a -ldl -lc "); bCat(SYSROOT); bCat("/lib/crtend_android.o");
    }
}

fn compileAndLink() int {
    var irl: ptr = (ptr)malloc(4096);
    bInit(); bCat(TMPD); bCat("w.ll");
    memcpy(irl, bbuf, blen + 1);
    einfo("compiling to LLVM IR");
    var rc: int = wall_compile(src, irl);
    if rc != 0 { eerr("compilation failed"); return 1; }
    eok("IR emitted");

    if emit_ir == 1 {
        bInit(); bCat("cp "); bCat(TMPD); bCat("w.ll "); bCat(output);
        run();
        eok("IR saved to output");
        return 0;
    }

    buildOptCmd();
    einfo("optimizing IR");
    if run() != 0 { eerr("opt failed"); return 1; }
    eok("optimization complete");

    if emit_asm == 1 {
        buildLlvmAsmCmd();
        einfo("emitting assembly");
        if run() != 0 { eerr("llc(asm) failed"); return 1; }
        eok("assembly emitted");
        if output != 0 {
            bInit(); bCat("cp "); bCat(TMPD); bCat("w.s "); bCat(output);
            run();
            eok("assembly saved to output");
        }
        return 0;
    }

    buildLlvmObjCmd();
    einfo("generating object code");
    if run() != 0 { eerr("llc failed"); return 1; }
    eok("object emitted");

    if emit_obj == 1 || do_link == 0 {
        bInit(); bCat("cp "); bCat(TMPD); bCat("w.o "); bCat(output);
        run();
        eok("object saved to output");
        return 0;
    }

    buildLinkCmd();
    einfo("linking final binary");
    if run() != 0 { eerr("linking failed"); return 1; }
    eok("link complete");
    return 0;
}
// ============================================================================
// WALL DRIVER MODULE: preproc.wa  -- import preprocessor
// ----------------------------------------------------------------------------
// The compiler engine itself compiles a single translation unit. To support
// multi-file projects, the driver preprocesses the primary source before
// compiling it: any line of the form
//
//     import "path/to/file.wa";
//
// is replaced by the verbatim contents of the referenced file. This gives Wall
// a lightweight module system without complicating the compiler core.
//
// Resolution order for an import path:
//   1. As given (absolute, or relative to the current working directory).
//   2. Relative to the directory of the importing source file.
// ============================================================================

// ----------------------------------------------------------------------------
// preprocess: read `src` (a global set by the driver) and write the fully
// inlined result to `merged`. Returns 0 on success, non-zero on failure.
// ----------------------------------------------------------------------------
fn preprocess(merged: str) int {
    var f: ptr = fopen(src, "rb");
    if f == 0 { eerr("cannot open source"); return 1; }
    var out: ptr = fopen(merged, "w");
    if out == 0 { eerr("cannot write merged"); return 1; }

    var line: ptr = (ptr)malloc(4096);
    var llen: int = 0;
    var eof: int = 0;
    while eof == 0 {
        // read one physical line
        llen = 0;
        var done: int = 0;
        while done == 0 {
            var got: int = fread(line + llen, 1, 1, f);
            if got != 1 { eof = 1; break; }
            if getbyte(line + llen) == 10 { done = 1; }
            llen = llen + 1;
        }
        if llen == 0 { break; }
        setbyte(line + llen, 0);

        // detect `import "X";` (starts with the ASCII bytes i,m,p,o,r,t,space)
        if llen > 7 && getbyte(line) == 105 && getbyte(line + 1) == 109
            && getbyte(line + 2) == 112 && getbyte(line + 3) == 111
            && getbyte(line + 4) == 114 && getbyte(line + 5) == 116
            && getbyte(line + 6) == 32 {
            // extract the quoted path
            var j: int = 7;
            while j < llen && getbyte(line + j) != 34 { j = j + 1; }
            j = j + 1;
            var imp: ptr = (ptr)malloc(1024);
            var k: int = 0;
            while j < llen && getbyte(line + j) != 34 { setbyte(imp + k, getbyte(line + j)); j = j + 1; k = k + 1; }
            setbyte(imp + k, 0);

            // resolve: first try as-is, then relative to the source's dir
            var ifp: ptr = (ptr)malloc(2048);
            bInit(); bCat(imp); memcpy(ifp, bbuf, blen + 1);
            if d_fileExists(imp) == 0 {
                var si: int = strlen(src) - 1;
                while si >= 0 && getbyte(src + si) != 47 { si = si - 1; }
                bInit();
                if si >= 0 { bCatN(src, si + 1); }
                bCat(imp);
                memcpy(ifp, bbuf, blen + 1);
            }

            // inline the imported file verbatim.
            // First try the filesystem; if absent, serve it from the stdlib
            // embedded inside libwall.so (base64-decoded at runtime).
            var embedded: ptr = 0;
            var impf: ptr = fopen(ifp, "rb");
            if impf == 0 {
                libbasename(imp);
                embedded = liblookup(bbuf);
                if embedded != 0 {
                    bInit(); bCat("using embedded stdlib module \""); bCat(imp); bCat("\"");
                    enote(bbuf);
                    var es: ptr = embedded;
                    while getbyte(es) != 0 {
                        fwrite(es, 1, 1, out);
                        es = es + 1;
                    }
                } else {
                    eerr("cannot open import");
                    return 1;
                }
            }
            if impf != 0 {
                var rbuf: ptr = (ptr)malloc(4096);
                while 1 == 1 {
                    var n: int = fread(rbuf, 1, 4096, impf);
                    if n <= 0 { break; }
                    fwrite(rbuf, 1, n, out);
                }
                fclose(impf);
            }
            fwrite("\n", 1, 1, out);
        } else {
            // ordinary line: copy through verbatim
            fwrite(line, 1, llen, out);
            fwrite("\n", 1, 1, out);
        }
    }
    fclose(f);
    fclose(out);
    return 0;
}

// ----------------------------------------------------------------------------
// arg_at: index into a char** argv array and return argv[i] as a `str`.
// ----------------------------------------------------------------------------
fn arg_at(argv: ptr, i: int) str {
    var p: ptr = (ptr)argv[i * 8];
    return (str)p;
}
// ============================================================================
// WALL DRIVER MODULE: libembed.wa  -- embedded standard library
// ----------------------------------------------------------------------------
// To make libwall.so fully self-contained, the contents of the standard
// library modules (lib/*.wa) are base64-encoded and compiled into the shared
// object as string constants. At preprocess time, when the driver encounters
// an `import "lib/xxx.wa"` whose file is not present on disk, it decodes the
// matching embedded module instead. This keeps the toolchain functional even
// when no lib/ directory is shipped alongside libwall.so.
//
// libnames / libdata / libcnt are filled in by an auto-generated block
// (libdata.wa) that is concatenated into the same translation unit.
// ============================================================================

// ---------------- generated stdlib metadata (set by libdata.wa) ---------------
var libcnt: int = 0;        // number of embedded modules
var libnames: ptr = 0;      // array of NUL-terminated module names
var libdata: ptr = 0;       // array of NUL-terminated base64 payloads

// ---------------- base64 decoder ----------------------------------------------
// b64decode: decode a NUL-terminated base64 string into freshly-allocated
// NUL-terminated bytes. Returns 0 on error. The base64 alphabet is the
// standard A-Za-z0-9+/ set with '=' padding.
fn b64val(c: int) int {
    if c >= 65 && c <= 90 { return c - 65; }        // A-Z
    if c >= 97 && c <= 122 { return c - 97 + 26; }  // a-z
    if c >= 48 && c <= 57 { return c - 48 + 52; }   // 0-9
    if c == 43 { return 62; }                       // +
    if c == 47 { return 63; }                       // /
    return -1;
}

fn b64decode(b64: ptr) ptr {
    var inlen: int = 0;
    while getbyte(b64 + inlen) != 0 { inlen = inlen + 1; }
    var outlen: int = (inlen / 4) * 3;
    var out: ptr = (ptr)malloc(outlen + 1);
    var o: int = 0;
    var i: int = 0;
    while i + 4 <= inlen {
        var b0: int = b64val(getbyte(b64 + i));
        var b1: int = b64val(getbyte(b64 + i + 1));
        var b2: int = b64val(getbyte(b64 + i + 2));
        var b3: int = b64val(getbyte(b64 + i + 3));
        var c1: int = (b0 * 4) + (b1 / 16);
        setbyte(out + o, c1); o = o + 1;
        if getbyte(b64 + i + 2) != 61 {
            var c2: int = ((b1 - ((b1 / 16) * 16)) * 16) + (b2 / 4);
            setbyte(out + o, c2); o = o + 1;
        }
        if getbyte(b64 + i + 3) != 61 {
            var c3: int = ((b2 - ((b2 / 4) * 4)) * 64) + b3;
            setbyte(out + o, c3); o = o + 1;
        }
        i = i + 4;
    }
    setbyte(out + o, 0);
    return out;
}

// ---------------- lookup -------------------------------------------------------
// liblookup: return the decoded source text of an embedded module whose name
// matches the given string, or 0 if not embedded.
fn liblookup(name: ptr) ptr {
    var i: int = 0;
    while i < libcnt {
        var nm: ptr = (ptr)libnames[i * 8];
        if strcmp(nm, name) == 0 {
            return b64decode((ptr)libdata[i * 8]);
        }
        i = i + 1;
    }
    return 0;
}

// libbasename: extract the basename of a path string into the string builder.
fn libbasename(p: ptr) void {
    var len: int = strlen(p);
    var st: int = 0;
    var i: int = 0;
    while i < len { if getbyte(p + i) == 47 { st = i + 1; } i = i + 1; }
    bInit();
    while st < len { bCatC(getbyte(p + st)); st = st + 1; }
}
// AUTO-GENERATED by build.sh from the src/rt standard library modules
fn libfill() void {
  libnames = (ptr)malloc(48);
  libdata = (ptr)malloc(48);
  libcnt = 0;
  libnames[0] = (int)"array.wa";
  libdata[0] = (int)"";
  libnames[8] = (int)"convert.wa";
  libdata[8] = (int)"";
  libnames[16] = (int)"io.wa";
  libdata[16] = (int)"";
  libnames[24] = (int)"list.wa";
  libdata[24] = (int)"";
  libnames[32] = (int)"math.wa";
  libdata[32] = (int)"";
  libnames[40] = (int)"string.wa";
  libdata[40] = (int)"";
  libcnt = 6;
}
// ============================================================================
// WALL DRIVER MODULE: main.wa  -- driver entry point & option dispatch
// ----------------------------------------------------------------------------
// This is the top-level driver module. It:
//   1. Walks argv, matching each argument against the flag table, and applies
//      the corresponding role to the option-state globals.
//   2. Runs the compile pipeline and, in run mode, executes the result.
//
// All shared declarations/state come from contract.wa (the first module in the
// concatenated translation unit). When compiled into libwall.so, the exported
// entry point is:
//   int wall_driver(int argc, char** argv)
// which is invoked by the tiny `wall` launcher binary.
// ============================================================================

// ============================================================================
// driver entry -- exported from libwall.so as `wall_driver`.
// ============================================================================
fn wall_driver(argc: int, argv: ptr) int {
    initPaths();
    libfill();
    initFlags();
    if argc < 2 { printHelp(); return 1; }

    // load the user-extensible flag config (conf/wall.flags) if present.
    // Search order: install dir, then current working directory.
    bInit(); bCat(SYSROOT); bCat("/conf/wall.flags");
    var cfg: str = (str)malloc(blen + 1);
    memcpy(cfg, bbuf, blen + 1);
    if d_fileExists(cfg) != 1 {
        bInit(); bCat("conf/wall.flags");
        cfg = (str)malloc(blen + 1);
        memcpy(cfg, bbuf, blen + 1);
    }
    if d_fileExists(cfg) == 1 { loadFlagFile(cfg); }

    var i: int = 1;
    output = 0;
    src = 0;
    mode = 0;

    while i < argc {
        var a: str = arg_at(argv, i);
        var role: int = matchFlag(a);
        if role == R_HELP { printHelp(); return 0; }
        elif role == R_VERSION { printVersion(); return 0; }
        elif role == R_PRINTTAR { printTargets(); return 0; }
        elif role == R_TARGET {
            if i + 1 < argc { targetTriple = arg_at(argv, i + 1); i = i + 1; }
        }
        elif role == R_VERBOSE || role == R_VERBOSEX { verbose = 1; }
        elif role == R_OPTLVL0 { optlevel = 0; }
        elif role == R_OPTLVL1 { optlevel = 1; }
        elif role == R_OPTLVL2 { optlevel = 2; }
        elif role == R_OPTLVL3 { optlevel = 3; }
        elif role == R_OPTLVLS || role == R_OPTLVLZ { optlevel = 2; }
        elif role == R_OBJ { mode = 2; emit_obj = 1; }
        elif role == R_ASM { emit_asm = 1; }
        elif role == R_IR { emit_ir = 1; }
        elif role == R_SAVETMP { save_temps = 1; }
        elif role == R_SHARED { shared = 1; pie = 0; }
        elif role == R_PIC { pic = 1; }
        elif role == R_NO_PIE { pie = 0; }
        elif role == R_PIE { pie = 1; }
        elif role == R_NOLINK { do_link = 0; emit_obj = 1; }
        elif role == R_NOWARN { nowarn = 1; }
        elif role == R_WERROR { werror = 1; }
        elif role == R_WARNALL { }
        elif role == R_COLOR { color = 1; }
        elif role == R_NOCOLOR { color = 0; }
        elif role == R_DEBUG { debug = 1; }
        elif role == R_FASTMATH { }
        elif role == R_LTO { }
        elif role == R_PTHREAD { }
        elif role == R_OPENMP { }
        elif role == R_STATIC { pie = 0; }
        elif role == R_RUN { mode = 1; }
        elif role == R_BUILD { mode = 0; }
        elif role == R_OUT {
            if i + 1 < argc { output = arg_at(argv, i + 1); i = i + 1; }
        }
        elif role == R_LINKLIB || role == R_LIBDIR || role == R_INCLUDE
             || role == R_DEFINE || role == R_LINKFLAG {
            // accepted (recorded for linking in future phases); no-op for now
        }
        elif role == R_SANITIZE {
            // accepted; sanitizer wiring reserved
        }
        elif role == R_OPTARG {
            if i + 1 < argc { i = i + 1; } // skip the value
        }
        elif role == R_OPTARGV {
            // map a friendly flag to the literal arg we append to `opt`
            appendOptArg(optArgFor(a));
        }
        elif role == R_LLCARGV {
            appendLlcArg(llcArgFor(a));
        }
        elif role == R_LINKARGV {
            appendLinkArg(linkArgFor(a));
        }
        elif role == R_MLLARGV {
            appendMllArg(mllArgFor(a));
        }
        elif role != R_NONE { }
        elif getbyte(a) == 45 {
            // report the unknown option (quoted) but keep compiling
            bInit(); bCat("unknown option: \""); bCat(a); bCat("\"");
            ewarn(bbuf);
        }
        else { src = a; }
        i = i + 1;
    }

    if src == 0 { eerr("no input files (try --help)"); return 1; }

    // default output name = basename of src minus .wa
    if output == 0 {
        bInit();
        var s: ptr = src;
        var sl: int = strlen(s);
        var st: int = 0;
        var bi: int = 0;
        while bi < sl { if getbyte(s + bi) == 47 { st = bi + 1; } bi = bi + 1; }
        var end: int = sl;
        while end > st {
            var oc: int = end - 1;
            if getbyte(s + oc) == 46 { break; }
            end = end - 1;
        }
        var olen: int = end - st;
        var doti: int = end - 1;
        if olen > 0 && getbyte(s + doti) == 46 { olen = olen - 1; }
        bCatN(s + st, olen);
        output = (ptr)malloc(blen + 1);
        memcpy(output, bbuf, blen + 1);
    }

    // preprocess (resolve imports) from the original source
    var premerged: ptr = (ptr)malloc(4096);
    bInit(); bCat(TMPD); bCat("merged.wa");
    memcpy(premerged, bbuf, blen + 1);
    if preprocess(premerged) != 0 { return 1; }
    src = premerged;

    // run pipeline
    var rc: int = compileAndLink();
    if rc == 0 && mode == 1 {
        bInit(); bCat("./"); bCat(output);
        run();
    }
    return rc;
}
